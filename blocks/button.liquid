{%- liquid
    assign button_class = 'btn-primary'
    if block.settings.style == 'secondary'
        assign button_class = 'btn-secondary'
    endif
-%}

{%- if block.settings.label != blank and block.settings.link != blank -%}
    <div class="theme-block-button" {{ block.shopify_attributes }}>
        <a class="{{ button_class }}" href="{{ block.settings.link }}">
            {{- block.settings.label | escape -}}
        </a>
    </div>
{%- elsif request.design_mode -%}
    <div class="theme-block-button theme-block-button--placeholder" {{ block.shopify_attributes }}>
        {{ 'blocks.button.placeholders.empty' | t }}
    </div>
{%- endif -%}

{% stylesheet %}
    .theme-block-button--placeholder {
        display: inline-flex;
        min-height: 2.75rem;
        align-items: center;
        padding: 0.5rem 1rem;
        border: 1px dashed rgba(var(--color-border), 0.45);
        color: rgba(var(--color-foreground), 0.55);
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:blocks.button.name",
    "tag": null,
    "settings": [
        {
            "type": "text",
            "id": "label",
            "label": "t:blocks.button.settings.label",
            "default": "t:blocks.button.defaults.label"
        },
        {
            "type": "url",
            "id": "link",
            "label": "t:blocks.button.settings.link",
            "default": "/collections/all"
        },
        {
            "type": "select",
            "id": "style",
            "label": "t:blocks.button.settings.style",
            "options": [
                {
                    "value": "primary",
                    "label": "t:blocks.button.options.primary"
                },
                {
                    "value": "secondary",
                    "label": "t:blocks.button.options.secondary"
                }
            ],
            "default": "primary"
        }
    ],
    "presets": [
        {
            "name": "t:blocks.button.presets.button"
        }
    ]
}
{% endschema %}
