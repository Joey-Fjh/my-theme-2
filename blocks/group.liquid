                {
                    "value": "column",
                    "label": "t:blocks.group.options.column"
                },
                {
                    "value": "row",
                    "label": "t:blocks.group.options.row"
                },
                {
                    "value": "row-stack",
                    "label": "t:blocks.group.options.row_stack"
                }
            ],
            "default": "column",
            "visible_if": "{{ block.settings.layout == 'flex' }}"
        },
        {
            "type": "select",
            "id": "distribution",
            "label": "t:blocks.group.settings.distribution",
            "options": [
                {
                    "value": "flex-start",
                    "label": "t:blocks.group.options.start"
                },
                {
                    "value": "center",
                    "label": "t:blocks.group.options.center"
                },
                {
                    "value": "flex-end",
                    "label": "t:blocks.group.options.end"
                },
                {
                    "value": "space-between",
                    "label": "t:blocks.group.options.space_between"
                },
                {
                    "value": "space-around",
                    "label": "t:blocks.group.options.space_around"
                },
                {
                    "value": "space-evenly",
                    "label": "t:blocks.group.options.space_evenly"
                }
            ],
            "default": "flex-start",
            "visible_if": "{{ block.settings.layout == 'flex' }}"
        },
        {
            "type": "select",
            "id": "alignment",
            "label": "t:blocks.group.settings.alignment",
            "options": [
                {
                    "value": "flex-start",
                    "label": "t:blocks.group.options.start"
                },
                {
                    "value": "center",
                    "label": "t:blocks.group.options.center"
                },
                {
                    "value": "flex-end",
                    "label": "t:blocks.group.options.end"
                },
                {
                    "value": "stretch",
                    "label": "t:blocks.group.options.stretch"
                },
                {
                    "value": "baseline",
                    "label": "t:blocks.group.options.baseline"
                }
            ],
            "default": "stretch"
        },
        {
            "type": "select",
            "id": "columns",
            "label": "t:blocks.group.settings.columns",
            "options": [
                {
                    "value": "auto",
                    "label": "t:blocks.group.options.auto"
                },
                {
                    "value": "1",
                    "label": "t:blocks.group.options.columns_1"
                },
                {
                    "value": "2",
                    "label": "t:blocks.group.options.columns_2"
                },
                {
                    "value": "3",
                    "label": "t:blocks.group.options.columns_3"
                },
                {
                    "value": "4",
                    "label": "t:blocks.group.options.columns_4"
                },
                {
                    "value": "5",
                    "label": "t:blocks.group.options.columns_5"
                },
                {
                    "value": "6",
                    "label": "t:blocks.group.options.columns_6"
                }
            ],
            "default": "auto",
            "visible_if": "{{ block.settings.layout == 'grid' }}"
        },
        {
            "type": "select",
            "id": "gap",
            "label": "t:blocks.group.settings.gap",
            "options": [
                {
                    "value": "none",
                    "label": "t:blocks.group.options.none"
                },
                {
                    "value": "tight",
                    "label": "t:blocks.group.options.tight"
                },
                {
                    "value": "related",
                    "label": "t:blocks.group.options.related"
                },
                {
                    "value": "group",
                    "label": "t:blocks.group.options.group"
                },
                {
                    "value": "section",
                    "label": "t:blocks.group.options.section"
                }
            ],
            "default": "related"
        },
        {
            "type": "select",
            "id": "width",
            "label": "t:blocks.group.settings.width",
            "options": [
                {
                    "value": "fill",
