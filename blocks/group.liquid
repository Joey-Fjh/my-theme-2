{% liquid
    assign container_direction = 'column'
    assign container_stack = 'off'
    assign container_width = block.settings.width
    if block.settings.layout == 'grid'
        assign container_width = block.settings.width_grid
    else
        if block.settings.direction == 'row' or block.settings.direction == 'row-stack'
            assign container_direction = 'row'
        endif
        if block.settings.direction == 'row-stack'
            assign container_stack = 'on'
        endif
    endif
%}
{% capture container_children %}
    {% content_for 'blocks' %}
{% endcapture %}
{% render 'container',
    block: block,
    layout: block.settings.layout,
    direction: container_direction,
    distribution: block.settings.distribution,
    alignment: block.settings.alignment,
    columns: block.settings.columns,
    gap: block.settings.gap,
    width: container_width,
    height: block.settings.height,
    stack: container_stack,
    children: container_children
%}

{% schema %}
{
    "name": "t:blocks.group.name",
    "tag": null,
    "blocks": [
        {
            "type": "@theme"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "type": "select",
            "id": "layout",
            "label": "t:blocks.group.settings.layout",
            "options": [
                {
                    "value": "flex",
                    "label": "t:blocks.group.options.flex"
                },
                {
                    "value": "grid",
                    "label": "t:blocks.group.options.grid"
                }
            ],
            "default": "flex"
        },
        {
            "type": "select",
            "id": "direction",
            "label": "t:blocks.group.settings.direction",
