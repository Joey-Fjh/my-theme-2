                },
                {
                    "value": "content",
                    "label": "t:blocks.group.options.content"
                },
                {
                    "value": "measure",
                    "label": "t:blocks.group.options.measure"
                }
            ],
            "default": "fill",
            "visible_if": "{{ block.settings.layout == 'flex' }}"
        },
        {
            "type": "select",
            "id": "width_grid",
            "label": "t:blocks.group.settings.width_grid",
            "options": [
                {
                    "value": "fill",
                    "label": "t:blocks.group.options.fill"
                },
                {
                    "value": "measure",
                    "label": "t:blocks.group.options.measure"
                }
            ],
            "default": "fill",
            "visible_if": "{{ block.settings.layout == 'grid' }}"
        },
        {
            "type": "select",
            "id": "height",
            "label": "t:blocks.group.settings.height",
            "options": [
                {
                    "value": "content",
                    "label": "t:blocks.group.options.content"
                },
                {
                    "value": "fill",
                    "label": "t:blocks.group.options.fill"
                }
            ],
            "default": "content"
        }
    ],
    "presets": [
        {
            "name": "t:blocks.group.presets.group"
        }
    ]
}
