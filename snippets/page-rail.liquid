{% doc %}
    Renders the decorative static architectural ruler rail along the inline-start
    canvas edge on the homepage, running from Header top edge to Footer bottom
    edge at a fixed vertical tick and numeral pitch. Width and outer positioning
    are owned by L0 frame rules in `assets/base.css`. CSS repeats the ticks;
    `assets/page-rail.js` measures the first numeral and shows the labels that fit.
{% enddoc %}

<aside
    class="page-rail"
    aria-hidden="true"
    x-data="pageRail"
    data-module-id="page-rail"
>
    <div class="page-rail__track">
        <span class="page-rail__mark">
            <span class="page-rail__num"
                >0<span class="page-rail__unit">
                    {{ 'general.ruler.unit_mm' | t -}}
                </span></span
            >
        </span>
    </div>
</aside>

{% stylesheet %}
    .page-rail__track {
        --rail-origin: 1.8rem;
        --rail-step: 3rem;
        --rail-major-step: var(--rail-step);
        --rail-major-w: 1.4rem;
        --rail-mid-w: 0.9rem;
        --rail-minor-w: 0.5rem;
        --rail-num-pad: 1.8rem;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        min-height: 100%;
        padding-block-start: var(--rail-origin);
        font-family: var(--font-mono-family);
        color: var(--color-subtle);
    }

    .page-rail__track::before {
        content: '';
        position: absolute;
        inset-block: var(--rail-origin) 0;
        inset-inline-start: 0;
        width: var(--rail-major-w);
        background-image:
            repeating-linear-gradient(
                to bottom,
                var(--color-line-strong) 0 1px,
                transparent 1px var(--rail-major-step)
            ),
            repeating-linear-gradient(
                to bottom,
                var(--color-line) 0 1px,
                transparent 1px calc(var(--rail-step) * 0.5)
            ),
            repeating-linear-gradient(
                to bottom,
                var(--color-line) 0 1px,
                transparent 1px calc(var(--rail-step) * 0.1)
            );
        background-size:
            var(--rail-major-w) 100%,
            var(--rail-mid-w) 100%,
            var(--rail-minor-w) 100%;
        background-repeat: no-repeat;
    }

    .page-rail__mark {
        position: relative;
        flex: 0 0 auto;
        width: 100%;
        height: var(--rail-step);
        padding-inline-start: var(--rail-num-pad);
        font-size: calc(var(--type-step--2) * var(--font-body-scale));
        font-weight: var(--font-body-weight);
        line-height: var(--font-heading-line-height);
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    .page-rail__num {
        display: inline-block;
        transform: translateY(-50%);
    }

    .page-rail__track:not([data-rail-labels-ready]) .page-rail__num {
        visibility: hidden;
    }

    .page-rail__track[data-rail-hide-unit] .page-rail__unit {
        display: none;
    }

    .page-rail__num[data-rail-overflow] {
        visibility: hidden;
    }

    @container page-rail (max-width: 4.99rem) {
        .page-rail__track {
            --rail-major-step: calc(var(--rail-step) * 2);
            --rail-major-w: 1.1rem;
            --rail-mid-w: 0.7rem;
            --rail-minor-w: 0.45rem;
            --rail-num-pad: 1.4rem;
        }

        .page-rail__mark {
            letter-spacing: var(--font-body-letter-spacing);
        }

        .page-rail__mark:nth-child(even) .page-rail__num {
            display: none;
        }
    }

    @container page-rail (max-width: 3.79rem) {
        .page-rail__track {
            --rail-major-step: calc(var(--rail-step) * 4);
            --rail-major-w: 0.9rem;
            --rail-mid-w: 0.6rem;
            --rail-minor-w: 0.4rem;
            --rail-num-pad: 1.1rem;
        }

        .page-rail__mark:not(:nth-child(4n + 1)) .page-rail__num {
            display: none;
        }

        .page-rail__unit {
            display: none;
        }
    }

    @container page-rail (max-width: 2.79rem) {
        .page-rail__track {
            --rail-major-step: var(--rail-step);
            --rail-major-w: 0.8rem;
            --rail-mid-w: 0.5rem;
            --rail-minor-w: 0.35rem;
        }

        .page-rail__num {
            display: none;
        }
    }

    @container page-rail (max-width: 0.99rem) {
        .page-rail__track {
            visibility: hidden;
        }
    }
{% endstylesheet %}
