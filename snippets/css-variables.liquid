{% style %}
    {% liquid
        assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
        assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
        assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'

        assign heading_font_bold = settings.type_header_font | font_modify: 'weight', 'bold'
        assign heading_font_italic = settings.type_header_font | font_modify: 'style', 'italic'
        assign heading_font_bold_italic = heading_font_bold | font_modify: 'style', 'italic'
    %}

    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {%- if body_font_bold -%}
        {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if body_font_italic -%}
        {{ body_font_italic | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if body_font_bold_italic -%}
        {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {%- endif -%}

    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    {%- if heading_font_bold -%}
        {{ heading_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if heading_font_italic -%}
        {{ heading_font_italic | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if heading_font_bold_italic -%}
        {{ heading_font_bold_italic | font_face: font_display: 'swap' }}
    {%- endif -%}

    {% comment %} color schemes (last result: :root, .color-scheme-1{} .color-scheme-2{} ...) {% endcomment %}
    {% assign scheme_classes = '' %}
    {% for scheme in settings.color_schemes %}
        {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
        {% if forloop.index == 1 %}
            :root,
        {% endif %}
        .color-{{ scheme.id }} {
            --color-background: {{ scheme.settings.background_color.red }}, {{ scheme.settings.background_color.green }}, {{ scheme.settings.background_color.blue }};
            {% if scheme.settings.background_gradient_color != empty %}
                --gradient-background: {{ scheme.settings.background_gradient_color }};
            {% else %}
                --gradient-background: {{ scheme.settings.background_color }};
            {% endif %}

            --color-foreground: {{ scheme.settings.text_color.red }}, {{ scheme.settings.text_color.green }}, {{ scheme.settings.text_color.blue }};

            --color-border: {{ scheme.settings.border_color.red }}, {{ scheme.settings.border_color.green }}, {{ scheme.settings.border_color.blue }};

            --color-success-background: {{ scheme.settings.success_background_color.red }}, {{ scheme.settings.success_background_color.green }}, {{ scheme.settings.success_background_color.blue }};
            --color-success-foreground: {{ scheme.settings.success_foreground_color.red }}, {{ scheme.settings.success_foreground_color.green }}, {{ scheme.settings.success_foreground_color.blue }};
            --color-error-background: {{ scheme.settings.error_background_color.red }}, {{ scheme.settings.error_background_color.green }}, {{ scheme.settings.error_background_color.blue }};
            --color-error-foreground: {{ scheme.settings.error_foreground_color.red }}, {{ scheme.settings.error_foreground_color.green }}, {{ scheme.settings.error_foreground_color.blue }};
        }
    {% endfor %}

    {% comment %} last result: body, .color-sheme-1{}, .color-sheme-2{} ... {% endcomment %}
    {{ scheme_classes | prepend: 'body' }} {
        color: rgb(var(--color-foreground));
        background-color: rgb(var(--color-background));
    }

    :root {
        {%- comment -%} global Variables {%- endcomment -%}
        --header-height: 0px;

        {% comment %} layout Variables {% endcomment %}
        --page-width: {{ settings.page_width | divided_by: 10}}rem;
        --page-margin: {{ settings.page_margin | divided_by: 10 }}rem;

        {% comment %} font Variables {% endcomment %}
        --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-style: {{ settings.type_body_font.style }};
        {%- liquid
            assign theme_body_font_size = settings.body_font_size | default: 16
            assign theme_body_font_size_mobile = settings.body_font_size_mobile | default: 16
        -%}
        --font-body-size: {{ theme_body_font_size }}px;
        --font-body-size-mobile: {{ theme_body_font_size_mobile }}px;
        --font-body-line-height: {{ settings.body_line_height }};
        --font-body-letter-spacing: {{ settings.body_letter_spacing }};
        --font-body-text-transform: {{ settings.body_text_transform }};

        --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --font-heading-style: {{ settings.type_header_font.style }};
        --font-heading-weight: {{ settings.heading_weight }};
        --font-heading-line-height: {{ settings.heading_line_height }};
        --font-heading-letter-spacing: {{ settings.heading_letter_spacing }};
        --font-heading-text-transform: {{ settings.heading_text_transform }};
        --font-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};

        {% comment %} Motion Variables {% endcomment %}
        --motion-duration: 500ms;
        --motion-duration-fast: 250ms;
        --motion-duration-base: 400ms;
        --motion-duration-slow: 500ms;

        --motion-ease: cubic-bezier(0.22, 1, 0.36, 1);
        --motion-ease-default: var(--motion-ease);
        --motion-ease-enter: cubic-bezier(0.22, 1, 0.36, 1);
        --motion-ease-exit: cubic-bezier(0.55, 0, 1, 0.45);
    }
{% endstyle %}
