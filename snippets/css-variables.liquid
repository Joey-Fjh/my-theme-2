{% style %}
    {% liquid
        assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
        assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
        assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'

        assign heading_font_selected = settings.type_header_font | font_modify: 'weight', settings.heading_weight
        assign heading_font_bold = settings.type_header_font | font_modify: 'weight', 'bold'
        assign heading_font_italic = settings.type_header_font | font_modify: 'style', 'italic'
        assign heading_font_bold_italic = heading_font_bold | font_modify: 'style', 'italic'
    %}

    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {%- if body_font_bold -%}
        {{ body_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if body_font_italic -%}
        {{ body_font_italic | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if body_font_bold_italic -%}
        {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {%- endif -%}

    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    {%- if heading_font_selected -%}
        {{ heading_font_selected | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if heading_font_bold -%}
        {{ heading_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if heading_font_italic -%}
        {{ heading_font_italic | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if heading_font_bold_italic -%}
        {{ heading_font_bold_italic | font_face: font_display: 'swap' }}
    {%- endif -%}

    {% comment %} color schemes (last result: :root, .color-scheme-1{} .color-scheme-2{} ...) {% endcomment %}
    {% assign scheme_classes = '' %}
    {% for scheme in settings.color_schemes %}
        {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
        {% if forloop.index == 1 %}
            :root,
        {% endif %}
        .color-{{ scheme.id }} {
            --color-background: {{ scheme.settings.background_color.red }}, {{ scheme.settings.background_color.green }}, {{ scheme.settings.background_color.blue }};
            {% if scheme.settings.background_gradient_color != empty %}
                --gradient-background: {{ scheme.settings.background_gradient_color }};
            {% else %}
                --gradient-background: {{ scheme.settings.background_color }};
            {% endif %}

            --color-foreground: {{ scheme.settings.text_color.red }}, {{ scheme.settings.text_color.green }}, {{ scheme.settings.text_color.blue }};

            --color-border: {{ scheme.settings.border_color.red }}, {{ scheme.settings.border_color.green }}, {{ scheme.settings.border_color.blue }};

            --color-success-background: {{ scheme.settings.success_background_color.red }}, {{ scheme.settings.success_background_color.green }}, {{ scheme.settings.success_background_color.blue }};
            --color-success-foreground: {{ scheme.settings.success_foreground_color.red }}, {{ scheme.settings.success_foreground_color.green }}, {{ scheme.settings.success_foreground_color.blue }};
            --color-error-background: {{ scheme.settings.error_background_color.red }}, {{ scheme.settings.error_background_color.green }}, {{ scheme.settings.error_background_color.blue }};
            --color-error-foreground: {{ scheme.settings.error_foreground_color.red }}, {{ scheme.settings.error_foreground_color.green }}, {{ scheme.settings.error_foreground_color.blue }};

            {% comment %} Shadow steps rise on dark backgrounds; tint steps are one set on :root {% endcomment %}
            {%- assign scheme_brightness = scheme.settings.background_color | color_brightness -%}
            {%- if scheme_brightness < 128 -%}
                --alpha-shadow-sm: 0.28;
                --alpha-shadow-md: 0.45;
                --alpha-shadow-lg: 0.6;
            {%- else -%}
                --alpha-shadow-sm: 0.06;
                --alpha-shadow-md: 0.1;
                --alpha-shadow-lg: 0.16;
            {%- endif %}

            {% comment %} Scheme-dependent colour roles, re-declared here so var() consumers resolve against this scheme. Same values as tailwind.input.css (lint:theme colour-role-sync). {% endcomment %}
            --color-muted: rgba(var(--color-foreground), var(--alpha-80));
            --color-subtle: rgba(var(--color-foreground), var(--alpha-72));
            --color-faint: rgba(var(--color-foreground), var(--alpha-20));
            --color-line: rgba(var(--color-border), var(--alpha-20));
            --color-line-strong: rgba(var(--color-border), var(--alpha-35));
            --color-line-inverse: rgba(var(--color-background), var(--alpha-20));
            --color-surface-muted: rgba(var(--color-foreground), var(--alpha-5));
            --color-surface-strong: rgba(var(--color-foreground), var(--alpha-10));
            --color-indicator: rgba(var(--color-foreground), var(--alpha-35));
            --color-indicator-strong: rgba(var(--color-foreground), var(--alpha-50));
            --color-veil: rgba(var(--color-background), var(--alpha-80));
            --shadow-sm: 0 1px 3px rgba(0, 0, 0, var(--alpha-shadow-sm));
            --shadow-md: 0 8px 24px rgba(0, 0, 0, var(--alpha-shadow-md));
            --shadow-lg: 0 14px 36px rgba(0, 0, 0, var(--alpha-shadow-lg));
        }
    {% endfor %}

    {% comment %} last result: body, .color-sheme-1{}, .color-sheme-2{} ... {% endcomment %}
    {{ scheme_classes | prepend: 'body' }} {
        color: rgb(var(--color-foreground));
        background-color: rgb(var(--color-background));
    }

    :root {
        {% comment %} Colour steps (layer 1); roles in tailwind.input.css consume them {% endcomment %}
        --alpha-5: 0.05;
        --alpha-10: 0.1;
        --alpha-20: 0.2;
        --alpha-35: 0.35;
        --alpha-50: 0.5;
        --alpha-72: 0.72;
        --alpha-80: 0.8;

        {%- comment -%} global Variables {%- endcomment -%}
        --header-height: 0px;

        {% comment %} layout Variables {% endcomment %}
        --page-width: {{ settings.page_width | divided_by: 10}}rem;
        {%- liquid
            assign page_margin_v = settings.page_margin | plus: 0
            assign page_margin_min_px = 16
            if page_margin_v < page_margin_min_px
                assign page_margin_min_px = page_margin_v
            endif
            assign page_margin_min_r = page_margin_min_px | times: 1.0 | divided_by: 10
            assign page_margin_max_r = page_margin_v | times: 1.0 | divided_by: 10
            if page_margin_min_r == page_margin_max_r
                assign page_margin_clamp = page_margin_max_r | append: 'rem'
            else
                assign page_margin_diff_r = page_margin_max_r | minus: page_margin_min_r
                assign page_margin_b_vw = page_margin_diff_r | divided_by: 0.905
                assign page_margin_b_at_min = page_margin_b_vw | times: 0.375
                assign page_margin_a_rem = page_margin_min_r | minus: page_margin_b_at_min
                capture page_margin_clamp
                    echo 'clamp('
                    echo page_margin_min_r | round: 4
                    echo 'rem, '
                    echo page_margin_a_rem | round: 4
                    echo 'rem + '
                    echo page_margin_b_vw | round: 4
                    echo 'vw, '
                    echo page_margin_max_r | round: 4
                    echo 'rem)'
                endcapture
            endif
        -%}
        --page-margin: {{ page_margin_clamp }};

        {% comment %} font Variables {% endcomment %}
        --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-style: {{ settings.type_body_font.style }};
        {%- liquid
            assign theme_body_font_size = settings.body_font_size | default: 16
            assign theme_body_font_size_mobile = settings.body_font_size_mobile | default: 16
        -%}
        --font-body-size: {{ theme_body_font_size }}px;
        --font-body-size-mobile: {{ theme_body_font_size_mobile }}px;
        --font-body-line-height: {{ settings.body_line_height }};
        --font-body-letter-spacing: {{ settings.body_letter_spacing }};
        --font-body-text-transform: {{ settings.body_text_transform }};
        --font-body-scale: 1;

        --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --font-heading-style: {{ settings.type_header_font.style }};
        --font-heading-weight: {{ settings.heading_weight }};
        --font-heading-line-height: {{ settings.heading_line_height }};
        --font-heading-letter-spacing: {{ settings.heading_letter_spacing }};
        --font-heading-text-transform: {{ settings.heading_text_transform }};
        --font-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};

        {%- comment -%} Fluid type steps: base times ratio^n, ratio 1.2 to 1.25 from 375px to 1280px {%- endcomment -%}
        {%- assign type_step_keys = '-2,-1,0,1,2,3,4,5,6,7,8' | split: ',' -%}
        {%- for step_key in type_step_keys -%}
            {%- liquid
                assign step_num = step_key | plus: 0
                assign mob_micro = theme_body_font_size_mobile | times: 10000
                assign desk_micro = theme_body_font_size | times: 10000
                if step_num < 0
                    assign abs_n = step_num | times: -1
                    for i in (1..abs_n)
                        assign mob_micro = mob_micro | times: 10 | divided_by: 12
                        assign desk_micro = desk_micro | times: 100 | divided_by: 125
                    endfor
                elsif step_num > 0
                    for i in (1..step_num)
                        assign mob_micro = mob_micro | times: 12 | divided_by: 10
                        assign desk_micro = desk_micro | times: 125 | divided_by: 100
                    endfor
                endif
                assign min_r = mob_micro | times: 1.0 | divided_by: 100000
                assign max_r = desk_micro | times: 1.0 | divided_by: 100000
                assign diff_r = max_r | minus: min_r
                assign b_vw = diff_r | divided_by: 0.905
                assign b_at_min = b_vw | times: 0.375
                assign a_rem = min_r | minus: b_at_min
                assign type_step_token = 'type-step-' | append: step_key
                comment
                    A step below the base, or a mobile base above the desktop base, makes the narrow
                    end the larger one. clamp() needs its bounds in order, so sort them.
                endcomment
                assign low_r = min_r
                assign high_r = max_r
                if min_r > max_r
                    assign low_r = max_r
                    assign high_r = min_r
                endif
            -%}
        --{{ type_step_token }}: clamp({{ low_r | round: 4 }}rem, {{ a_rem | round: 4 }}rem + {{ b_vw | round: 4 }}vw, {{ high_r | round: 4 }}rem);
        {%- endfor -%}

        {% comment %} Motion Variables {% endcomment %}
        --motion-duration: 500ms;
        --motion-duration-fast: 250ms;
        --motion-duration-base: 400ms;
        --motion-duration-slow: 500ms;

        --motion-ease: cubic-bezier(0.22, 1, 0.36, 1);
        --motion-ease-default: var(--motion-ease);
        --motion-ease-enter: cubic-bezier(0.22, 1, 0.36, 1);
        --motion-ease-exit: cubic-bezier(0.55, 0, 1, 0.45);
    }
{% endstyle %}
