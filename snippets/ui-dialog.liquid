{% doc %}
Renders the shared Alpine-driven drawer shell.

@param {string} id - Unique dialog identifier; must match `$store.dialog.open(id)`.
@param {string} content - Captured drawer content.
@param {string} [position] - `left` or `right`. Defaults to `right`.
@param {string} [top_class] - Viewport top-offset utility. Defaults to `top-0`.
@param {string} [color_scheme] - Optional color scheme id.
@param {string} [overlay_class] - Overlay background utilities.
@param {boolean} [show_overlay] - Whether to render the overlay. Defaults to true.
@param {string} [root_class] - Extra root classes.
@param {string} [drawer_wrapper_class] - Extra drawer shell classes.
@param {string} [drawer_panel_class] - Extra drawer panel classes.
@param {string} [mobile_layout] - `default` or `inset`.
@param {string} [drawer_motion_mode] - `slide` or `none`. Defaults to `slide`.
@param {boolean} [drawer_motion_sheet] - Use bottom-sheet motion below the pc breakpoint.
@param {boolean} [drawer_desktop_layout] - Apply the shared desktop drawer shell preset.
@param {boolean} [show_close_button] - Render the corner close button.
@param {string} [close_label] - Accessible close-button label.

@example
{% capture drawer_content %}Drawer content{% endcapture %}
{% render 'ui-dialog', id: 'filters', position: 'left', content: drawer_content %}
{% enddoc %}

{%- assign dialog_position = position | default: 'right' -%}
{%- assign dialog_top_class = top_class | default: 'top-0' -%}
{%- assign overlay_bg = overlay_class | default: 'bg-dialog-overlay' -%}
{%- assign dialog_show_overlay = show_overlay | default: true -%}
{%- assign root_classes = root_class | default: '' -%}
{%- assign drawer_wrapper_classes = drawer_wrapper_class | default: '' -%}
{%- assign drawer_panel_classes = drawer_panel_class | default: '' -%}
{%- assign dialog_show_close_button = show_close_button | default: false -%}
{%- assign dialog_close_label = close_label | default: '' -%}

{%- liquid
    assign mobile_layout_value = mobile_layout | default: 'default'
    assign mobile_layout_inset_class = ''

    if mobile_layout_value == 'inset'
        assign mobile_layout_inset_class = 'ui-dialog-mobile-layout-inset'
        assign drawer_panel_classes = 'ui-dialog-mobile-layout-panel ' | append: drawer_panel_classes | strip
    endif

    assign drawer_desktop_layout_enabled = drawer_desktop_layout | default: false
    assign drawer_desktop_shell_classes = ''
    if drawer_desktop_layout_enabled
        assign drawer_desktop_shell_classes = 'ui-dialog-desktop-drawer ui-dialog-desktop-drawer--' | append: dialog_position
    endif

    assign drawer_wrapper_classes = 'ui-dialog-drawer-width-default ' | append: drawer_desktop_shell_classes | append: ' ' | append: drawer_wrapper_classes | strip

    assign color_scope_class = color_scheme | default: ''
    if color_scope_class != blank
        assign color_scope_class = 'color-' | append: color_scope_class | append: ' surface-component'
    else
        assign color_scope_class = ''
    endif

    assign drawer_motion_resolved = ''
    if drawer_motion_mode != 'none'
        assign drawer_motion_resolved = 'slide'
    endif

    assign drawer_motion_sheet_enabled = false
    if drawer_motion_sheet
        assign drawer_motion_sheet_enabled = true
    endif
-%}

{%- capture dialog_close_button_markup -%}
    {%- if dialog_show_close_button -%}
        <button
            type="button"
            class="close-button close-button-corner"
            @click="$store.dialog.close()"
            aria-label="{{ dialog_close_label | escape }}"
        >
            {% render 'icons', icon: 'icon-close' %}
        </button>
    {%- endif -%}
{%- endcapture -%}

<div
    x-data="{}"
    x-show="$store.dialog.active === $el.dataset.dialogId || $store.dialog.closing === $el.dataset.dialogId"
    x-cloak
    class="fixed inset-0 z-layer-drawer-backdrop {{ root_classes }}"
    @keydown.escape.window="$store.dialog.close()"
    data-dialog-root
    data-dialog-id="{{ id | escape }}"
    {% if drawer_motion_resolved == 'slide' %}
        data-drawer-motion
        data-drawer-motion-slide="{{ dialog_position }}"
        {% if drawer_motion_sheet_enabled %}
            data-drawer-motion-sheet-below-pc
        {% endif %}
    {% endif %}
>
    {%- if dialog_show_overlay -%}
        <div
            class="fixed inset-x-0 bottom-0 z-layer-drawer-backdrop {{ dialog_top_class }} {{ overlay_bg }}"
            {% if drawer_motion_resolved == 'slide' %}
                data-drawer-motion-backdrop
            {% endif %}
            @click="$store.dialog.close()"
        ></div>
    {%- endif -%}

    <div
        class="
            ui-dialog-drawer-shell fixed bottom-0 z-layer-drawer w-full
            {{ dialog_top_class }}
            {% if dialog_position == 'left' %}
                left-0
            {% else %}
                right-0
            {% endif %}
            {{ mobile_layout_inset_class }}
            {{ drawer_wrapper_classes }}
        "
        role="dialog"
        aria-modal="true"
        aria-labelledby="dialog-title-{{ id | escape }}"
        data-dialog-panel
        {% if drawer_motion_resolved == 'slide' %}
            data-drawer-motion-target
        {% endif %}
        tabindex="-1"
        @click.stop
    >
        <div
            class="ui-dialog-panel ui-dialog-drawer-panel {{ drawer_panel_classes }}{% if color_scheme != blank %} {{ color_scope_class }}{% endif %}"
        >
            {{ dialog_close_button_markup }}
            {{ content }}
        </div>
    </div>
</div>
