{% doc %}
    Global pagination snippet with the default mother-template style.

    Usage (must pass a paginate object from within a `{% paginate %}` block):

    {% paginate collection.products by 24 %}
      <!-- your list -->
      {% render 'pagination', paginate_obj: paginate %}
    {% endpaginate %}

    @param {paginate} paginate_obj - Paginate object from a surrounding `{% paginate %}` tag.
{% enddoc %}

{%- liquid
    assign pagination_data = paginate_obj
-%}

{%- if pagination_data and pagination_data.pages > 1 -%}
    <nav
        class="pagination py-10"
        role="navigation"
        data-pagination-nav
        style="--pagination-font-size: 13px; --pagination-radius: 4px;"
    >
        <div class="pagination__inner">
            {%- comment -%} PREVIOUS {%- endcomment -%}
            {%- if pagination_data.previous -%}
                <a
                    href="{{ pagination_data.previous.url }}"
                    class="pagination__button pagination__prev"
                >
                    {%- render 'icons', icon: 'icon-chevron-left' -%}
                    <span>{{ 'pagination.previous' | t }}</span>
                </a>
            {%- else -%}
                <span
                    class="pagination__button pagination__prev pagination__button--disabled"
                    aria-disabled="true"
                >
                    {%- render 'icons', icon: 'icon-chevron-left' -%}
                </span>
            {%- endif -%}

            {%- comment -%} PAGES {%- endcomment -%}
            <div class="pagination__pages-wrap">
                <div class="pagination__pages">
                    {%- for part in pagination_data.parts -%}
                        {%- if part.is_link -%}
                            <a
                                href="{{ part.url }}"
                                class="pagination__page"
                            >
                                {{- part.title -}}
                            </a>
                        {%- else -%}
                            {%- if part.title == pagination_data.current_page -%}
                                <span
                                    class="pagination__page pagination__page--current"
                                    aria-current="page"
                                >
                                    {{- part.title -}}
                                </span>
                            {%- else -%}
                                <span class="pagination__page pagination__page--ellipsis">
                                    {{- part.title -}}
                                </span>
                            {%- endif -%}
                        {%- endif -%}
                    {%- endfor -%}
                </div>
            </div>

            {%- comment -%} NEXT {%- endcomment -%}
            {%- if pagination_data.next -%}
                <a
                    href="{{ pagination_data.next.url }}"
                    class="pagination__button pagination__next"
                >
                    <span>{{ 'pagination.next' | t }}</span>
                    {%- render 'icons', icon: 'icon-chevron-right' -%}
                </a>
            {%- else -%}
                <span
                    class="pagination__button pagination__next pagination__button--disabled"
                    aria-disabled="true"
                >
                    {%- render 'icons', icon: 'icon-chevron-right' -%}
                </span>
            {%- endif -%}
        </div>
    </nav>
{%- endif -%}
