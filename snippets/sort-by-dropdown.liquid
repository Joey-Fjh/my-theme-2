{% doc %}
    Sort by dropdown — global reusable snippet.
    Uses the registered dropdown() Alpine component for toggle/close.
    Default styles are owned by semantic component classes in tailwind.snippets.css.

    @param {object} results - Object with sort_options and sort_by (e.g. collection, search, blog).
    @param {string} form_id - Optional. External form ID; triggers form change on select. Without it, dispatches 'sort-change' event.
    @param {string} class - Optional. CSS classes for the outermost wrapper (positioning, sizing, etc.).
    @param {string} id_prefix - Optional. Unique prefix for listbox/button IDs (e.g. section.id + position). Ensures aria-controls uniqueness.
    @param {string} [trigger_class] - Optional. CSS class override for the trigger button (escape hatch). Default: 'sort-by-dropdown__trigger'.
    @param {string} [panel_class] - Optional. CSS class override for the dropdown panel (escape hatch). Default: 'sort-by-dropdown__panel'.
    @param {string} [option_class] - Optional. CSS class override for each option button base (escape hatch). Default: 'sort-by-dropdown__option'.
    @param {string} [option_active_class] - Optional. CSS class applied to the selected option (escape hatch). Default: 'sort-by-dropdown__option--active'.
    @param {string} [option_inactive_class] - Optional. CSS class applied to unselected options (escape hatch). Default: 'sort-by-dropdown__option--inactive'.
{% enddoc %}

{%- assign sort_options = results.sort_options -%}
{%- assign current_sort = results.sort_by | default: results.default_sort_by -%}
{%- assign wrapper_class = class | default: '' -%}
{%- assign trigger_class = trigger_class | default: 'sort-by-dropdown__trigger' -%}
{%- assign panel_class = panel_class
    | default: 'sort-by-dropdown__panel panel-motion panel-motion-compact'
-%}
{%- assign option_class = option_class | default: 'sort-by-dropdown__option' -%}
{%- assign option_active_class = option_active_class
    | default: 'sort-by-dropdown__option--active'
-%}
{%- assign option_inactive_class = option_inactive_class
    | default: 'sort-by-dropdown__option--inactive'
-%}

<div
    x-data="dropdown"
    data-module-id="dropdown"
    @click.outside="close(0)"
    @keydown.escape.window="if (openEls[0]) { close(0); $nextTick(() => $refs.sortTrigger?.focus()) }"
    {% if wrapper_class != blank %}
        class="{{ wrapper_class }}"
    {% endif %}
>
    <div
        x-data="sortByDropdown"
        data-module-id="sort-by-dropdown"
        data-current-sort="{{ current_sort | escape }}"
        data-form-id="{{ form_id | default: '' | escape }}"
        data-option-active-class="{{ option_active_class | escape }}"
        data-option-inactive-class="{{ option_inactive_class | escape }}"
        data-sort-by-dropdown
        class="relative"
        data-dropdown
        data-deep="0"
    >
        <input
            type="hidden"
            name="sort_by"
            data-sort-by-control
            :value="sortBy"
            {% if form_id %}
                form="{{ form_id }}"
            {% endif %}
        >

        <button
            type="button"
            id="sort-trigger-{{ id_prefix | default: form_id | default: 'default' }}"
            x-ref="sortTrigger"
            class="{{ trigger_class }}"
            aria-controls="sort-listbox-{{ id_prefix | default: form_id | default: 'default' }}"
            :aria-expanded="Boolean(openEls[0])"
            aria-label="{{ 'accessibility.sort_by' | t }}"
            @click.stop.prevent="toggle($el.parentElement)"
        >
            <span>{{ 'collections.sort_by' | t }}</span>
            {% render 'icons', icon: 'icon-sortby', class: 'shrink-0' %}
        </button>

        <div
            id="sort-listbox-{{ id_prefix | default: form_id | default: 'default' }}"
            aria-labelledby="sort-trigger-{{ id_prefix | default: form_id | default: 'default' }}"
            class="{{ panel_class }}"
            x-show="openEls[0]"
            x-cloak
        >
            {%- for option in sort_options -%}
                <div
                    class="px-4 py-2"
                >
                    <button
                        type="button"
                        class="{{ option_class }}"
                        data-option-value="{{ option.value | escape }}"
                        :aria-pressed="isSelected($el.dataset.optionValue)"
                        :class="isSelected($el.dataset.optionValue) ? optionActiveClass : optionInactiveClass"
                        @click="select($el.dataset.optionValue); close(0)"
                    >
                        {{ option.name | escape }}
                    </button>
                </div>
            {%- endfor -%}
        </div>
    </div>
</div>

{% stylesheet %}
    .sort-by-dropdown__trigger {
        display: flex;
        cursor: pointer;
        align-items: center;
        gap: 0.75rem;
        color: rgb(var(--color-foreground));
    }

    .sort-by-dropdown__trigger:focus-visible {
        outline: var(--focus-ring-width) solid
            rgba(var(--color-focus-ring), var(--focus-ring-opacity, 0.4));
        outline-offset: var(--focus-ring-offset);
    }

    .sort-by-dropdown__trigger:focus:not(:focus-visible) {
        outline: none;
    }

    .sort-by-dropdown__panel {
        position: absolute;
        top: 100%;
        right: 0;
        min-width: 25rem;
        border-radius: 0.5rem;
        border: 1px solid rgba(var(--color-border), 0.2);
        background-color: rgb(var(--color-background));
        z-index: var(--z-layer-dropdown);
    }

    .sort-by-dropdown__option {
        display: block;
        width: 100%;
        text-align: start;
        font-family: var(--font-body-family);
        font-style: var(--font-body-style);
        line-height: var(--font-body-line-height);
        letter-spacing: var(--font-body-letter-spacing);
        text-transform: var(--font-body-text-transform);
        word-break: break-word;
        font-size: calc(var(--font-body-size-mobile) * var(--font-body-scale));
        color: currentColor;
        transition: opacity var(--motion-duration-fast, 250ms) var(--motion-ease-enter, ease);
    }

    @media (width >= 48rem) {
        .sort-by-dropdown__option {
            font-size: calc(var(--font-body-size) * var(--font-body-scale) * 1.125);
        }
    }

    .sort-by-dropdown__option--active {
        font-weight: 700;
        border-bottom: 1px solid currentColor;
    }

    .sort-by-dropdown__option--inactive {
        opacity: 0.6;
    }

    .sort-by-dropdown__option--inactive:hover {
        opacity: 1;
    }
{% endstylesheet %}
