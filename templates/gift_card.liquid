{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
    <head>
        {% render 'css-variables' %}
        {{ 'tailwind.output.css' | asset_url | stylesheet_tag: preload: true }}
        {{ 'gift-card.css' | asset_url | stylesheet_tag }}
        {% render 'meta-tags' %}
        <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
        <script src="{{ 'gift-card.js' | asset_url }}" defer></script>
        {{ content_for_header }}
    </head>

    <body class="gift-card-page color-scheme-2">
        <a class="skip-link" href="#MainContent">
            {{- 'accessibility.skip_to_content' | t -}}
        </a>

        <main id="MainContent" tabindex="-1">
            <header>
                {% if settings.logo %}
                    {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                    {{
                        settings.logo
                        | image_url: width: 320
                        | image_tag: alt: logo_alt, loading: 'eager'
                    }}
                {% else %}
                    <a class="copy-l" href="{{ routes.root_url }}">
                        {{ shop.name }}
                    </a>
                {% endif %}
            </header>

            <article>
                <p class="copy-s">{{ 'gift_card.card' | t }}</p>
                <h1 class="title-xl">{{ 'gift_card.title' | t }}</h1>
                <p class="copy-xl">{{ gift_card.balance | money_with_currency }}</p>

                <img
                    src="{{ 'gift-card/card.svg' | shopify_asset_url }}"
                    alt=""
                    width="300"
                    height="200"
                >

                {% if gift_card.enabled == false or gift_card.expired %}
                    <p role="status">{{ 'gift_card.expired' | t }}</p>
                {% endif %}

                {% if gift_card.expires_on %}
                    {% assign expires_on = gift_card.expires_on | date: '%B %e, %Y' %}
                    <p class="copy-m">
                        {{ 'gift_card.expires_on' | t: expires_on: expires_on }}
                    </p>
                {% endif %}

                <p class="copy-l">{{ 'gift_card.use_at_checkout' | t }}</p>

                <div
                    data-gift-card-qr
                    data-identifier="{{ gift_card.qr_identifier | escape }}"
                    aria-hidden="true"
                ></div>

                <p class="copy-s">{{ 'gift_card.code_label' | t }}</p>
                <code class="copy-l" data-gift-card-code>
                    {{- gift_card.code | format_code -}}
                </code>
                <button
                    type="button"
                    data-gift-card-copy
                    data-code="{{ gift_card.code | escape }}"
                    data-success-message="{{ 'gift_card.code_copied' | t | escape }}"
                >
                    {{ 'gift_card.copy_code' | t }}
                </button>
                <span
                    class="sr-only"
                    role="status"
                    aria-live="polite"
                    data-gift-card-copy-status
                ></span>

                <a class="btn" href="{{ routes.root_url }}">
                    {{ 'gift_card.continue_shopping' | t }}
                </a>

                {% if gift_card.pass_url %}
                    <a href="{{ gift_card.pass_url }}">
                        <img
                            src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                            alt="{{ 'gift_card.add_to_apple_wallet' | t | escape }}"
                            width="200"
                            height="60"
                        >
                    </a>
                {% endif %}
            </article>
        </main>
    </body>
</html>
