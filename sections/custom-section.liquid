<div
    data-section-id="{{ section.id }}"
    class="custom-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page">
        {% content_for 'blocks' %}
    </div>
</div>

{% schema %}
{
    "name": "t:sections.custom-section.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "blocks": [{ "type": "@theme" }],
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.custom-section.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.custom-section.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.custom-section.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.custom-section.settings.padding_bottom",
            "default": 32
        }
    ],
    "presets": [
        {
            "name": "t:sections.custom-section.presets.name"
        }
    ]
}
{% endschema %}
