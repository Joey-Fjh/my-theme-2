<div
    data-section-id="{{ section.id }}"
    class="section color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-pagination-section-id="{{ section.id }}"
    data-pagination-selectors='["[data-collection-dynamic-content]"]'
    x-data="sectionPagination()"
    data-module-id="section-pagination"
    data-module-lazy
>
    <h1 class="heading-4xl">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
        <div class="rte body-xl">{{ collection.description }}</div>
    {%- endif -%}

    <div class="relative" data-collection-dynamic-content>
        {% render 'loading' %}

        {% paginate collection.products by 12 %}
            <div class="grid-list">
                {%- for product in collection.products -%}
                    <div>
                        {%- liquid
                            assign card_aspect_ratio = blank
                            case settings.product_card_image_ratio
                                when 'square'
                                    assign card_aspect_ratio = '1/1'
                                when 'portrait'
                                    assign card_aspect_ratio = '4/5'
                                when 'landscape'
                                    assign card_aspect_ratio = '4/3'
                            endcase
                            assign card_loading = 'lazy'
                            if forloop.first
                                assign card_loading = 'eager'
                            endif
                        -%}
                        <a href="{{ product.url }}">
                            {%- render 'image',
                                image: product.featured_image,
                                width: 1600,
                                alt: '',
                                sizes: '(min-width: 1200px) 33vw, (min-width: 800px) 50vw, 100vw',
                                widths: '400,700,1000,1200,1600',
                                loading: card_loading,
                                aspect_ratio: card_aspect_ratio
                            -%}
                            <h2 class="heading-h6">{{ product.title }}</h2>
                            <span>{{ product.price | money }}</span>
                        </a>
                    </div>
                {%- else -%}
                    <p class="body-lg">{{ 'collections.no_products' | t }}</p>
                {%- endfor -%}
            </div>

            <div @click="onNavClick($event)">
                {% render 'pagination', paginate_obj: paginate %}
            </div>
        {% endpaginate %}
    </div>
</div>

{% schema %}
{
    "name": "t:general.collection",
    "tag": "section",
    "enabled_on": {
        "templates": ["collection"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.collection.settings.content_color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.collection.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.collection.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.collection.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
