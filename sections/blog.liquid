<div
    data-section-id="{{ section.id }}"
    class="section color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-pagination-section-id="{{ section.id }}"
    data-pagination-selectors='[".blog-articles-grid",".blog-pagination-wrapper"]'
    x-data="sectionPagination()"
    data-module-id="section-pagination"
    data-module-lazy
>
    <h1 class="heading-3xl">{{ blog.title }}</h1>

    <div class="relative">
        {% render 'loading' %}

        {% paginate blog.articles by 12 %}
            <div class="blog-articles-grid grid-list">
                {% for article in blog.articles %}
                    <article>
                        {%- render 'image',
                            url: article.url,
                            image: article.image,
                            alt: article.title,
                            width: article.image.width,
                            sizes: '(min-width: 1200px) 33vw, (min-width: 800px) 50vw, 100vw',
                            widths: '400,700,1000,1200,1600'
                        -%}

                        <p>{{ article.tags | first }}</p>

                        <h2 class="heading-h2">
                            <a href="{{ article.url }}">{{ article.title }}</a>
                        </h2>

                        {%- liquid
                            assign article_excerpt = article.excerpt_or_content | strip_html | strip | truncatewords: 30
                        -%}
                        {%- if article_excerpt != blank -%}
                            <p class="body-lg">{{ article_excerpt | escape_once }}</p>
                        {%- endif -%}

                        {%- if article.url != blank -%}
                            {%- assign read_more_text = 'blog.read_more' | t -%}
                            <a
                                class="body-xl underline underline-offset-4"
                                href="{{ article.url }}"
                            >
                                {{ read_more_text }}
                            </a>
                        {%- endif -%}
                    </article>
                {% endfor %}
            </div>

            <div class="blog-pagination-wrapper" @click="onNavClick($event)">
                {% render 'pagination', paginate_obj: paginate %}
            </div>
        {% endpaginate %}
    </div>
</div>

{% schema %}
{
    "name": "t:general.blog",
    "tag": "section",
    "enabled_on": {
        "templates": ["blog"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.blog.settings.content_color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.blog.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.blog.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.blog.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
