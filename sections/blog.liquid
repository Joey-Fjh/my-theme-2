<div
    data-section-id="{{ section.id }}"
    class="full-width relative"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-pagination-section-id="{{ section.id }}"
    data-pagination-selectors='[".blog-articles-grid",".blog-pagination-wrapper"]'
    x-data="sectionPagination()"
    data-module-id="section-pagination"
    data-module-lazy
>
    <div
        class="layout container-page color-{{ section.settings.color_scheme }} surface-section"
    >
        <div class="pt-10 pb-8">
            <div>
                <h1 class="heading-3xl">{{ blog.title }}</h1>
            </div>
        </div>

        <div class="relative w-full">
            {% render 'loading', overlay: true, size: 'large' %}

            {% paginate blog.articles by 12 %}
                <div
                    class="blog-articles-grid grid grid-cols-1 gap-8 pb-10 pc:grid-cols-3"
                >
                    {% for article in blog.articles %}
                        <article>
                            <div class="mb-4 block aspect-4/3">
                                {%- capture sizes -%}
                                    (max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw
                                {%- endcapture -%}

                                {%- capture widths -%}
                                    400, 700
                                {%- endcapture -%}

                                {%- render 'image',
                                    url: article.url,
                                    wrapper_class: 'block h-full w-full',
                                    img_class: 'h-full w-full object-cover',
                                    image: article.image,
                                    alt: article.title,
                                    width: article.image.width,
                                    sizes: sizes,
                                    widths: widths
                                -%}
                            </div>

                            <div>
                                <p class="my-6">
                                    {{ article.tags | first }}
                                </p>

                                <h2 class="my-6 heading-h2">
                                    <a href="{{ article.url }}">{{ article.title }}</a>
                                </h2>

                                {%- liquid
                                    assign article_excerpt = article.excerpt_or_content | strip_html | strip | truncatewords: 30
                                -%}
                                {%- if article_excerpt != blank -%}
                                    <p class="my-6 body-lg text-theme-text">
                                        {{- article_excerpt | escape_once -}}
                                    </p>
                                {%- endif -%}

                                {%- if article.url != blank -%}
                                    {%- assign read_more_text = 'blog.read_more' | t -%}
                                    {%- render 'link',
                                        href: article.url,
                                        text: read_more_text,
                                        variant: 'underline',
                                        class: 'body-xl'
                                    -%}
                                {%- endif -%}
                            </div>
                        </article>
                    {% endfor %}
                </div>

                <div
                    class="blog-pagination-wrapper"
                    @click="
                        let link = $event.target.closest('[data-pagination-nav] a');
                        if (link) {
                            $event.preventDefault();
                            loadUrl(link.href);
                        }
                    "
                >
                    {% render 'pagination', paginate_obj: paginate %}
                </div>
            {% endpaginate %}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:general.blog",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["blog"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.blog.settings.content_color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.blog.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.blog.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.blog.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
