<div
    data-section-id="{{ section.id }}"
    class="blog-section full-width relative"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    data-pagination-section-id="{{ section.id }}"
    data-pagination-selectors='[".blog-articles-grid",".blog-pagination-wrapper"]'
    x-data="sectionPagination()"
    data-module-id="section-pagination"
    data-module-lazy
>
    <div
        class="layout container-page color-{{ section.settings.color_scheme }} surface-section"
    >
        <div
            class="pt-10 pb-8"
            x-data="motionRevealSection()"
            data-module-id="motion-reveal-section"
            data-module-lazy
            data-motion-section
        >
            <div data-motion-reveal data-motion-critical>
                {%- liquid
                    assign resolved_heading = blog.title
                    if section.settings.header != blank
                        assign resolved_heading = section.settings.header
                    endif
                    assign resolved_description = section.settings.description
                    if resolved_description == blank
                        assign resolved_description = 'blog.description_html' | t
                    endif
                -%}
                <h1 class="heading-3xl">{{ resolved_heading }}</h1>
                {%- render 'rte-compact-prose',
                    content: resolved_description,
                    content_class: 'body-xl'
                -%}
            </div>
        </div>

        <div class="relative w-full">
            {% render 'loading', overlay: true, size: 'large' %}

            {% paginate blog.articles by section.settings.articles_per_page %}
                <div
                    class="blog-articles-grid grid grid-cols-1 gap-8 pb-10 pc:grid-cols-3"
                    x-data="motionRevealSection()"
                    data-module-id="motion-reveal-section"
                    data-module-lazy
                    data-motion-section
                >
                    {% for article in blog.articles %}
                        <article
                            class="group"
                            data-motion-reveal
                        >
                            <div class="mb-4 block aspect-4/3 overflow-hidden rounded-sm">
                                {%- capture sizes -%}
                                    (max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw
                                {%- endcapture -%}

                                {%- capture widths -%}
                                    400, 700
                                {%- endcapture -%}

                                {%- render 'image',
                                    url: article.url,
                                    wrapper_class: 'block h-full w-full',
                                    img_class: 'h-full w-full object-cover',
                                    image: article.image,
                                    alt: article.title,
                                    width: article.image.width,
                                    sizes: sizes,
                                    widths: widths,
                                    motion_reveal: false
                                -%}
                            </div>

                            <div>
                                <p class="my-6">
                                    {{ article.tags | first }}
                                </p>

                                <h2 class="my-6 heading-h2">
                                    <a href="{{ article.url }}">{{ article.title }}</a>
                                </h2>

                                {%- liquid
                                    assign article_excerpt = article.excerpt_or_content | strip_html | strip | truncatewords: 30
                                -%}
                                {%- if article_excerpt != blank -%}
                                    <p class="my-6 body-lg text-theme-text/80">
                                        {{- article_excerpt | escape_once -}}
                                    </p>
                                {%- endif -%}

                                {%- if article.url != blank -%}
                                    {%- render 'link',
                                        href: article.url,
                                        text: section.settings.link_text,
                                        variant: 'underline',
                                        class: 'body-xl'
                                    -%}
                                {%- endif -%}
                            </div>
                        </article>
                    {% endfor %}
                </div>

                <div
                    class="blog-pagination-wrapper"
                    @click="
                        let link = $event.target.closest('[data-pagination-nav] a');
                        if (link) {
                            $event.preventDefault();
                            loadUrl(link.href);
                        }
                    "
                >
                    {% render 'pagination', paginate_obj: paginate %}
                </div>
            {% endpaginate %}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:general.blog",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["blog"]
    },
    "settings": [
        {
            "type": "inline_richtext",
            "id": "header",
            "default": "t:sections.blog.defaults.header",
            "label": "t:sections.blog.settings.header"
        },
        {
            "type": "richtext",
            "id": "description",
            "default": "t:sections.blog.defaults.description",
            "label": "t:sections.blog.settings.description"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.blog.settings.content_color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "range",
            "id": "articles_per_page",
            "min": 3,
            "max": 24,
            "step": 3,
            "default": 12,
            "label": "t:sections.blog.settings.articles_per_page"
        },
        {
            "type": "text",
            "id": "link_text",
            "label": "t:sections.blog.settings.link_text",
            "default": "t:sections.blog.defaults.link_text"
        },
        {
            "type": "header",
            "content": "t:sections.blog.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.blog.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.blog.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
