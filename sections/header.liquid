{%- liquid
    assign header_menu = section.settings.menu
    assign has_header_menu = false
    if header_menu != blank and header_menu.links != blank
        assign has_header_menu = true
    endif
    assign has_country_selector = false
    if localization.available_countries.size > 1
        assign has_country_selector = true
    endif
    assign has_language_selector = false
    if localization.available_languages.size > 1
        assign has_language_selector = true
    endif
    assign has_mobile_drawer = false
    if has_header_menu or shop.customer_accounts_enabled or has_country_selector or has_language_selector
        assign has_mobile_drawer = true
    endif
-%}

<header
    data-section-id="{{ section.id }}"
    class="section header color-{{ section.settings.color_scheme }}"
>
    <div class="header__frame">
        <div class="header__bar">
            <div class="header__brand" style="--header-logo-width: {{ settings.logo_width }}px">
                {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                {%- if settings.logo -%}
                    {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
                    {%- capture sizes -%}
                        (max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px
                    {%- endcapture -%}
                    {%- capture widths -%}
                        {{ settings.logo_width }},{{ settings.logo_width | times: 1.5 | round }},{{ settings.logo_width | times: 2 }}
                    {%- endcapture -%}
                    {% render 'image',
                        image: settings.logo,
                        width: settings.logo_width,
                        height: logo_height,
                        alt: logo_alt,
                        url: routes.root_url,
                        sizes: sizes,
                        widths: widths,
                        loading: 'eager',
                        mode: 'natural',
                        fit: 'contain'
                    %}
                {%- else -%}
                    <a
                        class="header__wordmark"
                        href="{{ routes.root_url }}"
                        aria-label="{{ 'accessibility.home_link' | t: shop_name: shop.name }}"
                    >
                        {{- shop.name -}}
                    </a>
                {%- endif -%}
            </div>

            <div class="header__nav">
                {%- if has_header_menu -%}
                    {%- render 'header-dropdown-menu' -%}
                {%- endif -%}
            </div>

            <div class="header__tools">
                <a
                    class="header__tool"
                    href="{{ routes.search_url }}"
                    aria-label="{{ 'accessibility.search' | t }}"
                >
                    {% render 'icons', icon: 'icon-search', size: 'md' %}
                </a>

                {%- if shop.customer_accounts_enabled -%}
                    <div class="header__tool header__account">
                        <shopify-account menu="customer-account-main-menu">
                            <span slot="signed-out-avatar">
                                {%- render 'icons', icon: 'icon-account', size: 'md' -%}
                            </span>
                        </shopify-account>
                    </div>
                {%- endif -%}

                {%- assign cart_aria_label = 'accessibility.cart' | t -%}
                {%- if cart.item_count > 0 -%}
                    {%- assign cart_aria_label = 'accessibility.cart_with_count' | t: count: cart.item_count -%}
                {%- endif -%}
                <a
                    class="header__tool header__cart"
                    href="{{ routes.cart_url }}"
                    aria-label="{{ cart_aria_label }}"
                >
                    {% render 'icons', icon: 'icon-cart', size: 'md' %}
                    <span
                        class="header__cart-dot"
                        aria-hidden="true"
                        {% if cart.item_count == 0 %}
                            data-empty="true"
                        {% endif %}
                    ></span>
                </a>

                {%- if has_mobile_drawer -%}
                    <div
                        class="header__mobile-menu"
                        x-data="dropdown"
                        data-module-id="dropdown"
                        @click.capture="onMenuTriggerClickEvent($event)"
                        @click.outside="closeAndDeactivate()"
                        @keydown="onMenuKeydown($event)"
                    >
                        <details class="header__drawer dropdown" data-dropdown data-deep="0">
                            <summary
                                class="header__tool header__menu-trigger dropdown-trigger"
                                aria-label="{{ 'accessibility.open_menu' | t }}"
                            >
                                <span class="header__menu-bars" aria-hidden="true">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </span>
                                <span class="header__menu-close" aria-hidden="true">
                                    {% render 'icons', icon: 'icon-close', size: 'md' %}
                                </span>
                            </summary>

                            <nav
                                class="header__drawer-panel dropdown-panel dropdown-open color-{{ section.settings.color_scheme }} surface-component"
                                aria-label="{{ 'accessibility.main_menu' | t }}"
                            >
                                {%- if has_header_menu -%}
                                    <ul class="header__drawer-list" role="list">
                                        {%- for link in header_menu.links -%}
                                            <li class="header__drawer-item">
                                                <a
                                                    class="header__drawer-link copy-m"
                                                    href="{{ link.url }}"
                                                    {% if link.current %}
                                                        aria-current="page"
                                                    {% endif %}
                                                >
                                                    {{- link.title | escape -}}
                                                </a>
                                                {%- if link.links != blank -%}
                                                    <ul class="header__drawer-sublist" role="list">
                                                        {%- for childlink in link.links -%}
                                                            <li>
                                                                <a
                                                                    class="header__drawer-sublink copy-s"
                                                                    href="{{ childlink.url }}"
                                                                    {% if childlink.current %}
                                                                        aria-current="page"
                                                                    {% endif %}
                                                                >
                                                                    {{- childlink.title | escape -}}
                                                                </a>
                                                            </li>
                                                        {%- endfor -%}
                                                    </ul>
                                                {%- endif -%}
                                            </li>
                                        {%- endfor -%}
                                    </ul>
                                {%- endif -%}

                                {%- if shop.customer_accounts_enabled or has_country_selector or has_language_selector -%}
                                    <div class="header__drawer-utilities">
                                        {%- if shop.customer_accounts_enabled -%}
                                            <div class="header__drawer-account">
                                                <shopify-account menu="customer-account-main-menu">
                                                    <span slot="signed-out-avatar">
                                                        {%- render 'icons', icon: 'icon-account', size: 'sm' -%}
                                                    </span>
                                                </shopify-account>
                                            </div>
                                        {%- endif -%}
                                        {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
                                        {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
                                    </div>
                                {%- endif -%}
                            </nav>
                        </details>
                    </div>
                {%- endif -%}
            </div>
        </div>
    </div>
</header>

{% stylesheet %}
    .header__frame {
        container-type: inline-size;
        container-name: header-frame;
        position: relative;
        border-inline: 1px solid var(--color-line);
        border-block-end: 1px solid var(--color-line);
    }

    .header__bar {
        position: relative;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        min-height: clamp(5.8rem, 5.8cqi, 7rem);
        padding-inline: clamp(var(--spacing-step-m), 2cqi, var(--spacing-step-xl));
        column-gap: var(--spacing-step-m);
    }

    .header__brand {
        justify-self: start;
        min-width: 0;
    }

    .header__brand .theme-image {
        width: var(--header-logo-width);
    }

    .header__wordmark {
        --font-header-wordmark-size: clamp(
            calc(var(--font-heading-scale) * var(--font-heading-floor-0)),
            calc(var(--font-heading-scale) * var(--font-heading-floor-0) + 0.9cqi),
            calc(var(--type-step-2) * var(--font-heading-scale))
        );
        display: inline-block;
        white-space: nowrap;
        font-family: var(--font-heading-family);
        font-style: var(--font-heading-style);
        font-weight: var(--font-heading-weight);
        font-size: var(--font-header-wordmark-size);
        line-height: max(1, calc(var(--font-heading-line-height) * 0.85));
        letter-spacing: 0.025em;
        text-decoration: none;
        color: rgb(var(--color-foreground));
    }

    .header__nav {
        justify-self: center;
        min-width: 0;
    }

    .header__nav .header-dropdown-menu > ul {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(var(--spacing-step-l), calc(3.2cqi - var(--spacing-step-2xs)), var(--spacing-step-2xl));
        list-style: none;
        padding: 0;
    }

    .header__nav .header-dropdown-menu a,
    .header__nav .header-dropdown-menu .dropdown-trigger {
        display: inline-flex;
        align-items: center;
        gap: var(--spacing-step-3xs);
        min-height: 3.6rem;
        font-size: calc(var(--type-step--1) * var(--font-body-scale));
        font-weight: var(--font-heading-weight);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-decoration: none;
        white-space: nowrap;
        color: rgb(var(--color-foreground));
        transition: color var(--motion-duration-fast) var(--motion-ease-default);
    }

    .header__nav .dropdown-panel {
        border: 1px solid var(--color-line);
        padding: var(--spacing-step-s) var(--spacing-step-m);
    }

    .header__tools {
        justify-self: end;
        display: flex;
        align-items: center;
        gap: clamp(var(--spacing-step-xs), 1.6cqi, var(--spacing-step-l));
    }

    .header__tool {
        position: relative;
        display: inline-grid;
        place-items: center;
        flex-shrink: 0;
        min-width: 3.8rem;
        min-height: 3.8rem;
        color: rgb(var(--color-foreground));
        text-decoration: none;
        transition: color var(--motion-duration-fast) var(--motion-ease-default);
    }

    @media (hover: hover) and (pointer: fine) {
        .header__nav .header-dropdown-menu a:hover,
        .header__nav .header-dropdown-menu .dropdown-trigger:hover,
        .header__tool:hover,
        .header__drawer-link:hover,
        .header__drawer-sublink:hover {
            color: rgb(var(--color-accent-background));
        }
    }

    .header__cart-dot {
        position: absolute;
        inset-block-start: 0.55rem;
        inset-inline-end: 0.45rem;
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 9999px;
        background-color: rgb(var(--color-accent-background));
    }

    .header__cart-dot[data-empty='true'] {
        background-color: var(--color-indicator);
    }

    .header__mobile-menu {
        display: none;
    }

    .header__menu-bars {
        display: inline-flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.45rem;
        width: 2rem;
        height: 2rem;
    }

    .header__menu-bars span {
        display: block;
        width: 100%;
        height: 1.5px;
        background-color: currentColor;
    }

    .header__menu-close {
        display: none;
    }

    .header__drawer[open] .header__menu-bars {
        display: none;
    }

    .header__drawer[open] .header__menu-close {
        display: inline-flex;
    }

    .header__drawer-panel {
        inset-block-start: 100%;
        inset-inline-end: 0;
        min-width: min(32rem, calc(100cqi - var(--spacing-step-l)));
        max-width: 100cqi;
        border: 1px solid var(--color-line);
        padding: var(--spacing-step-s) var(--spacing-step-m);
    }

    .header__drawer-list,
    .header__drawer-sublist {
        list-style: none;
        padding: 0;
    }

    .header__drawer-item + .header__drawer-item {
        border-block-start: 1px solid var(--color-line);
    }

    .header__drawer-link {
        display: flex;
        align-items: center;
        min-height: 4.4rem;
        font-weight: var(--font-heading-weight);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        text-decoration: none;
        color: rgb(var(--color-foreground));
        transition: color var(--motion-duration-fast) var(--motion-ease-default);
    }

    .header__drawer-sublist {
        padding-inline-start: var(--spacing-step-m);
        padding-block-end: var(--spacing-step-xs);
    }

    .header__drawer-sublink {
        display: flex;
        align-items: center;
        min-height: 3.6rem;
        text-decoration: none;
        color: var(--color-muted);
        transition: color var(--motion-duration-fast) var(--motion-ease-default);
    }

    .header__drawer-utilities {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--spacing-step-s);
        padding-block-start: var(--spacing-step-s);
        border-block-start: 1px solid var(--color-line);
    }

    @container header-frame (max-width: 80.99rem) {
        .header__bar {
            grid-template-columns: 1fr auto;
        }

        .header__nav,
        .header__account {
            display: none;
        }

        .header__tools {
            gap: var(--spacing-step-2xs);
        }

        .header__tool {
            min-width: 4.2rem;
            min-height: 4.2rem;
        }

        .header__mobile-menu {
            display: block;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .header__nav .header-dropdown-menu a,
        .header__nav .header-dropdown-menu .dropdown-trigger,
        .header__tool,
        .header__drawer-link,
        .header__drawer-sublink {
            transition-duration: 0.01ms;
        }
    }
{% endstylesheet %}

{%- assign organization_social_setting_ids = 'social_twitter_link,social_facebook_link,social_pinterest_link,social_instagram_link,social_tiktok_link,social_tumblr_link,social_snapchat_link,social_youtube_link,social_vimeo_link'
    | split: ','
-%}
{%- capture organization_same_as -%}
    {%- assign organization_social_link_written = false -%}
    {%- for organization_social_setting_id in organization_social_setting_ids -%}
        {%- assign organization_social_url = settings[organization_social_setting_id] -%}
        {%- if organization_social_url != blank -%}
            {%- if organization_social_link_written -%},{%- endif -%}
            {{- organization_social_url | json -}}
            {%- assign organization_social_link_written = true -%}
        {%- endif -%}
    {%- endfor -%}
{%- endcapture -%}
{%- assign organization_same_as = organization_same_as | strip -%}

<script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      {% if settings.logo %}
        "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
      {% endif %}
      {% if organization_same_as != blank %}
        "sameAs": [{{ organization_same_as }}],
      {% endif %}
      "url": {{ request.origin | append: routes.root_url | json }}
    }
</script>

{%- if request.page_type == 'index' -%}
    {% assign potential_action_target = request.origin
        | append: routes.search_url
        | append: '?q={search_term_string}'
    %}
    <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": {{ shop.name | json }},
          "potentialAction": {
            "@type": "SearchAction",
            "target": {{ potential_action_target | json }},
            "query-input": "required name=search_term_string"
          },
          "url": {{ request.origin | append: page.url | json }}
        }
    </script>
{%- endif -%}

{% schema %}
{
    "name": "t:general.header",
    "tag": "section",
    "class": "site-header",
    "limit": 1,
    "enabled_on": {
        "groups": ["header"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.header.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "link_list",
            "id": "menu",
            "label": "t:labels.menu",
            "default": "main-menu"
        }
    ]
}
{% endschema %}
