{%- assign size_class = 'xl' -%}
{%- assign header_menu = section.settings.menu -%}
{%- assign has_header_menu = false -%}
{%- if header_menu != blank and header_menu.links != blank -%}
    {%- assign has_header_menu = true -%}
{%- endif -%}

<header
    data-section-id="{{ section.id }}"
    class="header-section full-width color-{{ section.settings.color_scheme }} surface-section"
>
    <div class="container-page">
        <div class="header__cols grid py-5">
            <div class="flex items-center pc:hidden" style="grid-area: mobile-menu">
                {%- if has_header_menu -%}
                    <nav
                        aria-label="{{ 'accessibility.mobile_menu' | t }}"
                        class="max-h-[70vh] overflow-y-auto"
                    >
                        <ul class="flex flex-col gap-2 py-2">
                            {%- for link in header_menu.links -%}
                                <li>
                                    {%- render 'link',
                                        href: link.url,
                                        text: link.title,
                                        variant: 'plain'
                                    -%}
                                </li>
                            {%- endfor -%}
                        </ul>
                    </nav>
                {%- endif -%}
                {%- if section.settings.enable_country_selector -%}
                    <div class="pc:hidden">
                        {%- render 'country-localization', localPosition: 'HeaderCountryMobile' -%}
                    </div>
                {%- endif -%}
                {%- if section.settings.enable_language_selector -%}
                    <div class="pc:hidden">
                        {%- render 'language-localization',
                            localPosition: 'HeaderLanguageMobile'
                        -%}
                    </div>
                {%- endif -%}
            </div>

            <div
                class="header-logo flex items-center justify-start"
                style="grid-area: logo; --header-logo-width: {{ settings.logo_width }}px"
            >
                {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                {%- assign logo_height = settings.logo_width
                    | divided_by: settings.logo.aspect_ratio
                -%}
                {%- capture sizes -%}
                    (max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px
                {%- endcapture -%}

                {%- capture widths -%}
                    {{ settings.logo_width }},{{ settings.logo_width | times: 1.5 | round }},{{ settings.logo_width | times:2 }}
                {%- endcapture -%}

                {%- if settings.logo -%}
                    {% render 'image',
                        image: settings.logo,
                        width: settings.logo_width,
                        height: logo_height,
                        alt: logo_alt,
                        url: routes.root_url,
                        sizes: sizes,
                        widths: widths,
                        loading: 'eager',
                        mode: 'natural',
                        fit: 'contain'
                    %}
                {%- else -%}
                    {%- render 'link',
                        text: shop.name,
                        class: 'header-logo__text',
                        variant: 'underline',
                        href: routes.root_url
                    -%}
                {%- endif -%}
            </div>

            <div
                class="header-menu flex items-center justify-center max-pc:hidden"
                style="grid-area: menu"
            >
                {%- if has_header_menu -%}
                    {%- render 'header-dropdown-menu' -%}
                {%- endif -%}
            </div>

            <div
                class="header-navigation flex items-center justify-end gap-3"
                style="grid-area:navigation"
            >
                <a
                    href="{{ routes.search_url }}"
                    class="header-search__right inline-flex h-10 w-10 shrink-0 items-center justify-center"
                    aria-label="{{ 'accessibility.search' | t }}"
                >
                    {% render 'icons', icon: 'icon-search', class: size_class %}
                </a>

                <a
                    href="{{ routes.cart_url }}"
                    class="relative inline-flex h-10 w-10 shrink-0 items-center justify-center"
                    aria-label="{{ 'accessibility.cart' | t }}"
                >
                    {% render 'icons', icon: 'icon-cart', class: size_class %}
                    <span
                        x-cloak
                        x-show="$store.cart && $store.cart.item_count > 0"
                        class="header__cart-count inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-theme-text px-1 body-xs text-theme-bg"
                        x-text="$store.cart.item_count"
                    ></span>
                </a>

                {%- if shop.customer_accounts_enabled -%}
                    <shopify-account
                        menu="customer-account-main-menu"
                        class="inline-flex h-10 w-10 shrink-0 items-center justify-center"
                    >
                        <span slot="signed-out-avatar">
                            {%- render 'icons', icon: 'icon-account', class: size_class -%}
                        </span>
                    </shopify-account>
                {%- endif -%}

                {%- if section.settings.enable_country_selector -%}
                    <div class="max-pc:hidden">
                        {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
                    </div>
                {%- endif -%}

                {%- if section.settings.enable_language_selector -%}
                    <div class="max-pc:hidden">
                        {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
                    </div>
                {%- endif -%}
            </div>
        </div>
    </div>
</header>

{% stylesheet %}
    .site-header > header:has(.header-menu details.dropdown[open]) {
        box-shadow: 0 1px 10px rgba(0, 0, 0, 0.06);
    }

    .header-section {
        .header__cols {
            grid-template-areas: 'mobile-menu logo navigation';
            grid-template-columns: auto minmax(0, 1fr) auto;
            align-items: center;
            column-gap: 1rem;
        }

        .header-logo {
            min-width: 0;
        }

        .header-logo > * {
            min-width: 0;
            max-width: 100%;
        }

        .header-logo > .theme-image {
            width: var(--header-logo-width);
        }

        .header-logo .header-logo__text {
            display: block;
            width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .header-navigation {
            min-width: max-content;
        }

        @media (min-width: 48rem) {
            .header__cols {
                grid-template-areas: 'logo menu navigation';
                grid-template-columns: repeat(3, minmax(0, 1fr));
                column-gap: 0;
            }
        }
    }

    .header__cart-count {
        position: absolute;
        top: 0.25rem;
        inset-inline-end: 0.25rem;
        transform: translate(50%, -50%);
        pointer-events: none;
    }
{% endstylesheet %}

{%- assign organization_social_setting_ids = 'social_twitter_link,social_facebook_link,social_pinterest_link,social_instagram_link,social_tiktok_link,social_tumblr_link,social_snapchat_link,social_youtube_link,social_vimeo_link'
    | split: ','
-%}
{%- capture organization_same_as -%}
    {%- assign organization_social_link_written = false -%}
    {%- for organization_social_setting_id in organization_social_setting_ids -%}
        {%- assign organization_social_url = settings[organization_social_setting_id] -%}
        {%- if organization_social_url != blank -%}
            {%- if organization_social_link_written -%},{%- endif -%}
            {{- organization_social_url | json -}}
            {%- assign organization_social_link_written = true -%}
        {%- endif -%}
    {%- endfor -%}
{%- endcapture -%}
{%- assign organization_same_as = organization_same_as | strip -%}

<script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      {% if settings.logo %}
        "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
      {% endif %}
      {% if organization_same_as != blank %}
        "sameAs": [{{ organization_same_as }}],
      {% endif %}
      "url": {{ request.origin | append: routes.root_url | json }}
    }
</script>

{%- if request.page_type == 'index' -%}
    {% assign potential_action_target = request.origin
        | append: routes.search_url
        | append: '?q={search_term_string}'
    %}
    <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": {{ shop.name | json }},
          "potentialAction": {
            "@type": "SearchAction",
            "target": {{ potential_action_target | json }},
            "query-input": "required name=search_term_string"
          },
          "url": {{ request.origin | append: page.url | json }}
        }
    </script>
{%- endif -%}

{% schema %}
{
    "name": "t:general.header",
    "tag": "section",
    "class": "section site-header",
    "limit": 1,
    "enabled_on": {
        "groups": ["header"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.header.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "link_list",
            "id": "menu",
            "label": "t:labels.menu",
            "default": "main-menu"
        },
        {
            "type": "header",
            "content": "t:sections.header.content.localization_settings"
        },
        {
            "type": "paragraph",
            "content": "t:sections.header.content.localization_large_screens_only"
        },
        {
            "type": "checkbox",
            "id": "enable_country_selector",
            "default": true,
            "label": "t:sections.header.settings.country_region_selector",
            "info": "t:sections.header.info.manage_countries_regions"
        },
        {
            "type": "checkbox",
            "id": "enable_language_selector",
            "default": true,
            "label": "t:sections.header.settings.language_selector",
            "info": "t:sections.header.info.manage_languages"
        }
    ]
}
{% endschema %}
