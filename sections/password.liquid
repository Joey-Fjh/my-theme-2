<div
    data-section-id="{{ section.id }}"
    class="section password color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <main id="MainContent" tabindex="-1">
        <h1 class="heading-2xl">{{ 'password.title' | t }}</h1>

        {%- if shop.password_message != blank -%}
            <div>{{ shop.password_message }}</div>
        {%- else -%}
            <div class="rte">{{ 'password.message_html' | t }}</div>
        {%- endif -%}

        {% form 'customer', data-shopify-captcha: 'true' %}
            <input type="hidden" name="contact[tags]" value="newsletter">

            {%- if form.posted_successfully? -%}
                <p role="status">{{ 'newsletter.success_message' | t }}</p>
            {%- elsif form.errors -%}
                <div role="alert">{{ form.errors | default_errors }}</div>
            {%- endif -%}

            <label class="sr-only" for="password-email-{{ section.id }}">
                {{ 'newsletter.email_address' | t }}
            </label>

            <div class="inline-submit-field">
                <input
                    class="inline-submit-field__input field"
                    type="email"
                    name="contact[email]"
                    id="password-email-{{ section.id }}"
                    placeholder="{{ 'password.email_placeholder' | t | escape }}"
                    autocomplete="email"
                    required
                >
                <button class="btn" type="submit">
                    {{ 'newsletter.subscribe' | t }}
                </button>
            </div>
        {% endform %}
    </main>
</div>

{% stylesheet %}
    /* The password page has no header or footer: its section fills the viewport. */
    .shopify-section:has(> .password) {
        display: flex;
        flex: 1;
    }

    .password {
        flex: 1;
    }

    .inline-submit-field {
        display: flex;
        gap: 0.5rem;
    }

    .inline-submit-field__input {
        flex: 1;
        min-width: 0;
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:general.password",
    "tag": "section",
    "limit": 1,
    "enabled_on": {
        "templates": ["password"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.password.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.password.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "t:sections.password.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "t:sections.password.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
