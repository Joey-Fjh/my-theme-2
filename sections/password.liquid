<main
    id="MainContent"
    class="password-section full-width color-{{ section.settings.color_scheme }} surface-section"
    tabindex="-1"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page h-full">
        <div class="mx-auto flex h-full w-full flex-col items-center justify-center py-16 text-center pc:max-w-1/2 pc:py-24">
            <h1 class="heading-2xl">
                {{ 'password.title' | t }}
            </h1>

            {%- if shop.password_message != blank -%}
                <div class="mt-5">
                    {{ shop.password_message }}
                </div>
            {%- else -%}
                <div class="rte rte--compact mt-5">
                    {{ 'password.message_html' | t }}
                </div>
            {%- endif -%}

            {% form 'customer', class: 'mt-8 w-full text-start', data-shopify-captcha: 'true' %}
                <input type="hidden" name="contact[tags]" value="newsletter">

                {%- if form.posted_successfully? -%}
                    <p
                        class="password-section__status mb-4 border border-theme-border px-4 py-3 body-md text-theme-text"
                        role="status"
                    >
                        {{ 'newsletter.success_message' | t }}
                    </p>
                {%- elsif form.errors -%}
                    <div
                        class="password-section__status mb-4 border border-theme-border px-4 py-3 body-md text-theme-text"
                        role="alert"
                    >
                        {{ form.errors | default_errors }}
                    </div>
                {%- endif -%}

                <label class="sr-only" for="password-email-{{ section.id }}">
                    {{ 'newsletter.email_address' | t }}
                </label>

                <div class="inline-submit-field">
                    <input
                        class="password-section__field inline-submit-field__input field"
                        type="email"
                        name="contact[email]"
                        id="password-email-{{ section.id }}"
                        placeholder="{{ 'password.email_placeholder' | t | escape }}"
                        autocomplete="email"
                        required
                    >

                    <button
                        class="password-section__submit inline-submit-field__button btn pc:min-w-40"
                        type="submit"
                    >
                        {{ 'newsletter.subscribe' | t }}
                    </button>
                </div>
            {% endform %}
        </div>
    </div>
</main>

{% stylesheet %}
    .shopify-section:has(.password-section) {
        display: flex;
        flex: 1;
    }

    .shopify-section:has(.password-section) > .password-section {
        flex: 1;
    }

    .password-section__status ul {
        list-style: disc;
        padding-inline-start: 1.25rem;
    }

    @media (width >= 48rem) {
        .password-section__field {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        .password-section__submit {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }
    }

    .inline-submit-field {
        display: grid;
        width: 100%;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: stretch;
        gap: 0;
    }

    .inline-submit-field__input {
        min-width: 0;
        border-start-end-radius: 0;
        border-end-end-radius: 0;
    }

    .inline-submit-field__input:focus-visible {
        position: relative;
        z-index: 1;
    }

    .inline-submit-field__button {
        flex-shrink: 0;
        border-start-start-radius: 0;
        border-end-start-radius: 0;
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:general.password",
    "tag": "section",
    "class": "section",
    "limit": 1,
    "enabled_on": {
        "templates": ["password"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.password.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.password.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "t:sections.password.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "t:sections.password.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
