<footer
    data-section-id="{{ section.id }}"
    class="footer-section full-width relative color-{{ section.settings.color_scheme }}"
>
    <div class="container-page">
        <div class="relative p-12">
            <div class="z-10 flex flex-col gap-12 pc:mb-12">
                <div
                    class="grid grid-cols-1 gap-x-4 gap-y-10 pc:grid-cols-3 pc:gap-20"
                >
                    {% for block in section.blocks %}
                        {% if block.type == 'link_column' %}
                            <div {{ block.shopify_attributes }}>
                                <h2 class="mb-6 heading-h2 pc:mb-10">
                                    {{ block.settings.heading }}
                                </h2>
                                <ul class="flex flex-col gap-3">
                                    {% assign links_menu = block.settings.menu %}
                                    {% if links_menu != blank and links_menu.links != blank %}
                                        {% for link in links_menu.links %}
                                            <li>
                                                {% render 'link',
                                                    text: link.title,
                                                    variant: 'underline',
                                                    href: link.url
                                                %}
                                            </li>
                                        {% endfor %}
                                    {% else %}
                                        {% for i in (1..4) %}
                                            <li>
                                                {%- assign link_text = 'footer.default_link'
                                                    | t: number: i
                                                -%}
                                                <span class="links-underline links">
                                                    {{ link_text }}
                                                </span>
                                            </li>
                                        {% endfor %}
                                    {% endif %}
                                </ul>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>

                {% if section.settings.enable_follow_on_shop and shop.features.follow_on_shop? %}
                    <div class="flex flex-col gap-3">
                        <p>{{ 'footer.follow_on_shop' | t }}</p>
                        <div>
                            {{ shop | login_button: action: 'follow' }}
                        </div>
                    </div>
                {% endif %}
            </div>

            <div
                class="z-10 flex flex-col gap-4 border-t border-theme-border/50 pt-6 pc:flex-row pc:items-center pc:justify-end"
            >
                <span class="text-start pc:text-end">
                    {{ 'now' | date: '%Y' }}
                    {{ shop.name | escape }}
                    {{ 'footer.all_rights_reserved' | t }}
                </span>
            </div>
        </div>
    </div>
</footer>

{% schema %}
{
    "name": "t:general.footer",
    "tag": "section",
    "class": "section footer",
    "limit": 1,
    "enabled_on": {
        "groups": ["footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.footer.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "header",
            "content": "t:sections.footer.content.follow_on_shop"
        },
        {
            "type": "checkbox",
            "id": "enable_follow_on_shop",
            "label": "t:sections.footer.settings.enable_follow_on_shop_button",
            "default": true
        }
    ],
    "blocks": [
        {
            "type": "link_column",
            "name": "t:sections.footer.blocks.link_column",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "heading",
                    "label": "t:sections.footer.block_settings.column_heading",
                    "default": "t:sections.footer.defaults.link_column_heading"
                },
                {
                    "type": "link_list",
                    "id": "menu",
                    "label": "t:sections.footer.block_settings.menu",
                    "default": "footer"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.footer.presets.footer",
            "blocks": [
                {
                    "type": "link_column"
                },
                {
                    "type": "link_column",
                    "settings": {
                        "heading": "Pages"
                    }
                },
                {
                    "type": "link_column",
                    "settings": {
                        "heading": "Social"
                    }
                }
            ]
        }
    ]
}
{% endschema %}
