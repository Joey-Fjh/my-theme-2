{%- liquid
    assign quote_text = section.settings.quote | strip
    assign author_name = section.settings.author_name | strip
    assign body_text = section.settings.body | strip
    assign author_role = section.settings.author_role | strip
    assign section_number = section.settings.section_number | strip
    assign kicker_text = section.settings.kicker | strip

    assign has_quote = false
    if quote_text != blank
        assign has_quote = true
    endif
    assign has_author_name = false
    if author_name != blank
        assign has_author_name = true
    endif
    assign has_required_content = false
    if has_quote and has_author_name
        assign has_required_content = true
    endif

    assign has_body = false
    if body_text != blank
        assign has_body = true
    endif
    assign has_author_role = false
    if author_role != blank
        assign has_author_role = true
    endif
    assign has_section_number = false
    if section_number != blank
        assign has_section_number = true
    endif
    assign has_kicker = false
    if kicker_text != blank
        assign has_kicker = true
    endif
    assign has_header = false
    if has_section_number or has_kicker
        assign has_header = true
    endif

    assign has_portrait = false
    if section.settings.portrait != blank
        assign has_portrait = true
    endif

    assign portrait_alt = section.settings.portrait.alt | strip | escape
-%}

{%- if has_required_content or request.design_mode -%}
    <section
        data-section-id="{{ section.id }}"
        class="section endorsement color-{{ section.settings.color_scheme }}"
        style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
        {% if has_header and has_required_content %}
            aria-labelledby="EndorsementHeading-{{ section.id }}"
        {% else %}
            aria-label="{{ 'sections.optician-endorsement.accessibility.region' | t }}"
        {% endif %}
    >
        <div class="endorsement__frame">
            {%- if has_required_content -%}
                <div class="endorsement__panel{% unless has_portrait %} endorsement__panel--text-only{% endunless %}">
                    {%- if has_portrait -%}
                        <div class="endorsement__media">
                            {% render 'image',
                                image: section.settings.portrait,
                                aspect_ratio: 'portrait',
                                mode: 'frame',
                                fit: 'cover',
                                loading: 'lazy',
                                alt: portrait_alt,
                                widths: '360,540,720,960',
                                sizes: '(min-width: 1024px) 34vw, 94vw',
                                wrapper_class: 'endorsement__image'
                            %}
                        </div>
                    {%- endif -%}

                    <div class="endorsement__content">
                        {%- if has_header -%}
                            <h2
                                id="EndorsementHeading-{{ section.id }}"
                                class="endorsement__kicker"
                            >
                                {%- if has_section_number -%}
                                    <span class="endorsement__num">
                                        {{- section_number | escape -}}
                                    </span>
                                {%- endif -%}
                                {%- if has_section_number and has_kicker -%}
                                    <span class="endorsement__slash" aria-hidden="true">/</span>
                                {%- endif -%}
                                {%- if has_kicker -%}
                                    <span>{{ kicker_text | escape }}</span>
                                {%- endif -%}
                            </h2>
                        {%- endif -%}

                        <figure class="endorsement__figure">
                            <blockquote class="endorsement__quote">
                                <p class="endorsement__quote-lead">
                                    {{-
                                        'sections.optician-endorsement.quote_format'
                                        | t: quote: quote_text
                                        | escape
                                    -}}
                                </p>
                            </blockquote>

                            {%- if has_body -%}
                                <p class="endorsement__quote-body">
                                    {{- body_text | escape | newline_to_br -}}
                                </p>
                            {%- endif -%}

                            <figcaption class="endorsement__attribution">
                                <span class="endorsement__author">
                                    {{-
                                        'sections.optician-endorsement.attribution_prefix'
                                        | t: author: author_name
                                        | escape
                                    -}}
                                </span>
                                {%- if has_author_role -%}
                                    <span class="endorsement__role">
                                        {{- author_role | escape -}}
                                    </span>
                                {%- endif -%}
                            </figcaption>
                        </figure>
                    </div>
                </div>
            {%- else -%}
                <div class="endorsement__empty">
                    <p class="endorsement__empty-text copy-s">
                        {{- 'sections.optician-endorsement.placeholders.empty' | t -}}
                    </p>
                </div>
            {%- endif -%}
        </div>
    </section>
{%- endif -%}

{% stylesheet %}
    .endorsement__frame {
        --endorsement-line-color: var(--color-line);
        container-type: inline-size;
        container-name: endorsement-frame;
        position: relative;
    }

    .endorsement__panel {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--endorsement-line-color);
        border-radius: 1.6rem;
        background-color: var(--color-surface-muted);
        display: grid;
        grid-template-columns: minmax(22rem, 34%) minmax(0, 1fr);
        align-items: center;
        gap: clamp(var(--spacing-step-l), 3cqi, var(--spacing-step-3xl));
    }

    .endorsement__panel::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: radial-gradient(
            circle at 92% 96%,
            rgb(var(--color-accent-background)) 0%,
            transparent 66%
        );
        opacity: 0.2;
        pointer-events: none;
        z-index: 0;
    }

    .endorsement__panel--text-only {
        grid-template-columns: minmax(0, 1fr);
    }

    .endorsement__media {
        position: relative;
        z-index: 1;
        align-self: stretch;
        min-width: 0;
        overflow: hidden;
    }

    .endorsement__image {
        width: 100%;
        height: 100%;
    }

    .endorsement__content {
        position: relative;
        z-index: 1;
        padding-block: clamp(var(--spacing-step-xl), 3.4cqi, var(--spacing-step-3xl));
        padding-inline-end: clamp(var(--spacing-step-l), 3.4cqi, var(--spacing-step-3xl));
        padding-inline-start: 0;
        min-width: 0;
    }

    .endorsement__panel--text-only .endorsement__content {
        padding-inline: clamp(var(--spacing-step-l), 4cqi, var(--spacing-step-4xl));
    }

    .endorsement__kicker {
        display: inline-flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.45em;
        margin-block-end: var(--spacing-step-m);
        font-family: var(--font-mono-family);
        font-size: calc(var(--type-step--2) * var(--font-body-scale));
        font-weight: var(--font-heading-weight);
        line-height: var(--font-heading-line-height);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-subtle);
    }

    .endorsement__num {
        white-space: nowrap;
        flex-shrink: 0;
    }

    .endorsement__slash {
        font-weight: var(--font-body-weight);
        flex-shrink: 0;
    }

    .endorsement__figure {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-step-m);
        min-width: 0;
    }

    .endorsement__quote {
        min-width: 0;
    }

    .endorsement__quote-lead {
        --font-endorsement-quote-size: clamp(
            calc(var(--font-heading-scale) * var(--font-heading-floor-1)),
            calc(var(--font-heading-scale) * 2.8cqi),
            calc(var(--font-heading-scale) * var(--type-step-4))
        );
        font-family: var(--font-heading-family);
        font-style: italic;
        font-weight: var(--font-heading-light-weight);
        font-size: var(--font-endorsement-quote-size);
        line-height: var(--font-heading-line-height);
        letter-spacing: var(--font-heading-letter-spacing);
        text-transform: uppercase;
        color: rgb(var(--color-foreground));
        overflow-wrap: break-word;
    }

    .endorsement__quote-body {
        max-width: 58ch;
        font-family: var(--font-body-family);
        font-size: calc(var(--type-step--1) * var(--font-body-scale));
        line-height: var(--font-body-line-height);
        color: rgb(var(--color-foreground));
        overflow-wrap: break-word;
    }

    .endorsement__attribution {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-step-3xs);
        margin-block-start: var(--spacing-step-xs);
        font-family: var(--font-mono-family);
        font-size: calc(var(--type-step--2) * var(--font-body-scale));
        font-weight: var(--font-heading-weight);
        line-height: var(--font-heading-line-height);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-subtle);
        min-width: 0;
    }

    .endorsement__author {
        color: rgb(var(--color-foreground));
        overflow-wrap: break-word;
    }

    .endorsement__role {
        font-weight: var(--font-body-weight);
        overflow-wrap: break-word;
    }

    .endorsement__empty {
        border: 1px dashed var(--color-line-strong);
        border-radius: 1.6rem;
        background-color: var(--color-surface-muted);
        padding: var(--spacing-step-xl);
        text-align: center;
    }

    .endorsement__empty-text {
        color: var(--color-subtle);
    }

    @container endorsement-frame (max-width: 50rem) {
        .endorsement__panel {
            grid-template-columns: minmax(0, 1fr);
            gap: 0;
        }

        .endorsement__content,
        .endorsement__panel--text-only .endorsement__content {
            padding-block: var(--spacing-step-l) var(--spacing-step-xl);
            padding-inline: var(--spacing-step-m);
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.optician-endorsement.name",
    "tag": "section",
    "class": "section-optician-endorsement",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.optician-endorsement.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "header",
            "content": "t:sections.optician-endorsement.content.header"
        },
        {
            "type": "text",
            "id": "section_number",
            "label": "t:sections.optician-endorsement.settings.section_number"
        },
        {
            "type": "text",
            "id": "kicker",
            "label": "t:sections.optician-endorsement.settings.kicker"
        },
        {
            "type": "header",
            "content": "t:sections.optician-endorsement.content.quote"
        },
        {
            "type": "textarea",
            "id": "quote",
            "label": "t:sections.optician-endorsement.settings.quote"
        },
        {
            "type": "textarea",
            "id": "body",
            "label": "t:sections.optician-endorsement.settings.body"
        },
        {
            "type": "text",
            "id": "author_name",
            "label": "t:sections.optician-endorsement.settings.author_name"
        },
        {
            "type": "text",
            "id": "author_role",
            "label": "t:sections.optician-endorsement.settings.author_role"
        },
        {
            "type": "header",
            "content": "t:sections.optician-endorsement.content.media"
        },
        {
            "type": "image_picker",
            "id": "portrait",
            "label": "t:sections.optician-endorsement.settings.portrait"
        },
        {
            "type": "header",
            "content": "t:sections.optician-endorsement.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.optician-endorsement.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.optician-endorsement.settings.padding_bottom",
            "default": 32
        }
    ],
    "presets": [
        {
            "name": "t:sections.optician-endorsement.presets.optician_endorsement"
        }
    ]
}
{% endschema %}
