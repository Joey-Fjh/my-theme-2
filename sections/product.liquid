{% assign desktop_media_width = section.settings.desktop_media_width | default: 60 | plus: 0 %}
{% assign desktop_info_width = 100 | minus: desktop_media_width %}
{% assign media_aspect_ratio = section.settings.media_aspect_ratio | default: 'portrait_3_4' %}
{% assign gallery_aspect_ratio = '3/4' %}
{% case media_aspect_ratio %}
    {% when 'square_1_1' %}
        {% assign gallery_aspect_ratio = '1/1' %}
{% endcase %}
{% assign product_form_id = 'product-form-' | append: section.id %}
{% assign purchase_anchor_type = '' %}
{% for candidate_block in section.blocks %}
    {% if candidate_block.type == 'quantity_selector' %}
        {% assign quantity_block = candidate_block %}
        {% if purchase_anchor_type == blank %}
            {% assign purchase_anchor_type = 'quantity_selector' %}
        {% endif %}
    {% elsif candidate_block.type == 'buy_buttons' %}
        {% assign buy_buttons_block = candidate_block %}
        {% if purchase_anchor_type == blank %}
            {% assign purchase_anchor_type = 'buy_buttons' %}
        {% endif %}
    {% endif %}
{% endfor %}

<div
    data-section-id="{{ section.id }}"
    class="product-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top | default: 0 }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    "
    x-data="productLayout"
    data-module-id="product-layout"
>
    <div class="layout container-page overflow-visible!">
        <div
            class="grid w-full min-w-0 grid-cols-1 items-start gap-8 pc:grid-cols-[minmax(0,var(--product-media-fr))_minmax(0,var(--product-info-fr))] pc:items-stretch pc:gap-10 fw:gap-12"
            style="
                --product-media-fr: {{ desktop_media_width }}fr;
                --product-info-fr: {{ desktop_info_width }}fr;
            "
        >
            <div
                class="min-w-0"
                data-product-media-column
            >
                <div
                    class="flex w-full min-w-0 flex-col gap-8"
                    data-product-media-sticky-target
                >
                    <div
                        class="min-w-0 overflow-hidden"
                        data-product-media-panel
                    >
                        {%- assign id = 'product-gallery-' | append: section.id -%}
                        {%- render 'product-gallery',
                            media: product.media,
                            id: id,
                            aspect_ratio: gallery_aspect_ratio
                        -%}
                    </div>
                </div>
            </div>

            <div class="min-w-0" data-product-info-panel>
                <div
                    class="self-start px-6 py-4 pc:px-10 pc:py-6"
                    data-product-info-sticky-target
                >
                    <div
                        class="product-info-blocks product-info-blocks--product product-info-blocks--form flex flex-col gap-6"
                        id="ProductInfo-{{ section.id }}-form"
                    >
                        {%- for block in section.blocks -%}
                            {%- case block.type -%}
                                {%- when '@app' -%}
                                    <div {{ block.shopify_attributes }}>
                                        {%- render block -%}
                                    </div>
                                {%- when 'vendor' -%}
                                    {%- if product.vendor != blank -%}
                                        <div
                                            class="product-info-blocks__vendor"
                                            {{ block.shopify_attributes }}
                                        >
                                            {{ product.vendor }}
                                        </div>
                                    {%- endif -%}
                                {%- when 'title' -%}
                                    {%- liquid
                                        assign product_title_heading_class = block.settings.heading_size | default: 'heading-h1'
                                    -%}
                                    <div {{ block.shopify_attributes }}>
                                        <h1 class="product-info-blocks__title {{ product_title_heading_class }}">
                                            {{ product.title }}
                                        </h1>
                                    </div>
                                {%- when 'price' -%}
                                    {%- assign current_variant = product.selected_or_first_available_variant -%}
                                    <div {{ block.shopify_attributes }}>
                                        <p class="product-info-blocks__price body-3xl text-theme-text">
                                            {{ current_variant.price | money }}
                                        </p>
                                        {%- render 'product-tax-note',
                                            class: 'mt-2 body-sm text-theme-text/80'
                                        -%}
                                    </div>
                                {%- when 'description' -%}
                                    {%- if product.description != blank -%}
                                        <div
                                            class="product-info-blocks__description rte"
                                            {{ block.shopify_attributes }}
                                        >
                                            {{ product.description }}
                                        </div>
                                    {%- endif -%}
                                {%- when 'custom_liquid' -%}
                                    <div {{ block.shopify_attributes }}>
                                        {{ block.settings.custom_liquid }}
                                    </div>
                                {%- when 'variant_picker' -%}
                                    {%- render 'product-variant-picker',
                                        product: product,
                                        block: block,
                                        product_form_id: product_form_id,
                                        section_id: section.id,
                                        context: 'product',
                                        gallery_id: id,
                                        update_url: true
                                    -%}
                                {%- when 'quantity_selector' -%}
                                    {%- if purchase_anchor_type == 'quantity_selector' -%}
                                        {%- if buy_buttons_block != blank -%}
                                            {%- render 'buy-buttons',
                                                product: product,
                                                block: buy_buttons_block,
                                                product_form_id: product_form_id,
                                                section_id: section.id,
                                                context: 'product',
                                                quantity_block: quantity_block,
                                                cart_type: settings.cart_type
                                            -%}
                                        {%- else -%}
                                            {%- render 'quantity-selector',
                                                variant: product.selected_or_first_available_variant,
                                                surface: 'product',
                                                product_form_id: product_form_id,
                                                section_id: section.id
                                            -%}
                                        {%- endif -%}
                                    {%- endif -%}
                                {%- when 'buy_buttons' -%}
                                    {%- if purchase_anchor_type == 'buy_buttons' -%}
                                        {%- render 'buy-buttons',
                                            product: product,
                                            block: block,
                                            product_form_id: product_form_id,
                                            section_id: section.id,
                                            context: 'product',
                                            quantity_block: quantity_block,
                                            cart_type: settings.cart_type
                                        -%}
                                    {%- endif -%}
                                {%- when 'inventory_notice' -%}
                                    {%- liquid
                                        assign inventory_variant = product.selected_or_first_available_variant
                                        assign low_stock_threshold = block.settings.low_stock_threshold | default: 5 | plus: 0
                                        assign inventory_quantity = inventory_variant.inventory_quantity | default: 0 | plus: 0
                                        assign show_inventory_notice = false
                                        if inventory_variant.inventory_management != blank and inventory_variant.inventory_policy == 'deny' and inventory_quantity > 0 and inventory_quantity <= low_stock_threshold
                                            assign show_inventory_notice = true
                                        endif
                                    -%}
                                    {%- if show_inventory_notice -%}
                                        <div
                                            class="product-info-blocks__inventory-notice"
                                            {{ block.shopify_attributes }}
                                        >
                                            {%- if block.settings.show_stock_number -%}
                                                {{
                                                    'products.product.only_in_stock_html'
                                                    | t: quantity: inventory_quantity
                                                }}
                                            {%- else -%}
                                                {{ 'products.product.low_stock' | t }}
                                            {%- endif -%}
                                        </div>
                                    {%- endif -%}
                                {%- when 'collapsible_tab' -%}
                                    {%- capture collapsible_content -%}
                                        <div class="rte">{{ block.settings.collapsible_tab_text }}</div>
                                    {%- endcapture -%}
                                    {%- render 'accordion',
                                        item_title: block.settings.collapsible_tab_heading,
                                        item_content: collapsible_content,
                                        initial_active: block.settings.open_by_default,
                                        id_prefix: block.id,
                                        icon_type: 'plus'
                                    -%}
                                {%- else -%}
                                    {%- comment -%}
                                        Block types kept in the schema for merchant JSON compatibility but
                                        not rendered by this minimal composition. Shown only in the theme
                                        editor so the block stays selectable and removable; the storefront
                                        renders nothing, avoiding an empty flex child that would add a gap.
                                    {%- endcomment -%}
                                    {%- if request.design_mode -%}
                                        <div {{ block.shopify_attributes }}></div>
                                    {%- endif -%}
                            {%- endcase -%}
                        {%- endfor -%}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% stylesheet %}
    .product-info-blocks {
        --product-block-row-gap: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: var(--product-block-row-gap);
    }

    @media (width >= 48rem) {
        .product-info-blocks {
            max-height: 100%;
            min-height: 0;
            overflow: hidden;
        }

        .product-info-blocks > * {
            flex-shrink: 0;
        }
    }

    @media (width >= 48rem) {
        .product-info-blocks {
            --product-block-row-gap: 1.5rem;
        }
    }

    .product-info-blocks__title {
        min-width: 0;
        color: rgb(var(--color-foreground) / 0.8);
    }

    .product-info-blocks__vendor {
        letter-spacing: 0.04em;
    }

    .product-info-blocks--product .product-info-blocks__vendor {
        font-family: var(--font-body-family);
        font-style: var(--font-body-style);
        line-height: var(--font-body-line-height);
        letter-spacing: var(--font-body-letter-spacing);
        text-transform: var(--font-body-text-transform);
        word-break: break-word;
        font-size: calc(var(--font-body-size-mobile) * var(--font-body-scale));
        color: rgb(var(--color-foreground));
    }

    @media (width >= 48rem) {
        .product-info-blocks--product .product-info-blocks__vendor {
            font-size: calc(var(--font-body-size) * var(--font-body-scale) * 1.125);
        }
    }

    .product-info-blocks__description {
        max-width: none;
        overscroll-behavior: contain;
        padding-right: 0.25rem;
        color: rgb(var(--color-foreground) / 0.8);
    }

    @media (width >= 48rem) {
        .product-info-blocks__description {
            overflow-y: auto;
        }
    }

    .product-info-blocks__description {
        scrollbar-width: thin;
        scrollbar-color: rgb(var(--color-foreground) / 0.35) transparent;
    }

    .product-info-blocks__description::-webkit-scrollbar {
        width: 0.375rem;
    }

    .product-info-blocks__description::-webkit-scrollbar-track {
        background: transparent;
    }

    .product-info-blocks__description::-webkit-scrollbar-thumb {
        border-radius: 999px;
        background-color: rgb(var(--color-foreground) / 0.35);
    }

    .product-info-blocks__description[data-product-description-scrollable] {
        scrollbar-gutter: stable;
    }

    .product-info-blocks__description.rte :is(h1, h2, h3, h4, h5, h6) {
        color: rgb(var(--color-foreground) / 0.8);
    }

    .product-info-blocks__inventory-notice {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .product-info-blocks--product > * {
        width: 100%;
    }

    .product-info-blocks--product .product-info-blocks__description {
        max-width: 46ch;
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:general.product",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["product"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.product.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "select",
            "id": "gallery_layout",
            "label": "t:sections.product.settings.image_layout",
            "options": [
                {
                    "value": "thumbnails",
                    "label": "t:sections.product.options.thumbnails"
                },
                {
                    "value": "carousel",
                    "label": "t:sections.product.options.carousel"
                },
                {
                    "value": "stacked",
                    "label": "t:sections.product.options.stacked"
                },
                {
                    "value": "grid",
                    "label": "t:sections.product.options.grid"
                }
            ],
            "default": "thumbnails"
        },
        {
            "type": "select",
            "id": "thumbnail_position",
            "label": "t:sections.product.settings.thumbnail_position",
            "options": [
                {
                    "value": "left",
                    "label": "t:sections.product.options.left"
                },
                {
                    "value": "bottom",
                    "label": "t:sections.product.options.bottom"
                }
            ],
            "default": "left",
            "info": "t:sections.product.info.applies_when_image_layout_is_set_to_thum"
        },
        {
            "type": "range",
            "id": "desktop_media_width",
            "min": 40,
            "max": 60,
            "step": 1,
            "unit": "%",
            "label": "t:sections.product.settings.desktop_media_width",
            "default": 60
        },
        {
            "type": "select",
            "id": "media_aspect_ratio",
            "label": "t:sections.product.settings.media_aspect_ratio",
            "options": [
                {
                    "value": "portrait_3_4",
                    "label": "t:sections.product.options.portrait_3_4"
                },
                {
                    "value": "square_1_1",
                    "label": "t:sections.product.options.square_1_1"
                }
            ],
            "default": "portrait_3_4"
        },
        {
            "type": "select",
            "id": "desktop_media_height",
            "label": "t:sections.product.settings.desktop_media_height",
            "options": [
                {
                    "value": "original",
                    "label": "t:sections.product.options.original"
                },
                {
                    "value": "compact",
                    "label": "t:sections.product.options.compact"
                },
                {
                    "value": "balanced",
                    "label": "t:sections.product.options.balanced"
                },
                {
                    "value": "full_screen",
                    "label": "t:sections.product.options.full_screen"
                }
            ],
            "default": "balanced",
            "info": "t:sections.product.info.controls_desktop_gallery_height"
        },
        {
            "type": "select",
            "id": "thumbnail_size",
            "label": "t:sections.product.settings.thumbnail_size",
            "options": [
                {
                    "value": "compact",
                    "label": "t:sections.product.options.compact"
                },
                {
                    "value": "standard",
                    "label": "t:sections.product.options.standard"
                },
                {
                    "value": "large",
                    "label": "t:sections.product.options.large"
                }
            ],
            "default": "standard",
            "info": "t:sections.product.info.thumbnail_size"
        },
        {
            "type": "range",
            "id": "magnifier_preview_size",
            "min": 240,
            "max": 520,
            "step": 20,
            "unit": "px",
            "label": "t:sections.product.settings.magnifier_preview_size",
            "default": 360
        },
        {
            "type": "color",
            "id": "zoom_overlay_color",
            "label": "t:sections.product.settings.zoom_overlay_color",
            "default": "#000000"
        },
        {
            "type": "range",
            "id": "zoom_overlay_opacity",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "%",
            "label": "t:sections.product.settings.zoom_overlay_opacity",
            "default": 90
        },
        {
            "type": "header",
            "content": "t:sections.product.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.product.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.product.settings.padding_bottom",
            "default": 32
        }
    ],
    "blocks": [
        {
            "type": "@app"
        },
        {
            "type": "title",
            "name": "t:sections.product.blocks.title",
            "limit": 1,
            "settings": [
                {
                    "type": "header",
                    "content": "t:sections.shared_typography.content.heading"
                },
                {
                    "type": "select",
                    "id": "heading_size",
                    "label": "t:sections.shared_typography.settings.heading_size",
                    "options": [
                        {
                            "value": "heading-4xl",
                            "label": "t:sections.shared_typography.options.heading_4xl"
                        },
                        {
                            "value": "heading-3xl",
                            "label": "t:sections.shared_typography.options.heading_3xl"
                        },
                        {
                            "value": "heading-2xl",
                            "label": "t:sections.shared_typography.options.heading_2xl"
                        },
                        {
                            "value": "heading-xl",
                            "label": "t:sections.shared_typography.options.heading_xl"
                        },
                        {
                            "value": "heading-h1",
                            "label": "t:sections.shared_typography.options.heading_h1"
                        },
                        {
                            "value": "heading-h2",
                            "label": "t:sections.shared_typography.options.heading_h2"
                        },
                        {
                            "value": "heading-h3",
                            "label": "t:sections.shared_typography.options.heading_h3"
                        },
                        {
                            "value": "heading-h4",
                            "label": "t:sections.shared_typography.options.heading_h4"
                        },
                        {
                            "value": "heading-h5",
                            "label": "t:sections.shared_typography.options.heading_h5"
                        },
                        {
                            "value": "heading-h6",
                            "label": "t:sections.shared_typography.options.heading_h6"
                        }
                    ],
                    "default": "heading-h1"
                }
            ]
        },
        {
            "type": "vendor",
            "name": "t:sections.product.blocks.vendor",
            "limit": 1
        },
        {
            "type": "price",
            "name": "t:sections.product.blocks.price",
            "limit": 1
        },
        {
            "type": "description",
            "name": "t:sections.product.blocks.description",
            "limit": 1,
            "settings": [
                {
                    "type": "select",
                    "id": "position_desktop",
                    "label": "t:sections.product.block_settings.position_desktop",
                    "options": [
                        {
                            "value": "form",
                            "label": "t:sections.product.options.form_column"
                        },
                        {
                            "value": "gallery",
                            "label": "t:sections.product.options.gallery_column"
                        }
                    ],
                    "default": "form"
                }
            ]
        },
        {
            "type": "variant_picker",
            "name": "t:sections.product.blocks.variant_picker",
            "limit": 1,
            "settings": [
                {
                    "type": "select",
                    "id": "picker_type",
                    "label": "t:sections.product.block_settings.style",
                    "options": [
                        {
                            "value": "dropdown",
                            "label": "t:sections.product.options.dropdown"
                        },
                        {
                            "value": "button",
                            "label": "t:sections.product.options.pills"
                        }
                    ],
                    "default": "button"
                },
                {
                    "type": "select",
                    "id": "swatch_shape",
                    "label": "t:sections.product.block_settings.swatch_shape",
                    "options": [
                        {
                            "value": "circle",
                            "label": "t:sections.product.options.circle"
                        },
                        {
                            "value": "square",
                            "label": "t:sections.product.options.square"
                        },
                        {
                            "value": "none",
                            "label": "t:sections.product.options.none"
                        }
                    ],
                    "default": "circle"
                }
            ]
        },
        {
            "type": "quantity_selector",
            "name": "t:sections.product.blocks.quantity_selector",
            "limit": 1
        },
        {
            "type": "inventory_notice",
            "name": "t:sections.product.blocks.inventory_notice",
            "limit": 1,
            "settings": [
                {
                    "type": "range",
                    "id": "low_stock_threshold",
                    "min": 1,
                    "max": 50,
                    "step": 1,
                    "label": "t:sections.product.block_settings.low_stock_threshold",
                    "info": "t:sections.product.block_info.the_low_stock_notice_displays_if_your_in",
                    "default": 5
                },
                {
                    "type": "select",
                    "id": "alignment",
                    "label": "t:sections.product.block_settings.alignment",
                    "options": [
                        {
                            "value": "left",
                            "label": "t:sections.product.options.left"
                        },
                        {
                            "value": "center",
                            "label": "t:sections.product.options.center"
                        },
                        {
                            "value": "right",
                            "label": "t:sections.product.options.right"
                        }
                    ],
                    "default": "left"
                },
                {
                    "type": "checkbox",
                    "id": "show_stock_number",
                    "label": "t:sections.product.block_settings.display_stock_number",
                    "default": true
                }
            ]
        },
        {
            "type": "buy_buttons",
            "name": "t:sections.product.blocks.buy_buttons",
            "limit": 1,
            "settings": [
                {
                    "type": "checkbox",
                    "id": "show_dynamic_checkout",
                    "label": "t:sections.product.block_settings.show_dynamic_checkout_buttons",
                    "info": "t:sections.product.block_info.using_the_payment_methods_available_on_y",
                    "default": true
                }
            ]
        },
        {
            "type": "custom_liquid",
            "name": "t:sections.product.blocks.custom_liquid",
            "settings": [
                {
                    "type": "liquid",
                    "id": "custom_liquid",
                    "label": "t:sections.product.block_settings.custom_liquid"
                }
            ]
        },
        {
            "type": "collapsible_tab",
            "name": "t:sections.product.blocks.collapsible_tab",
            "settings": [
                {
                    "type": "select",
                    "id": "collapsible_tab_position_desktop",
                    "label": "t:sections.product.block_settings.position_desktop",
                    "options": [
                        {
                            "value": "form",
                            "label": "t:sections.product.options.form_column"
                        },
                        {
                            "value": "gallery",
                            "label": "t:sections.product.options.gallery_column"
                        }
                    ],
                    "default": "form"
                },
                {
                    "type": "checkbox",
                    "id": "open_by_default",
                    "label": "t:sections.product.block_settings.open_tab_by_default",
                    "default": false
                },
                {
                    "type": "inline_richtext",
                    "id": "collapsible_tab_heading",
                    "label": "t:sections.product.block_settings.heading",
                    "default": "t:sections.product.blocks_defaults.collapsible_tab_heading"
                },
                {
                    "type": "select",
                    "id": "collapsible_tab_icon",
                    "label": "t:sections.product.block_settings.icon",
                    "options": [
                        {
                            "value": "none",
                            "label": "t:sections.product.options.none"
                        },
                        {
                            "value": "icon-content-package",
                            "label": "t:sections.product.options.package",
                            "group": "t:sections.product.option_groups.commerce_and_delivery"
                        },
                        {
                            "value": "icon-content-truck",
                            "label": "t:sections.product.options.truck",
                            "group": "t:sections.product.option_groups.commerce_and_delivery"
                        },
                        {
                            "value": "icon-content-airplane",
                            "label": "t:sections.product.options.airplane",
                            "group": "t:sections.product.option_groups.commerce_and_delivery"
                        },
                        {
                            "value": "icon-content-gift",
                            "label": "t:sections.product.options.gift",
                            "group": "t:sections.product.option_groups.commerce_and_delivery"
                        },
                        {
                            "value": "icon-content-tag",
                            "label": "t:sections.product.options.tag",
                            "group": "t:sections.product.option_groups.commerce_and_delivery"
                        },
                        {
                            "value": "icon-content-currency-circle-dollar",
                            "label": "t:sections.product.options.currency",
