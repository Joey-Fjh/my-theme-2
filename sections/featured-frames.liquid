{%- liquid
    assign section_number_val = section.settings.section_number | strip | escape
    assign heading_val = section.settings.heading | strip | escape
    assign note_val = section.settings.note | strip | escape

    assign has_section_number = false
    if section_number_val != blank
        assign has_section_number = true
    endif
    assign has_heading = false
    if heading_val != blank
        assign has_heading = true
    endif
    assign has_note = false
    if note_val != blank
        assign has_note = true
    endif
    assign has_header = false
    if has_section_number or has_heading or has_note
        assign has_header = true
    endif

    assign selected_products = section.settings.products
    assign valid_product_count = 0
    if selected_products != blank
        for product_item in selected_products limit: 3
            if product_item != blank
                assign valid_product_count = valid_product_count | plus: 1
            endif
        endfor
    endif

    assign details_text = section.settings.details_label | strip
    if details_text == blank
        assign details_text = 'sections.featured-frames.labels.view_details' | t
    endif
-%}

<section
    data-section-id="{{ section.id }}"
    class="section featured-frames color-{{ section.settings.color_scheme }}"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
    {% if has_heading %}
        aria-labelledby="FeaturedFramesHeading-{{ section.id }}"
    {% else %}
        aria-label="{{ 'sections.featured-frames.accessibility.region' | t }}"
    {% endif %}
>
    <div class="featured-frames__frame">
        {%- if has_header -%}
            <div class="featured-frames__head">
                {%- if has_section_number or has_heading -%}
                    <h2
                        id="FeaturedFramesHeading-{{ section.id }}"
                        class="featured-frames__title"
                    >
                        {%- if has_section_number -%}
                            <span class="featured-frames__num">
                                {{- section_number_val -}}
                            </span>
                        {%- endif -%}
                        {%- if has_section_number and has_heading -%}
                            <span class="featured-frames__slash" aria-hidden="true">/</span>
                        {%- endif -%}
                        {%- if has_heading -%}
                            <span>{{ heading_val }}</span>
                        {%- endif -%}
                    </h2>
                {%- endif -%}

                {%- if has_note -%}
                    <p class="featured-frames__note">
                        {{- note_val -}}
                    </p>
                {%- endif -%}
            </div>
        {%- endif -%}

        <ul class="featured-frames__grid" role="list">
            {%- if valid_product_count > 0 -%}
                {%- for product_item in selected_products limit: 3 -%}
                    {%- if product_item != blank -%}
                        {%- liquid
                            assign card_alt = product_item.featured_image.alt | default: product_item.title | escape
                            assign card_link_aria = 'sections.featured-frames.accessibility.view_product' | t: label: details_text, title: product_item.title
                            assign ph_key = 'product-' | append: forloop.index
                            assign product_sub = product_item.type | strip
                        -%}
                        <li class="featured-frames__item">
                            <article class="featured-frames__card">
                                <div class="featured-frames__media">
                                    {%- if product_item.featured_image != blank -%}
                                        {% render 'image',
                                            image: product_item.featured_image,
                                            aspect_ratio: 'landscape',
                                            mode: 'frame',
                                            fit: 'contain',
                                            loading: 'lazy',
                                            alt: card_alt,
                                            widths: '360,540,720,960,1200',
                                            sizes: '(min-width: 1024px) 32vw, (min-width: 640px) 48vw, 94vw',
                                            wrapper_class: 'featured-frames__image'
                                        %}
                                    {%- else -%}
                                        {% render 'image',
                                            aspect_ratio: 'landscape',
                                            mode: 'frame',
                                            placeholder_key: ph_key,
                                            placeholder_style: 'framed',
                                            wrapper_class: 'featured-frames__image'
                                        %}
                                    {%- endif -%}
                                </div>

                                <div class="featured-frames__body">
                                    <div class="featured-frames__meta">
                                        <div class="featured-frames__title-group">
                                            <h3 class="featured-frames__card-title">
                                                {{- product_item.title | escape -}}
                                            </h3>
                                            {%- if product_sub != blank -%}
                                                <p class="featured-frames__card-sub">
                                                    {{- product_sub | escape -}}
                                                </p>
                                            {%- endif -%}
                                        </div>
                                        <p class="featured-frames__price">
                                            {{- product_item.price | money -}}
                                        </p>
                                    </div>

                                    {%- if product_item.url != blank -%}
                                        <div class="featured-frames__footer">
                                            <a
                                                class="featured-frames__link"
                                                href="{{ product_item.url }}"
                                                aria-label="{{ card_link_aria }}"
                                            >
                                                <span>{{ details_text | escape }}</span>
                                                {% render 'icons',
                                                    icon: 'icon-chevron-right',
                                                    size: 'xs'
                                                %}
                                            </a>
                                        </div>
                                    {%- endif -%}
                                </div>
                            </article>
                        </li>
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}

            {%- if valid_product_count < 3 -%}
                {%- assign next_card_slot = valid_product_count | plus: 1 -%}
                {%- for slot_i in (next_card_slot..3) -%}
                    {%- liquid
                        assign ph_key = 'product-' | append: slot_i
                        case slot_i
                            when 1
                                assign p_title = 'sections.featured-frames.preview.card_1_title' | t
                                assign p_sub = 'sections.featured-frames.preview.card_1_subtitle' | t
                            when 2
                                assign p_title = 'sections.featured-frames.preview.card_2_title' | t
                                assign p_sub = 'sections.featured-frames.preview.card_2_subtitle' | t
                            else
                                assign p_title = 'sections.featured-frames.preview.card_3_title' | t
                                assign p_sub = 'sections.featured-frames.preview.card_3_subtitle' | t
                        endcase
                    -%}
                    <li class="featured-frames__item">
                        <article class="featured-frames__card">
                            <div class="featured-frames__media">
                                {% render 'image',
                                    aspect_ratio: 'landscape',
                                    mode: 'frame',
                                    placeholder_key: ph_key,
                                    placeholder_style: 'framed',
                                    wrapper_class: 'featured-frames__image'
                                %}
                            </div>

                            <div class="featured-frames__body">
                                <div class="featured-frames__meta">
                                    <div class="featured-frames__title-group">
                                        <h3 class="featured-frames__card-title">
                                            {{- p_title -}}
                                        </h3>
                                        <p class="featured-frames__card-sub">
                                            {{- p_sub -}}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </li>
                {%- endfor -%}
            {%- endif -%}
        </ul>
    </div>
</section>

{% stylesheet %}
    .featured-frames__frame {
        --featured-frames-line-color: var(--color-line);
        container-type: inline-size;
        container-name: featured-frames-frame;
        position: relative;
    }

    .featured-frames__head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--spacing-step-xs) var(--spacing-step-l);
        margin-block-end: var(--spacing-step-m);
    }

    .featured-frames__title {
        --font-featured-frames-title-size: clamp(
            calc(var(--font-heading-scale) * var(--font-heading-floor-1)),
            calc(var(--font-heading-scale) * 2.2cqi),
            calc(var(--font-heading-scale) * var(--type-step-2))
        );
        display: inline-flex;
        align-items: baseline;
        gap: 0.45em;
        font-family: var(--font-heading-family);
        font-weight: var(--font-heading-weight);
        font-size: var(--font-featured-frames-title-size);
        line-height: var(--font-heading-line-height);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: rgb(var(--color-foreground));
    }

    .featured-frames__num {
        font-family: var(--font-mono-family);
        font-weight: var(--font-heading-weight);
        white-space: nowrap;
        flex-shrink: 0;
    }

    .featured-frames__slash {
        font-weight: var(--font-heading-weight);
        color: rgb(var(--color-accent-background));
        flex-shrink: 0;
    }

    .featured-frames__note {
        font-family: var(--font-mono-family);
        font-size: calc(var(--type-step--2) * var(--font-body-scale));
        font-weight: var(--font-heading-weight);
        line-height: var(--font-heading-line-height);
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--color-subtle);
    }

    .featured-frames__grid {
        list-style: none;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--spacing-step-m);
    }

    .featured-frames__item {
        display: flex;
        min-width: 0;
    }

    .featured-frames__card {
        display: flex;
        flex-direction: column;
        width: 100%;
        min-width: 0;
        border: 1px solid var(--featured-frames-line-color);
        background-color: rgb(var(--color-background));
    }

    .featured-frames__media {
        padding: clamp(var(--spacing-step-m), 2cqi, var(--spacing-step-xl));
        background-color: var(--color-surface-muted);
        border-block-end: 1px solid var(--featured-frames-line-color);
    }

    .featured-frames__image {
        width: 100%;
    }

    .featured-frames__body {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        gap: var(--spacing-step-m);
        padding: clamp(var(--spacing-step-m), 1.8cqi, var(--spacing-step-l));
        min-width: 0;
    }

    .featured-frames__meta {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--spacing-step-s);
        min-width: 0;
    }

    .featured-frames__title-group {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-step-3xs);
        min-width: 0;
    }

    .featured-frames__card-title {
        font-family: var(--font-heading-family);
        font-weight: var(--font-heading-weight);
        font-size: calc(var(--type-step-0) * var(--font-body-scale));
        line-height: var(--font-heading-line-height);
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: rgb(var(--color-foreground));
        min-width: 0;
        overflow-wrap: break-word;
    }

    .featured-frames__card-sub {
        font-family: var(--font-body-family);
        font-style: italic;
        font-size: calc(var(--type-step--2) * var(--font-body-scale));
        line-height: var(--font-body-line-height);
        color: var(--color-subtle);
        overflow-wrap: break-word;
    }

    .featured-frames__price {
        font-family: var(--font-heading-family);
        font-weight: var(--font-heading-weight);
        font-size: calc(var(--type-step-0) * var(--font-body-scale));
        line-height: var(--font-heading-line-height);
        white-space: nowrap;
        flex-shrink: 0;
        color: rgb(var(--color-foreground));
    }

    .featured-frames__footer {
        margin-block-start: auto;
        padding-block-start: var(--spacing-step-xs);
        border-block-start: 1px solid var(--featured-frames-line-color);
        display: flex;
        justify-content: flex-end;
    }

    .featured-frames__link {
        display: inline-flex;
        align-items: center;
        gap: var(--spacing-step-2xs);
        min-height: 4.4rem;
        font-family: var(--font-mono-family);
        font-size: calc(var(--type-step--2) * var(--font-body-scale));
        font-weight: var(--font-heading-weight);
        line-height: var(--font-heading-line-height);
        letter-spacing: 0.07em;
        text-transform: uppercase;
        text-decoration: none;
        color: rgb(var(--color-accent-background));
        transition: color var(--motion-duration-fast) var(--motion-ease-default);
    }

    @media (hover: hover) and (pointer: fine) {
        .featured-frames__link:hover {
            color: rgb(var(--color-foreground));
        }
    }

    @container featured-frames-frame (max-width: 78rem) {
        .featured-frames__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @container featured-frames-frame (max-width: 48rem) {
        .featured-frames__grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .featured-frames__link {
            transition-duration: 0.01ms;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.featured-frames.name",
    "tag": "section",
    "class": "section-featured-frames",
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.featured-frames.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "header",
            "content": "t:sections.featured-frames.content.heading"
        },
        {
            "type": "text",
            "id": "section_number",
            "label": "t:sections.featured-frames.settings.section_number"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "t:sections.featured-frames.settings.heading"
        },
        {
            "type": "text",
            "id": "note",
            "label": "t:sections.featured-frames.settings.note"
        },
        {
            "type": "header",
            "content": "t:sections.featured-frames.content.products"
        },
        {
            "type": "product_list",
            "id": "products",
            "label": "t:sections.featured-frames.settings.products",
            "limit": 3
        },
        {
            "type": "text",
            "id": "details_label",
            "label": "t:sections.featured-frames.settings.details_label"
        },
        {
            "type": "header",
            "content": "t:sections.featured-frames.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.featured-frames.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.featured-frames.settings.padding_bottom",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "t:sections.featured-frames.presets.featured_frames",
            "settings": {
                "section_number": "04",
                "heading": "FEATURED FRAMES",
                "note": "SCULPTURAL ACETATE. ARCHITECTURAL FIT."
            }
        }
    ]
}
{% endschema %}
