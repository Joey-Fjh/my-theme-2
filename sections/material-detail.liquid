{%- liquid
    assign has_section_number = false
    if section.settings.section_number != blank
        assign has_section_number = true
    endif
    assign has_heading = false
    if section.settings.heading != blank
        assign has_heading = true
    endif
    assign has_intro = false
    if section.settings.intro != blank
        assign has_intro = true
    endif

    assign visible_item_count = 0
    assign index_item_count = 0
    for block in section.blocks
        assign item_has_title = false
        if block.settings.title != blank
            assign item_has_title = true
        endif
        assign item_has_subtitle = false
        if block.settings.subtitle != blank
            assign item_has_subtitle = true
        endif
        assign item_has_image = false
        if block.settings.image != blank
            assign item_has_image = true
        endif
        if item_has_title or item_has_subtitle or item_has_image
            assign visible_item_count = visible_item_count | plus: 1
        endif
        if item_has_title
            assign index_item_count = index_item_count | plus: 1
        endif
    endfor

    assign has_sidebar = false
    if has_section_number or has_heading or has_intro or index_item_count > 0
        assign has_sidebar = true
    endif

    assign has_any_content = false
    if has_sidebar or visible_item_count > 0
        assign has_any_content = true
    endif
-%}

{%- if has_any_content or request.design_mode -%}
    <section
        data-section-id="{{ section.id }}"
        class="section material color-{{ section.settings.color_scheme }}"
        style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
        {% if has_heading %}
            aria-labelledby="MaterialDetailHeading-{{ section.id }}"
        {% else %}
            aria-label="{{ 'sections.material-detail.accessibility.region' | t }}"
        {% endif %}
    >
        <div class="material__frame">
            {%- if has_any_content -%}
                <div class="material__shell">
                    <div class="material__layout{% unless has_sidebar %} material__layout--media-only{% endunless %}">
                        {%- if has_sidebar -%}
                            <div class="material__sidebar">
                                {%- if has_section_number or has_heading -%}
                                    <h2
                                        id="MaterialDetailHeading-{{ section.id }}"
                                        class="material__heading"
                                    >
                                        {%- if has_section_number -%}
                                            <span class="material__num">
                                                {{- section.settings.section_number | escape -}}
                                            </span>
                                        {%- endif -%}
                                        {%- if has_section_number and has_heading -%}
                                            <span class="material__slash" aria-hidden="true"
                                                >/</span
                                            >
                                        {%- endif -%}
                                        {%- if has_heading -%}
                                            <span>{{ section.settings.heading | escape }}</span>
                                        {%- endif -%}
                                    </h2>
                                {%- endif -%}

                                {%- if has_intro -%}
                                    <p class="material__intro">
                                        {{- section.settings.intro | escape | newline_to_br -}}
                                    </p>
                                {%- endif -%}

                                {%- if index_item_count > 0 -%}
                                    <span class="material__dash" aria-hidden="true"></span>
                                    <ol class="material__index">
                                        {%- for block in section.blocks -%}
                                            {%- if block.settings.title != blank -%}
                                                {%- liquid
                                                    assign item_index_label = block.settings.index_label | strip
                                                    if item_index_label == blank
                                                        assign item_index_label = forloop.index | prepend: '0'
                                                    endif
                                                -%}
                                                <li class="material__index-item">
                                                    <span class="material__index-num">
                                                        {{- item_index_label | escape -}}
                                                    </span>
                                                    <span class="material__index-title">
                                                        {{- block.settings.title | escape -}}
                                                    </span>
                                                </li>
                                            {%- endif -%}
                                        {%- endfor -%}
                                    </ol>
                                {%- endif -%}
                            </div>
                        {%- endif -%}

                        {%- if visible_item_count > 0 or request.design_mode -%}
                            <div class="material__mosaic" data-count="{{ visible_item_count }}">
                                {%- for block in section.blocks -%}
                                    {%- liquid
                                        assign item_has_title = false
                                        if block.settings.title != blank
                                            assign item_has_title = true
                                        endif
                                        assign item_has_subtitle = false
                                        if block.settings.subtitle != blank
                                            assign item_has_subtitle = true
                                        endif
                                        assign item_has_image = false
                                        if block.settings.image != blank
                                            assign item_has_image = true
                                        endif
                                        assign item_has_content = false
                                        if item_has_title or item_has_subtitle or item_has_image
                                            assign item_has_content = true
                                        endif
                                        assign item_index_label = block.settings.index_label | strip
                                        if item_index_label == blank
                                            assign item_index_label = forloop.index | prepend: '0'
                                        endif
                                        assign item_alt = block.settings.image.alt | default: block.settings.title | default: block.settings.subtitle | escape
                                        assign caption_pos = block.settings.caption_position | default: 'top_start'
                                    -%}

                                    {%- if item_has_content -%}
                                        <figure
                                            class="material__tile material__tile--slot-{{ forloop.index }}{% unless item_has_image %} material__tile--no-media{% endunless %}"
                                            data-caption-position="{{ caption_pos }}"
                                            {{ block.shopify_attributes }}
                                        >
                                            {%- if item_has_image -%}
                                                {% render 'image',
                                                    image: block.settings.image,
                                                    aspect_ratio: 'landscape',
                                                    mode: 'frame',
                                                    fit: 'cover',
                                                    loading: 'lazy',
                                                    alt: item_alt,
                                                    widths: '360,540,720,960,1200',
                                                    sizes: '(min-width: 1024px) 44vw, (min-width: 640px) 48vw, 94vw',
                                                    wrapper_class: 'material__media'
                                                %}
                                            {%- elsif request.design_mode -%}
                                                {% render 'image',
                                                    image: blank,
                                                    aspect_ratio: 'landscape',
                                                    mode: 'frame',
                                                    placeholder_key: 'collection-1',
                                                    placeholder_style: 'framed',
                                                    wrapper_class: 'material__media'
                                                %}
                                            {%- endif -%}

                                            {%- if item_has_title or item_has_subtitle -%}
                                                <figcaption class="material__caption-wrap">
                                                    <span class="material__caption">
                                                        {%- if item_has_title -%}
                                                            <span class="material__caption-heading">
                                                                {{- item_index_label | escape }} /
                                                                {{ block.settings.title | escape -}}
                                                            </span>
                                                        {%- endif -%}
                                                        {%- if item_has_subtitle -%}
                                                            <span class="material__caption-sub">
                                                                {{-
                                                                    block.settings.subtitle
                                                                    | escape
                                                                -}}
                                                            </span>
                                                        {%- endif -%}
                                                    </span>
                                                </figcaption>
                                            {%- endif -%}
                                        </figure>
                                    {%- elsif request.design_mode -%}
                                        <div
                                            class="material__tile material__tile--slot-{{ forloop.index }} material__tile--empty"
                                            {{ block.shopify_attributes }}
                                        >
                                            <p class="material__empty-text copy-s">
                                                {{-
                                                    'sections.material-detail.placeholders.empty_item'
                                                    | t
                                                -}}
                                            </p>
                                        </div>
                                    {%- endif -%}
                                {%- endfor -%}
                            </div>
                        {%- endif -%}
                    </div>
                </div>
            {%- else -%}
                <div class="material__empty">
                    <p class="material__empty-text copy-s">
                        {{- 'sections.material-detail.placeholders.empty' | t -}}
                    </p>
                </div>
            {%- endif -%}
        </div>
    </section>
{%- endif -%}

{% stylesheet %}
    .material__frame {
        --material-line-color: var(--color-line);
        container-type: inline-size;
        container-name: material-frame;
        position: relative;
    }

    .material__shell {
        border: 1px solid var(--material-line-color);
        padding: clamp(var(--spacing-step-m), 2cqi, var(--spacing-step-xl));
        background-color: rgb(var(--color-background));
    }

    .material__layout {
        display: grid;
        grid-template-columns: minmax(21rem, 24%) minmax(0, 1fr);
        gap: clamp(var(--spacing-step-l), 2.4cqi, var(--spacing-step-2xl));
        align-items: stretch;
    }

    .material__layout--media-only {
        grid-template-columns: minmax(0, 1fr);
    }

    .material__sidebar {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .material__heading {
        --font-material-title-size: clamp(
            calc(var(--font-heading-scale) * var(--font-heading-floor-1)),
            calc(var(--font-heading-scale) * 2.1cqi),
            calc(var(--font-heading-scale) * var(--type-step-2))
        );
        display: flex;
        align-items: baseline;
        gap: 0.45em;
        font-family: var(--font-heading-family);
        font-weight: var(--font-heading-weight);
        font-size: var(--font-material-title-size);
        line-height: var(--font-heading-line-height);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: rgb(var(--color-foreground));
    }

    .material__num {
        font-family: var(--font-mono-family);
        font-weight: var(--font-heading-weight);
        white-space: nowrap;
        flex-shrink: 0;
    }

    .material__slash {
        font-weight: var(--font-body-weight);
        color: var(--color-subtle);
        flex-shrink: 0;
    }

    .material__intro {
        margin-block-start: var(--spacing-step-m);
        font-family: var(--font-mono-family);
        font-size: calc(var(--type-step--2) * var(--font-body-scale));
        font-weight: var(--font-heading-weight);
        line-height: var(--font-body-line-height);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgb(var(--color-foreground));
    }

    .material__dash {
        display: block;
        width: 2.2rem;
        height: 1px;
        margin-block: var(--spacing-step-l);
        background-color: var(--color-line-strong);
    }

    .material__index {
        list-style: none;
        padding: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
    }

    .material__index-item {
        display: flex;
        align-items: baseline;
        gap: var(--spacing-step-s);
        padding-block: var(--spacing-step-s);
        border-block-end: 1px solid var(--material-line-color);
        font-family: var(--font-mono-family);
        font-size: calc(var(--type-step--2) * var(--font-body-scale));
        line-height: var(--font-heading-line-height);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgb(var(--color-foreground));
        min-width: 0;
    }

    .material__index-item:first-child {
        border-block-start: 1px solid var(--material-line-color);
    }

    .material__index-num {
        color: var(--color-subtle);
        font-weight: var(--font-heading-weight);
        white-space: nowrap;
        flex-shrink: 0;
    }

    .material__index-title {
        min-width: 0;
        overflow-wrap: break-word;
    }

    .material__mosaic {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--spacing-step-s);
        min-width: 0;
    }

    .material__tile {
        position: relative;
        display: grid;
        grid-template-areas: 'stage';
        grid-column: span 6;
        min-height: clamp(20rem, 23cqi, 29rem);
        min-width: 0;
        overflow: hidden;
        border: 1px solid var(--material-line-color);
        background-color: var(--color-surface-muted);
    }

    .material__tile--slot-1 {
        grid-column: span 7;
    }

    .material__tile--slot-2 {
        grid-column: span 5;
    }

    .material__tile--slot-3 {
        grid-column: span 6;
    }

    .material__tile--slot-4 {
        grid-column: span 6;
    }

    .material__mosaic[data-count='1'] .material__tile {
        grid-column: 1 / -1;
    }

    .material__media {
        grid-area: stage;
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
    }

    .material__caption-wrap {
        grid-area: stage;
        position: relative;
        z-index: 2;
        display: flex;
        align-items: flex-start;
        justify-content: flex-start;
        padding: var(--spacing-step-s);
        min-width: 0;
    }

    .material__tile[data-caption-position='bottom_start'] .material__caption-wrap {
        align-items: flex-end;
        justify-content: flex-start;
    }

    .material__tile[data-caption-position='bottom_end'] .material__caption-wrap {
        align-items: flex-end;
        justify-content: flex-end;
    }

    .material__caption {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-step-3xs);
        max-width: 100%;
        padding: var(--spacing-step-xs) var(--spacing-step-s);
        border: 1px solid var(--material-line-color);
        background-color: var(--color-veil);
        font-family: var(--font-mono-family);
        font-size: calc(var(--type-step--2) * var(--font-body-scale));
        font-weight: var(--font-heading-weight);
        line-height: var(--font-heading-line-height);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: rgb(var(--color-foreground));
        overflow-wrap: break-word;
    }

    .material__tile[data-caption-position='bottom_end'] .material__caption {
        text-align: end;
    }

    .material__caption-sub {
        font-weight: var(--font-body-weight);
        color: var(--color-muted);
    }

    .material__tile--no-media {
        min-height: 14rem;
    }

    .material__tile--no-media .material__caption-wrap {
        align-items: center;
        justify-content: flex-start;
        padding: var(--spacing-step-m);
    }

    .material__tile--no-media .material__caption {
        border: 0;
        padding: 0;
        background-color: transparent;
        text-align: start;
    }

    .material__tile--empty,
    .material__empty {
        display: grid;
        place-items: center;
        border: 1px dashed var(--color-line-strong);
        background-color: var(--color-surface-muted);
        padding: var(--spacing-step-xl);
        text-align: center;
    }

    .material__empty-text {
        color: var(--color-subtle);
    }

    @container material-frame (max-width: 78rem) {
        .material__layout {
            grid-template-columns: minmax(0, 1fr);
        }

        .material__index {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            column-gap: var(--spacing-step-l);
        }

        .material__index-item:nth-child(2) {
            border-block-start: 1px solid var(--material-line-color);
        }
    }

    @container material-frame (max-width: 36rem) {
        .material__index {
            grid-template-columns: minmax(0, 1fr);
        }

        .material__index-item:nth-child(2) {
            border-block-start: 0;
        }

        .material__mosaic {
            grid-template-columns: minmax(0, 1fr);
        }

        .material__tile,
        .material__tile--slot-1,
        .material__tile--slot-2,
        .material__tile--slot-3,
        .material__tile--slot-4 {
            grid-column: 1 / -1;
            min-height: 18rem;
        }

        .material__tile--no-media {
            min-height: 10rem;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "t:sections.material-detail.name",
    "tag": "section",
    "class": "section-material-detail",
    "max_blocks": 4,
    "disabled_on": {
        "groups": ["header", "footer"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.material-detail.settings.color_scheme",
            "default": "scheme-1"
        },
        {
            "type": "header",
            "content": "t:sections.material-detail.content.copy"
        },
        {
            "type": "text",
            "id": "section_number",
            "label": "t:sections.material-detail.settings.section_number"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "t:sections.material-detail.settings.heading"
        },
        {
            "type": "textarea",
            "id": "intro",
            "label": "t:sections.material-detail.settings.intro"
        },
        {
            "type": "header",
            "content": "t:sections.material-detail.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.material-detail.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.material-detail.settings.padding_bottom",
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "material_item",
            "name": "t:sections.material-detail.blocks.material_item.name",
            "settings": [
                {
                    "type": "text",
                    "id": "index_label",
                    "label": "t:sections.material-detail.blocks.material_item.settings.index_label"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "t:sections.material-detail.blocks.material_item.settings.title"
                },
                {
                    "type": "text",
                    "id": "subtitle",
                    "label": "t:sections.material-detail.blocks.material_item.settings.subtitle"
                },
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "t:sections.material-detail.blocks.material_item.settings.image"
                },
                {
                    "type": "select",
                    "id": "caption_position",
                    "label": "t:sections.material-detail.blocks.material_item.settings.caption_position",
                    "options": [
                        {
                            "value": "top_start",
                            "label": "t:sections.material-detail.blocks.material_item.options.caption_position.top_start"
                        },
                        {
                            "value": "bottom_start",
                            "label": "t:sections.material-detail.blocks.material_item.options.caption_position.bottom_start"
                        },
                        {
                            "value": "bottom_end",
                            "label": "t:sections.material-detail.blocks.material_item.options.caption_position.bottom_end"
                        }
                    ],
                    "default": "top_start"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.material-detail.presets.material_detail"
        }
    ]
}
{% endschema %}
