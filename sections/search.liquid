{%- liquid
    assign terms = search.terms | strip
-%}

<div
    data-section-id="{{ section.id }}"
    class="search-section full-width min-h-[50vh] color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top | default: 0 }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    "
>
    <div class="layout container-page overflow-visible!{% unless search.performed %} flex min-h-[50vh] flex-col items-center justify-center{% endunless %}">
        <div class="mx-auto w-full px-4 pc:max-w-1/2 pc:px-0{% if search.performed %} py-10{% endif %}">
            <h1 class="sr-only">{{ 'search.title' | t }}</h1>

            <form action="{{ routes.search_url }}" method="get" role="search" class="relative w-full">
                <input type="hidden" name="options[prefix]" value="last">
                <div class="mb-1 flex items-center gap-3 border-b border-theme-border pb-3 text-theme-text">
                    {%- render 'icons', icon: 'icon-search', class: 'shrink-0' -%}
                    <label class="sr-only" for="SearchInput-{{ section.id }}">
                        {{ 'search.search' | t }}
                    </label>
                    <input
                        id="SearchInput-{{ section.id }}"
                        type="search"
                        name="q"
                        value="{{ terms | escape }}"
                        class="w-full flex-1 appearance-none border-none bg-transparent body-xl text-theme-text focus-ring outline-none placeholder:text-theme-text/50"
                        placeholder="{{ 'search.search' | t }}"
                    >
                    <button type="submit" class="btn-primary shrink-0">
                        {{ 'search.search' | t }}
                    </button>
                </div>
            </form>
        </div>
    </div>

    {%- if search.performed -%}
        <div class="layout container-page overflow-visible! pb-10">
            {%- paginate search.results by section.settings.search_per_page -%}
                {%- if search.results_count == 0 -%}
                    <p class="py-10 text-center body-lg">{{ 'search.no_results_html' | t: terms: terms }}</p>
                {%- else -%}
                    <ul class="flex flex-col gap-4">
                        {%- for item in search.results -%}
                            <li>
                                <a href="{{ item.url }}" class="link-underline body-lg">{{ item.title | escape }}</a>
                            </li>
                        {%- endfor -%}
                    </ul>
                {%- endif -%}

                <div class="mt-8">
                    {%- render 'pagination', paginate_obj: paginate -%}
                </div>
            {%- endpaginate -%}
        </div>
    {%- endif -%}
</div>

{% schema %}
{
    "name": "t:general.search",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["search"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.search.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "range",
            "id": "search_per_page",
            "min": 3,
            "max": 24,
            "step": 3,
            "default": 12,
            "label": "t:sections.search.settings.search_per_page"
        },
        {
            "type": "select",
            "id": "mobile_card_columns",
            "label": "t:sections.search.settings.mobile_product_card_columns",
            "default": "2",
            "options": [
                {
                    "value": "1",
                    "label": "t:sections.collection.options.1_column"
                },
                {
                    "value": "2",
                    "label": "t:sections.collection.options.2_columns"
                }
            ]
        },
        {
            "type": "header",
            "content": "t:sections.search.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.search.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.search.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
