<div
    data-section-id="{{ section.id }}"
    class="section color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <h1 class="title-3xl">
        {{ '404.title' | t -}}
        <br>
        {{ '404.heading_line_2' | t }}
    </h1>
    <div class="rte copy-l">
        {{ '404.description_html' | t }}
    </div>
    {%- assign button_text = '404.back_to_shopping' | t -%}
    <a class="btn copy-l" href="{{ routes.root_url }}">{{ button_text }}</a>
</div>

{% schema %}
{
    "name": "t:general.404",
    "tag": "section",
    "enabled_on": {
        "templates": ["404"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.404.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.404.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.404.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.404.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
