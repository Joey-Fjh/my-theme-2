<div
    data-section-id="{{ section.id }}"
    class="full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout container-page py-16 pc:py-20">
        <div class="flex flex-col gap-8">
            {%- comment -%} Main Content {%- endcomment -%}
            <div class="relative p-3">
                <h1 class="heading-3xl">
                    {{ '404.title' | t -}}
                    <br>
                    {{ '404.heading_line_2' | t }}
                </h1>
                <div class="rte rte--compact max-w-2/3 body-xl pc:max-w-1/3">
                    {{ '404.description_html' | t }}
                </div>

                {%- assign button_text = '404.back_to_shopping' | t -%}
                {% render 'link',
                    href: routes.root_url,
                    class: 'mt-8 btn body-xl',
                    variant: 'plain',
                    text: button_text
                %}
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:general.404",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["404"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.404.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.404.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.404.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.404.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
