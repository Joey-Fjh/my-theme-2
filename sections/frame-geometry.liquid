{%- liquid
    assign has_section_number = false
    if section.settings.section_number != blank
        assign has_section_number = true
    endif
    assign has_heading = false
    if section.settings.heading != blank
        assign has_heading = true
    endif
    assign has_note = false
    if section.settings.note != blank
        assign has_note = true
    endif
    assign has_header = false
    if has_section_number or has_heading or has_note
        assign has_header = true
    endif

    assign has_front_image = false
    if section.settings.front_image != blank
        assign has_front_image = true
    endif
    assign has_side_image = false
    if section.settings.side_image != blank
        assign has_side_image = true
    endif

    assign has_frame_width = false
    if section.settings.frame_width != blank
        assign has_frame_width = true
    endif
    assign has_lens_width = false
    if section.settings.lens_width != blank
        assign has_lens_width = true
    endif
    assign has_bridge_width = false
    if section.settings.bridge_width != blank
        assign has_bridge_width = true
    endif
    assign has_lens_height = false
    if section.settings.lens_height != blank
        assign has_lens_height = true
    endif
    assign has_temple_length = false
    if section.settings.temple_length != blank
        assign has_temple_length = true
    endif

    assign has_front_view = false
    if has_front_image or has_frame_width or has_lens_width or has_bridge_width or has_lens_height or request.design_mode
        assign has_front_view = true
    endif
    assign has_side_view = false
    if has_side_image or has_temple_length or request.design_mode
        assign has_side_view = true
    endif
    assign has_views = false
    if has_front_view or has_side_view
        assign has_views = true
    endif

    assign has_fit_label = false
    if section.settings.fit_label != blank
        assign has_fit_label = true
    endif
    assign has_size_code = false
    if section.settings.size_code != blank
        assign has_size_code = true
    endif
    assign has_fit_note = false
    if section.settings.fit_note != blank
        assign has_fit_note = true
    endif
    assign has_metrics = false
    if has_frame_width or has_lens_width or has_bridge_width or has_temple_length
        assign has_metrics = true
    endif
    assign has_spec_bar = false
    if has_fit_label or has_size_code or has_fit_note or has_metrics
        assign has_spec_bar = true
    endif

    assign has_any_content = false
    if has_header or has_front_image or has_side_image or has_spec_bar or has_lens_height
        assign has_any_content = true
    endif

    assign front_alt_fallback = 'sections.frame-geometry.labels.front_view' | t
    assign front_alt = section.settings.front_image.alt | default: front_alt_fallback | escape
    assign side_alt_fallback = 'sections.frame-geometry.labels.side_view' | t
    assign side_alt = section.settings.side_image.alt | default: side_alt_fallback | escape
-%}

{%- if has_any_content or request.design_mode -%}
    <section
        data-section-id="{{ section.id }}"
        class="section geometry color-{{ section.settings.color_scheme }}"
        style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
        {% if has_heading %}
            aria-labelledby="FrameGeometryHeading-{{ section.id }}"
        {% else %}
            aria-label="{{ 'sections.frame-geometry.accessibility.region' | t }}"
        {% endif %}
    >
        <div class="geometry__frame">
            {%- if has_any_content -%}
                {%- if has_header -%}
                    <div class="geometry__head">
                        {%- if has_section_number or has_heading -%}
                            <h2 id="FrameGeometryHeading-{{ section.id }}" class="geometry__title">
                                {%- if has_section_number -%}
                                    <span class="geometry__num">
                                        {{- section.settings.section_number | escape -}}
                                    </span>
                                {%- endif -%}
                                {%- if has_section_number and has_heading -%}
                                    <span class="geometry__slash" aria-hidden="true">/</span>
                                {%- endif -%}
                                {%- if has_heading -%}
                                    <span>{{ section.settings.heading | escape }}</span>
                                {%- endif -%}
                            </h2>
                        {%- endif -%}

                        {%- if has_note -%}
                            <p class="geometry__note">
                                {{- section.settings.note | escape -}}
                            </p>
                        {%- endif -%}
                    </div>
                {%- endif -%}

                {%- if has_views -%}
                    <div class="geometry__box">
                        <span class="geometry__crosshair" aria-hidden="true"></span>
                        <div class="geometry__views{% unless has_front_view and has_side_view %} geometry__views--single{% endunless %}">
                            {%- if has_front_view -%}
                                <figure class="geometry__view geometry__view--front">
                                    {%- if has_frame_width -%}
                                        <div class="geometry__callout geometry__callout--top">
                                            <p class="geometry__callout-text">
                                                <span>
                                                    {{-
                                                        'sections.frame-geometry.labels.frame_width'
                                                        | t
                                                    -}}
                                                </span>
                                                <span class="geometry__callout-value">
                                                    {{- section.settings.frame_width | escape -}}
                                                </span>
                                            </p>
                                            <span
                                                class="geometry__dim-line geometry__dim-line--h"
                                                aria-hidden="true"
                                            ></span>
                                        </div>
                                    {%- endif -%}

                                    <div class="geometry__stage">
                                        {%- if has_front_image -%}
                                            {% render 'image',
                                                image: section.settings.front_image,
                                                aspect_ratio: 'adapt',
                                                placeholder_aspect_ratio: 'wide',
                                                mode: 'natural',
                                                fit: 'contain',
                                                loading: 'lazy',
                                                alt: front_alt,
                                                widths: '360,540,720,960,1200',
                                                sizes: '(min-width: 1024px) 52vw, 94vw',
                                                wrapper_class: 'geometry__media'
                                            %}
                                        {%- elsif request.design_mode -%}
                                            {% render 'image',
                                                image: blank,
                                                aspect_ratio: 'wide',
                                                mode: 'frame',
                                                placeholder_key: 'product-1',
                                                placeholder_style: 'framed',
                                                wrapper_class: 'geometry__media'
                                            %}
                                        {%- endif -%}

                                        {%- if has_lens_height -%}
                                            <div class="geometry__callout geometry__callout--side">
                                                <span
                                                    class="geometry__dim-line geometry__dim-line--v"
                                                    aria-hidden="true"
                                                ></span>
                                                <p class="geometry__callout-text">
                                                    <span>
                                                        {{-
                                                            'sections.frame-geometry.labels.lens_height'
                                                            | t
                                                        -}}
                                                    </span>
                                                    <span class="geometry__callout-value">
                                                        {{-
                                                            section.settings.lens_height
                                                            | escape
                                                        -}}
                                                    </span>
                                                </p>
                                            </div>
                                        {%- endif -%}
                                    </div>

                                    {%- if has_lens_width or has_bridge_width -%}
                                        <div class="geometry__callouts-bottom">
                                            {%- if has_lens_width -%}
                                                <div class="geometry__callout">
                                                    <span
                                                        class="geometry__dim-line geometry__dim-line--h"
                                                        aria-hidden="true"
                                                    ></span>
                                                    <p class="geometry__callout-text">
                                                        <span>
                                                            {{-
                                                                'sections.frame-geometry.labels.lens_width'
                                                                | t
                                                            -}}
                                                        </span>
                                                        <span class="geometry__callout-value">
                                                            {{-
                                                                section.settings.lens_width
                                                                | escape
                                                            -}}
                                                        </span>
                                                    </p>
                                                </div>
                                            {%- endif -%}

                                            {%- if has_bridge_width -%}
                                                <div class="geometry__callout">
                                                    <span
                                                        class="geometry__dim-line geometry__dim-line--h"
                                                        aria-hidden="true"
                                                    ></span>
                                                    <p class="geometry__callout-text">
                                                        <span>
                                                            {{-
                                                                'sections.frame-geometry.labels.bridge_width'
                                                                | t
                                                            -}}
                                                        </span>
                                                        <span class="geometry__callout-value">
                                                            {{-
                                                                section.settings.bridge_width
                                                                | escape
                                                            -}}
                                                        </span>
                                                    </p>
                                                </div>
                                            {%- endif -%}
                                        </div>
                                    {%- endif -%}

                                    <figcaption class="visually-hidden">
                                        {{- 'sections.frame-geometry.labels.front_view' | t -}}
                                    </figcaption>
                                </figure>
                            {%- endif -%}

                            {%- if has_side_view -%}
                                <figure class="geometry__view geometry__view--side">
                                    <div class="geometry__stage geometry__stage--side">
                                        {%- if has_side_image -%}
                                            {% render 'image',
                                                image: section.settings.side_image,
                                                aspect_ratio: 'adapt',
                                                placeholder_aspect_ratio: 'wide',
                                                mode: 'natural',
                                                fit: 'contain',
                                                loading: 'lazy',
                                                alt: side_alt,
                                                widths: '360,540,720,960,1200',
                                                sizes: '(min-width: 1024px) 44vw, 94vw',
                                                wrapper_class: 'geometry__media'
                                            %}
                                        {%- elsif request.design_mode -%}
                                            {% render 'image',
                                                image: blank,
                                                aspect_ratio: 'wide',
                                                mode: 'frame',
                                                placeholder_key: 'product-2',
                                                placeholder_style: 'framed',
                                                wrapper_class: 'geometry__media'
                                            %}
                                        {%- endif -%}
                                    </div>

                                    {%- if has_temple_length -%}
                                        <div class="geometry__callout geometry__callout--bottom">
                                            <span
                                                class="geometry__dim-line geometry__dim-line--h"
                                                aria-hidden="true"
                                            ></span>
                                            <p class="geometry__callout-text">
                                                <span>
                                                    {{-
                                                        'sections.frame-geometry.labels.temple_length'
                                                        | t
                                                    -}}
                                                </span>
                                                <span class="geometry__callout-value">
                                                    {{- section.settings.temple_length | escape -}}
                                                </span>
                                            </p>
                                        </div>
                                    {%- endif -%}

                                    <figcaption class="visually-hidden">
                                        {{- 'sections.frame-geometry.labels.side_view' | t -}}
                                    </figcaption>
                                </figure>
                            {%- endif -%}
                        </div>
                    </div>
                {%- endif -%}

                {%- if has_spec_bar -%}
                    <div class="geometry__spec-bar">
                        {%- if has_fit_label or has_size_code or has_fit_note -%}
                            <div class="geometry__spec-summary">
                                {%- if has_fit_label -%}
                                    <span class="geometry__spec-label">
                                        {{- section.settings.fit_label | escape -}}
                                    </span>
                                {%- endif -%}
                                {%- if has_size_code -%}
                                    <span class="geometry__spec-pill">
                                        {{- section.settings.size_code | escape -}}
                                    </span>
                                {%- endif -%}
                                {%- if has_fit_note -%}
                                    <p class="geometry__spec-note">
                                        {{- section.settings.fit_note | escape -}}
                                    </p>
                                {%- endif -%}
                            </div>
                        {%- endif -%}

                        {%- if has_metrics -%}
                            <div class="geometry__table-wrap">
                                <p class="geometry__table-heading">
                                    {{- 'sections.frame-geometry.labels.frame_size' | t -}}
                                </p>
                                <dl class="geometry__metrics">
                                    {%- if has_frame_width -%}
                                        <div class="geometry__metric">
                                            <dt>
                                                {{
                                                    'sections.frame-geometry.metrics.frame_short'
                                                    | t
                                                }}
                                            </dt>
                                            <dd>{{ section.settings.frame_width | escape }}</dd>
                                        </div>
                                    {%- endif -%}
                                    {%- if has_lens_width -%}
                                        <div class="geometry__metric">
                                            <dt>
                                                {{
                                                    'sections.frame-geometry.metrics.lens_short'
                                                    | t
                                                }}
                                            </dt>
                                            <dd>{{ section.settings.lens_width | escape }}</dd>
                                        </div>
                                    {%- endif -%}
                                    {%- if has_bridge_width -%}
                                        <div class="geometry__metric">
                                            <dt>
                                                {{
                                                    'sections.frame-geometry.metrics.bridge_short'
                                                    | t
                                                }}
                                            </dt>
                                            <dd>{{ section.settings.bridge_width | escape }}</dd>
                                        </div>
                                    {%- endif -%}
                                    {%- if has_temple_length -%}
                                        <div class="geometry__metric">
                                            <dt>
                                                {{
                                                    'sections.frame-geometry.metrics.temple_short'
                                                    | t
                                                }}
                                            </dt>
                                            <dd>{{ section.settings.temple_length | escape }}</dd>
                                        </div>
                                    {%- endif -%}
                                </dl>
                            </div>
                        {%- endif -%}
                    </div>
                {%- endif -%}
            {%- else -%}
                <div class="geometry__empty">
                    <p class="geometry__empty-text copy-s">
                        {{- 'sections.frame-geometry.placeholders.empty' | t -}}
                    </p>
                </div>
            {%- endif -%}
        </div>
    </section>
{%- endif -%}

{% stylesheet %}
    .geometry__frame {
        --geometry-line-color: var(--color-line);
        container-type: inline-size;
        container-name: geometry-frame;
        position: relative;
    }

    .geometry__head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--spacing-step-xs) var(--spacing-step-l);
        margin-block-end: var(--spacing-step-m);
    }

    .geometry__title {
        --font-geometry-title-size: clamp(
            calc(var(--font-heading-scale) * var(--font-heading-floor-1)),
            calc(var(--font-heading-scale) * 2.2cqi),
            calc(var(--font-heading-scale) * var(--type-step-2))
        );
        display: inline-flex;
        align-items: baseline;
        gap: 0.45em;
        font-family: var(--font-heading-family);
        font-weight: var(--font-heading-weight);
        font-size: var(--font-geometry-title-size);
        line-height: var(--font-heading-line-height);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: rgb(var(--color-foreground));
    }

    .geometry__num {
        font-family: var(--font-mono-family);
        font-weight: var(--font-heading-weight);
        white-space: nowrap;
        flex-shrink: 0;
    }

    .geometry__slash {
        font-weight: var(--font-body-weight);
        color: var(--color-subtle);
        flex-shrink: 0;
    }

    .geometry__note {
        font-family: var(--font-mono-family);
        font-size: calc(var(--type-step--2) * var(--font-body-scale));
        font-weight: var(--font-heading-weight);
        line-height: var(--font-heading-line-height);
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--color-subtle);
    }

    .geometry__box {
        position: relative;
        border: 1px solid var(--geometry-line-color);
        background-color: rgb(var(--color-background));
        padding-block: clamp(var(--spacing-step-l), 2.6cqi, var(--spacing-step-2xl));
        padding-inline: clamp(var(--spacing-step-m), 2.4cqi, var(--spacing-step-2xl));
    }

    .geometry__crosshair {
        --geometry-crosshair-x: -50%;
        position: absolute;
        inset-block-start: -0.5px;
        inset-inline-start: 51%;
        width: clamp(1.2rem, 1.8cqi, 2rem);
        height: clamp(1.2rem, 1.8cqi, 2rem);
        color: var(--geometry-line-color);
        transform: translate(var(--geometry-crosshair-x), -50%);
        pointer-events: none;
        background:
            linear-gradient(currentColor, currentColor) center / 100% 1px no-repeat,
            linear-gradient(currentColor, currentColor) center / 1px 100% no-repeat;
    }

    [dir='rtl'] .geometry__crosshair {
        --geometry-crosshair-x: 50%;
    }

    .geometry__views {
        display: grid;
        grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
        align-items: center;
        gap: clamp(var(--spacing-step-l), 3cqi, var(--spacing-step-3xl));
    }

    .geometry__views--single {
        grid-template-columns: minmax(0, 1fr);
    }

    .geometry__view {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-step-s);
        min-width: 0;
    }

    .geometry__stage {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: var(--spacing-step-s);
        min-width: 0;
    }

    .geometry__stage--side {
        grid-template-columns: minmax(0, 1fr);
    }

    .geometry__media {
        width: 100%;
        min-width: 0;
    }

    .geometry__callout {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--spacing-step-2xs);
        min-width: 0;
        text-align: center;
    }

    .geometry__callout--side {
        flex-direction: row;
        align-items: center;
        gap: var(--spacing-step-xs);
        text-align: start;
        align-self: stretch;
    }

    .geometry__callout-text {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: center;
        gap: var(--spacing-step-3xs) var(--spacing-step-2xs);
        font-family: var(--font-mono-family);
        font-size: calc(var(--type-step--2) * var(--font-body-scale));
        font-weight: var(--font-heading-weight);
        line-height: var(--font-heading-line-height);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: rgb(var(--color-foreground));
    }

    .geometry__callout--side .geometry__callout-text {
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
    }

    .geometry__callout-value {
        white-space: nowrap;
    }

    .geometry__dim-line {
        position: relative;
        display: block;
        flex-shrink: 0;
        color: rgb(var(--color-accent-background));
    }

    .geometry__dim-line--h {
        width: 100%;
        height: 0.7rem;
        background:
            linear-gradient(currentColor, currentColor) center / 100% 1px no-repeat,
            linear-gradient(currentColor, currentColor) left center / 1px 100% no-repeat,
            linear-gradient(currentColor, currentColor) right center / 1px 100% no-repeat;
    }

    .geometry__dim-line--v {
        width: 0.7rem;
        min-height: 5.6rem;
        height: 100%;
        background:
            linear-gradient(currentColor, currentColor) center / 1px 100% no-repeat,
            linear-gradient(currentColor, currentColor) top center / 100% 1px no-repeat,
            linear-gradient(currentColor, currentColor) bottom center / 100% 1px no-repeat;
    }

    .geometry__callouts-bottom {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
        gap: var(--spacing-step-m);
    }

    .geometry__spec-bar {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: var(--spacing-step-m) var(--spacing-step-2xl);
        margin-block-start: var(--spacing-step-m);
        padding-block: var(--spacing-step-m);
        border-block-end: 1px solid var(--geometry-line-color);
    }

    .geometry__spec-summary {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--spacing-step-s) var(--spacing-step-l);
        min-width: 0;
    }

    .geometry__spec-label {
        font-family: var(--font-mono-family);
        font-size: calc(var(--type-step--2) * var(--font-body-scale));
        font-weight: var(--font-heading-weight);
        line-height: var(--font-heading-line-height);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-subtle);
    }

    .geometry__spec-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.55em 1.1em;
        border: 1px solid rgb(var(--color-accent-background));
        background-color: rgb(var(--color-accent-background));
        color: rgb(var(--color-accent-foreground));
        font-family: var(--font-mono-family);
        font-size: calc(var(--type-step--2) * var(--font-body-scale));
        font-weight: var(--font-heading-weight);
        line-height: var(--font-heading-line-height);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .geometry__spec-note {
        font-family: var(--font-mono-family);
        font-size: calc(var(--type-step--2) * var(--font-body-scale));
        line-height: var(--font-body-line-height);
        color: var(--color-subtle);
    }

    .geometry__table-wrap {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: var(--spacing-step-2xs);
        min-width: 0;
    }

    .geometry__table-heading {
        font-family: var(--font-mono-family);
        font-size: calc(var(--type-step--2) * var(--font-body-scale));
        font-weight: var(--font-heading-weight);
        line-height: var(--font-heading-line-height);
        letter-spacing: 0.04em;
        color: rgb(var(--color-foreground));
    }

    .geometry__metrics {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: flex-end;
        gap: var(--spacing-step-s) var(--spacing-step-xl);
    }

    .geometry__metric {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--spacing-step-3xs);
        font-family: var(--font-mono-family);
    }

    .geometry__metric dt {
        font-size: calc(var(--type-step--2) * var(--font-body-scale));
        line-height: var(--font-heading-line-height);
        color: var(--color-subtle);
    }

    .geometry__metric dd {
        font-size: calc(var(--type-step--1) * var(--font-body-scale));
        font-weight: var(--font-heading-weight);
        line-height: var(--font-heading-line-height);
        color: rgb(var(--color-foreground));
    }

    .geometry__empty {
        border: 1px dashed var(--color-line-strong);
        background-color: var(--color-surface-muted);
        padding: var(--spacing-step-xl);
        text-align: center;
    }

    .geometry__empty-text {
        color: var(--color-subtle);
    }

    @container geometry-frame (max-width: 78rem) {
        .geometry__spec-bar {
            grid-template-columns: minmax(0, 1fr);
        }

        .geometry__table-wrap {
            align-items: flex-start;
        }

        .geometry__metrics {
            width: 100%;
            justify-content: flex-start;
        }

        .geometry__metric {
            align-items: flex-start;
        }
    }

    @container geometry-frame (max-width: 54rem) {
        .geometry__crosshair {
            display: none;
        }

        .geometry__views {
            grid-template-columns: minmax(0, 1fr);
            gap: var(--spacing-step-l);
        }

        .geometry__view + .geometry__view {
            padding-block-start: var(--spacing-step-l);
            border-block-start: 1px solid var(--geometry-line-color);
        }

        .geometry__box {
            padding: var(--spacing-step-m);
        }
    }

    @container geometry-frame (max-width: 34rem) {
        .geometry__stage {
            grid-template-columns: minmax(0, 1fr);
        }

        .geometry__callout--side {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .geometry__callout--side .geometry__callout-text {
            flex-direction: row;
            align-items: baseline;
            justify-content: center;
        }

        .geometry__dim-line--v {
            width: 100%;
            min-height: 0.7rem;
            height: 0.7rem;
            background:
                linear-gradient(currentColor, currentColor) center / 100% 1px no-repeat,
                linear-gradient(currentColor, currentColor) left center / 1px 100% no-repeat,
                linear-gradient(currentColor, currentColor) right center / 1px 100% no-repeat;
        }
    }
{% endstylesheet %}

