<div
    data-section-id="{{ section.id }}"
    class="section color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <h1 class="title-2xl">{{ 'collections.list_heading' | t }}</h1>

    {%- paginate collections by 12 -%}
        <div class="grid-list" data-collection-grid>
            {%- for collection in collections -%}
                <a href="{{ collection.url }}">
                    {%- assign image_loading = 'lazy' -%}
                    {%- if forloop.first -%}
                        {%- assign image_loading = 'eager' -%}
                    {%- endif -%}
                    {%- assign collection_card_image = collection.featured_image -%}
                    {%- assign image_alt = collection_card_image.alt
                        | default: collection.title
                        | escape
                    -%}
                    {%- render 'image',
                        image: collection_card_image,
                        placeholder_key: 'collection-1',
                        alt: image_alt,
                        width: collection_card_image.width,
                        sizes: '(min-width: 1200px) 33vw, (min-width: 800px) 50vw, 100vw',
                        widths: '400,700,1000,1200,1600',
                        loading: image_loading
                    -%}
                    <span class="copy-l">{{ collection.title }}</span>
                </a>
            {%- endfor -%}
        </div>

        {%- render 'pagination', paginate_obj: paginate -%}
    {% endpaginate %}
</div>

{% schema %}
{
    "name": "t:general.collections_grid",
    "tag": "section",
    "enabled_on": {
        "templates": ["list-collections"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.collections.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.collections.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.collections.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.collections.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
