<div
    data-section-id="{{ section.id }}"
    class="custom-content-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <div class="layout{% if section.settings.section_width == 'fixed' %} container-page{% endif %}">
        {% content_for 'blocks' %}
    </div>
</div>

{% schema %}
{
    "name": "t:sections.custom-content.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.overlay"]
    },
    "blocks": [{ "type": "@theme" }, { "type": "@app" }],
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.custom-content.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "select",
            "id": "section_width",
            "label": "t:sections.custom-content.settings.section_width",
            "options": [
                {
                    "value": "fixed",
                    "label": "t:sections.custom-content.options.fixed_width"
                },
                {
                    "value": "full",
                    "label": "t:sections.custom-content.options.full_width"
                }
            ],
            "default": "fixed"
        },
        {
            "type": "header",
            "content": "t:sections.custom-content.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.custom-content.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.custom-content.settings.padding_bottom",
            "default": 32
        }
    ],
    "presets": [
        {
            "name": "t:sections.custom-content.presets.custom_content",
            "blocks": [
                {
                    "type": "group",
                    "blocks": [{ "type": "heading" }, { "type": "text" }, { "type": "button" }]
                }
            ]
        }
    ]
}
{% endschema %}
