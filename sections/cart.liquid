<div
    data-section-id="{{ section.id }}"
    class="full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="cartPage()"
    data-module-id="cart-page"
    :class="{ 'opacity-50 pointer-events-none': $store.cart.loading }"
>
    <div class="layout container-page">
        <h1 class="heading-3xl">{{ 'cart.title' | t }}</h1>

        {%- assign cart_form_id = 'CartForm-' | append: section.id -%}
        {%- if cart.item_count == 0 -%}
            <div class="mt-8 flex flex-col gap-6">
                <p>{{ 'cart.empty' | t }}</p>
                {%- assign link_text = 'cart.shop_more' | t -%}
                {%- render 'link',
                    text: link_text,
                    href: routes.root_url,
                    variant: 'underline',
                    class: 'body-xl'
                -%}
            </div>
        {%- else -%}
            <div class="mt-10 flex flex-col gap-10">
                <div class="flex flex-col">
                    <ul class="flex flex-col">
                        {%- for item in cart.items -%}
                            <li class="grid grid-cols-3 gap-x-2 gap-y-3 border-b border-theme-border py-3 first:pt-0 pc:grid-cols-[minmax(7.75rem,1fr)_minmax(0,3fr)_minmax(8rem,1fr)] pc:gap-6 pc:py-6">
                                <div class="flex aspect-square w-full items-center justify-center">
                                    {%- if item.image -%}
                                        {% render 'image',
                                            url: item.url,
                                            wrapper_class: 'block h-full w-full',
                                            image: item.image,
                                            alt: item.image.alt,
                                            width: 120,
                                            height: 120,
                                            crop: 'center',
                                            img_class: 'object-contain p-3'
                                        %}
                                    {%- else -%}
                                        {%- assign cart_placeholder_index = forloop.index0
                                            | modulo: 6
                                            | plus: 1
                                        -%}
                                        {%- assign cart_placeholder_key = 'product-'
                                            | append: cart_placeholder_index
                                        -%}
                                        {% render 'image',
                                            wrapper_class: 'h-full w-full',
                                            placeholder_key: cart_placeholder_key,
                                            placeholder_class: 'text-theme-text',
                                            alt: '',
                                            width: 120,
                                            height: 120,
                                            fit: 'contain'
                                        %}
                                    {%- endif -%}
                                </div>

                                <div class="flex min-w-0 flex-col py-1">
                                    <p>
                                        {{ item.vendor | default: ' ' }}
                                    </p>
                                    <a
                                        href="{{ item.url }}"
                                        class="mt-3 block body-xl hover:underline pc:mt-5"
                                    >
                                        {{ item.product.title }}
                                    </a>

                                    {%- unless item.product.has_only_default_variant -%}
                                        <ul class="mt-1 text-theme-text">
                                            {%- for option in item.options_with_values -%}
                                                <li>
                                                    {{ option.name | escape }}:
                                                    {{ option.value | escape }}
                                                </li>
                                            {%- endfor -%}
                                        </ul>
                                    {%- endunless -%}

                                    {%- if item.selling_plan_allocation -%}
                                        <p class="mt-1 text-theme-text">
                                            {{ 'cart.selling_plan_label' | t }}:
                                            {{ item.selling_plan_allocation.selling_plan.name }}
                                        </p>
                                    {%- endif -%}

                                    {%- if item.properties.size > 0 -%}
                                        {%- capture cart_upload_backslash -%}\{%- endcapture -%}
                                        {%- capture cart_item_properties_html -%}
                                            {%- for property in item.properties -%}
                                                {%- liquid
                                                    assign property_key = property.first
                                                    assign property_value = property.last
                                                    assign property_key_first = property_key | slice: 0
                                                    assign property_is_private = false
                                                    if property_key == blank or property_key_first == '_'
                                                        assign property_is_private = true
                                                    endif

                                                    assign property_has_value = true
                                                    if property_value == nil
                                                        assign property_has_value = false
                                                    elsif property_value == blank and property_value != 0 and property_value != false
                                                        assign property_has_value = false
                                                    else
                                                        assign property_value_stripped = property_value | strip
                                                        if property_value_stripped == blank and property_value != 0 and property_value != false
                                                            assign property_has_value = false
                                                        endif
                                                    endif

                                                    assign property_upload_url = ''
                                                    if property_has_value and property_is_private == false
                                                        assign property_value_text = property_value | append: '' | strip
                                                        assign property_value_lower = property_value_text | downcase
                                                        assign scheme_js = property_value_lower | slice: 0, 11
                                                        assign scheme_data = property_value_lower | slice: 0, 5
                                                        assign scheme_https = property_value_lower | slice: 0, 8
                                                        assign scheme_http = property_value_lower | slice: 0, 7
                                                        assign scheme_proto = property_value_text | slice: 0, 2
                                                        assign scheme_root = property_value_text | slice: 0, 1
                                                        assign upload_bs_parts = property_value_text | split: cart_upload_backslash
                                                        assign upload_rejected = false
                                                        if property_value_text == blank
                                                            assign upload_rejected = true
                                                        elsif upload_bs_parts.size > 1
                                                            assign upload_rejected = true
                                                        elsif property_value_text contains ' '
                                                            assign upload_rejected = true
                                                        elsif property_value_lower contains '..'
                                                            assign upload_rejected = true
                                                        elsif property_value_lower contains '%2e'
                                                            assign upload_rejected = true
                                                        elsif scheme_js == 'javascript:' or scheme_data == 'data:' or scheme_proto == '//'
                                                            assign upload_rejected = true
                                                        endif

                                                        unless upload_rejected
                                                            if scheme_https == 'https://' or scheme_http == 'http://'
                                                                if scheme_https == 'https://'
                                                                    assign upload_url_rest = property_value_text | slice: 8, property_value_text.size
                                                                else
                                                                    assign upload_url_rest = property_value_text | slice: 7, property_value_text.size
                                                                endif
                                                                assign upload_rest_first = upload_url_rest | slice: 0, 1
                                                                if upload_url_rest == blank or upload_rest_first == '/'
                                                                    assign upload_rejected = true
                                                                elsif upload_url_rest contains '/'
                                                                    assign upload_path_parts = upload_url_rest | split: '/'
                                                                    assign upload_host = upload_path_parts | first
                                                                    if upload_host == blank
                                                                        assign upload_rejected = true
                                                                    elsif property_value_text contains '/uploads/'
                                                                        assign property_upload_url = property_value_text
                                                                    endif
                                                                else
                                                                    assign upload_rejected = true
                                                                endif
                                                            elsif scheme_root == '/' and scheme_proto != '//'
                                                                if property_value_text contains '/uploads/'
                                                                    assign property_upload_url = property_value_text
                                                                endif
                                                            endif
                                                        endunless
                                                    endif
                                                    assign property_upload_filename = ''
                                                    if property_upload_url != blank
                                                        assign property_upload_filename = property_upload_url | split: '?' | first | split: '#' | first | split: '/' | last
                                                    endif
                                                -%}
                                                {%- unless property_is_private or property_has_value == false -%}
                                                    <li>
                                                        <span>{{ property_key | escape }}:</span>
                                                        {%- if property_upload_url != blank -%}
                                                            <a
                                                                href="{{ property_upload_url | escape }}"
                                                                class="ms-1 hover:underline"
                                                            >
                                                                {{- property_upload_filename | escape -}}
                                                            </a>
                                                        {%- else -%}
                                                            <span class="ms-1">
                                                                {{- property_value | escape -}}
                                                            </span>
                                                        {%- endif -%}
                                                    </li>
                                                {%- endunless -%}
                                            {%- endfor -%}
                                        {%- endcapture -%}
                                        {%- assign cart_item_properties_html = cart_item_properties_html
                                            | strip
                                        -%}
                                        {%- if cart_item_properties_html != blank -%}
                                            <ul class="mt-1 text-theme-text">
                                                {{ cart_item_properties_html }}
                                            </ul>
                                        {%- endif -%}
                                    {%- endif -%}

                                    <div class="mt-auto pt-2 pc:pt-4">
                                        <p class="body-sm text-theme-text">
                                            {%- if item.original_price > item.final_price -%}
                                                <span class="line-through">
                                                    {{- item.original_price | money -}}
                                                </span>
                                                <span class="ms-1">
                                                    {{- item.final_price | money -}}
                                                </span>
                                            {%- else -%}
                                                {{- item.final_price | money -}}
                                            {%- endif -%}
                                        </p>
                                        <p class="body-lg">
                                            {%- if item.original_line_price > item.final_line_price
                                            -%}
                                                <span class="line-through">
                                                    {{- item.original_line_price | money -}}
                                                </span>
                                                <span class="ms-1">
                                                    {{- item.final_line_price | money -}}
                                                </span>
                                            {%- else -%}
                                                {{- item.final_line_price | money -}}
                                            {%- endif -%}
                                        </p>
                                        {%- render 'unit-price',
                                            target: item,
                                            class: 'mt-1 block body-sm text-theme-text'
                                        -%}
                                        {%- if item.line_level_discount_allocations.size > 0 -%}
                                            <ul
                                                class="mt-1"
                                                aria-label="{{ 'cart.discounts' | t }}"
                                            >
                                                {%- for allocation in item.line_level_discount_allocations -%}
                                                    <li class="text-theme-text">
                                                        {{ allocation.discount_application.title }}
                                                        (-{{ allocation.amount | money }})
                                                    </li>
                                                {%- endfor -%}
                                            </ul>
                                        {%- endif -%}
                                    </div>
                                </div>

                                <div class="flex items-center justify-end self-end py-1 pc:col-span-1">
                                    <a
                                        href="{{ item.url_to_remove }}"
                                        class="inline-flex items-center justify-center text-current opacity-50"
                                        aria-label="{{ 'accessibility.remove_item' | t: item: item.product.title | escape }}"
                                        data-item-key="{{ item.key | escape }}"
                                        data-section-id="{{ section.id }}"
                                        @click.prevent="changeLine($el.dataset.itemKey, 0, $el.dataset.sectionId)"
                                    >
                                        {% render 'icons', icon: 'icon-trash' %}
                                    </a>

                                    <span
                                        class="mx-5 h-5 border-s border-theme-border pc:mx-10 pc:h-10"
                                        aria-hidden="true"
                                    ></span>

                                    <div
                                        class="flex flex-col items-end"
                                        data-item-key="{{ item.key | escape }}"
                                        data-section-id="{{ section.id }}"
                                        @theme:product:quantity:changed="changeLine($el.dataset.itemKey, $event.detail.value, $el.dataset.sectionId)"
                                    >
                                        {%- capture cart_quantity_input_id -%}
                                            CartQuantity-{{ section.id }}-{{ forloop.index0 }}
                                        {%- endcapture -%}
                                        {%- render 'quantity-selector',
                                            variant: item.variant,
                                            surface: 'cart',
                                            value: item.quantity,
                                            label: item.product.title,
                                            input_id: cart_quantity_input_id,
                                            name: 'updates[]',
                                            product_form_id: cart_form_id
                                        -%}
                                        <p
                                            x-show="errors['{{ item.key | escape }}']"
                                            x-cloak
                                            role="alert"
                                            class="mt-1 max-w-full text-end body-md text-error-text"
                                            x-text="errors['{{ item.key | escape }}']"
                                        ></p>
                                    </div>
                                </div>
                            </li>
                        {%- endfor -%}
                    </ul>
                </div>

                <div>
                    {%- if cart.cart_level_discount_applications.size > 0 -%}
                        <div class="mb-4">
                            <p class="font-medium">{{ 'cart.discounts' | t }}</p>
                            <ul
                                class="mt-2 space-y-1"
                                aria-label="{{ 'cart.discounts' | t }}"
                            >
                                {%- for discount_application in cart.cart_level_discount_applications -%}
                                    <li class="flex items-baseline justify-between gap-4 text-theme-text">
                                        <span>{{ discount_application.title }}</span>
                                        <span
                                            >-
                                            {{-
                                                discount_application.total_allocated_amount
                                                | money
                                            -}}
                                        </span>
                                    </li>
                                {%- endfor -%}
                            </ul>
                        </div>
                    {%- endif -%}

                    <div class="flex items-baseline justify-between gap-4 body-lg">
                        <span>
                            {{- 'cart.estimate_total' | t -}}
                        </span>
                        <span>
                            {{- cart.total_price | money -}}
                        </span>
                    </div>
                    {%- render 'product-tax-note', class: 'mt-4 text-theme-text' -%}

                    <form
                        id="{{ cart_form_id }}"
                        action="{{ routes.cart_url }}"
                        method="post"
                        class="mt-5"
                    >
                        <noscript>
                            <button
                                type="submit"
                                name="update"
                                class="mb-3 btn w-full body-xl"
                            >
                                {{- 'cart.update' | t -}}
                            </button>
                        </noscript>
                        <button
                            type="submit"
                            name="checkout"
                            class="btn w-full body-xl"
                        >
                            {{ 'cart.checkout' | t }}
                        </button>
                    </form>

                    {%- if additional_checkout_buttons -%}
                        <div class="additional-checkout-buttons mt-4">
                            {{ content_for_additional_checkout_buttons }}
                        </div>
                    {%- endif -%}
                </div>
            </div>
        {%- endif -%}
    </div>
</div>

{% schema %}
{
    "name": "t:general.cart",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["cart"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.cart.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.cart.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.cart.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.cart.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
