<div
    data-section-id="{{ section.id }}"
    class="section color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="cartPage()"
    data-module-id="cart-page"
    :class="{ 'opacity-50 pointer-events-none': $store.cart.loading }"
>
    <h1 class="title-3xl">{{ 'cart.title' | t }}</h1>

    {%- assign cart_form_id = 'CartForm-' | append: section.id -%}
    {%- if cart.item_count == 0 -%}
        <p>{{ 'cart.empty' | t }}</p>
        <a class="copy-l underline underline-offset-4" href="{{ routes.root_url }}">
            {{ 'cart.shop_more' | t }}
        </a>
    {%- else -%}
        <ul>
            {%- for item in cart.items -%}
                <li>
                    {%- if item.image -%}
                        {% render 'image',
                            url: item.url,
                            image: item.image,
                            alt: item.image.alt,
                            width: 120,
                            height: 120,
                            crop: 'center'
                        %}
                    {%- else -%}
                        {% render 'image',
                            placeholder_key: 'product-1',
                            alt: '',
                            width: 120,
                            height: 120,
                            fit: 'contain'
                        %}
                    {%- endif -%}

                    <p>{{ item.vendor | default: ' ' }}</p>
                    <a href="{{ item.url }}" class="copy-l underline underline-offset-4">
                        {{ item.product.title }}
                    </a>

                    {%- unless item.product.has_only_default_variant -%}
                        <ul class="text-theme-text">
                            {%- for option in item.options_with_values -%}
                                <li>
                                    {{ option.name | escape }}:
                                    {{ option.value | escape }}
                                </li>
                            {%- endfor -%}
                        </ul>
                    {%- endunless -%}

                    {%- if item.selling_plan_allocation -%}
                        <p class="text-theme-text">
                            {{ 'cart.selling_plan_label' | t }}:
                            {{ item.selling_plan_allocation.selling_plan.name }}
                        </p>
                    {%- endif -%}

                    {%- if item.properties.size > 0 -%}
                        <ul class="text-theme-text">
                            {%- for property in item.properties -%}
                                {%- assign property_key = property.first -%}
                                {%- assign property_value = property.last -%}
                                {%- assign property_key_first = property_key | slice: 0 -%}
                                {%- if property_key == blank or property_key_first == '_' -%}
                                    {%- continue -%}
                                {%- endif -%}
                                {%- if property_value == blank -%}
                                    {%- continue -%}
                                {%- endif -%}
                                {%- assign property_value_text = property_value | append: '' -%}
                                <li>
                                    <span>{{ property_key | escape }}:</span>
                                    {%- if property_value_text contains '/uploads/' -%}
                                        <a
                                            href="{{ property_value_text | escape }}"
                                            class="underline underline-offset-4"
                                        >
                                            {{ property_value_text | split: '/' | last | escape }}
                                        </a>
                                    {%- else -%}
                                        <span>{{ property_value | escape }}</span>
                                    {%- endif -%}
                                </li>
                            {%- endfor -%}
                        </ul>
                    {%- endif -%}

                    <p class="copy-s text-theme-text">
                        {%- if item.original_price > item.final_price -%}
                            <span class="line-through">
                                {{- item.original_price | money -}}
                            </span>
                            <span>{{ item.final_price | money }}</span>
                        {%- else -%}
                            {{ item.final_price | money }}
                        {%- endif -%}
                    </p>
                    <p class="copy-l">
                        {%- if item.original_line_price > item.final_line_price -%}
                            <span class="line-through">
                                {{- item.original_line_price | money -}}
                            </span>
                            <span>{{ item.final_line_price | money }}</span>
                        {%- else -%}
                            {{ item.final_line_price | money }}
                        {%- endif -%}
                    </p>
                    {%- render 'unit-price', target: item, class: 'copy-s text-theme-text' -%}
                    {%- if item.line_level_discount_allocations.size > 0 -%}
                        <ul aria-label="{{ 'cart.discounts' | t }}">
                            {%- for allocation in item.line_level_discount_allocations -%}
                                <li class="text-theme-text">
                                    {{ allocation.discount_application.title }}
                                    (-{{ allocation.amount | money }})
                                </li>
                            {%- endfor -%}
                        </ul>
                    {%- endif -%}

                    <a
                        href="{{ item.url_to_remove }}"
                        class="text-current opacity-50"
                        aria-label="{{ 'accessibility.remove_item' | t: item: item.product.title | escape }}"
                        data-item-key="{{ item.key | escape }}"
                        data-section-id="{{ section.id }}"
                        @click.prevent="changeLine($el.dataset.itemKey, 0, $el.dataset.sectionId)"
                    >
                        {% render 'icons', icon: 'icon-trash' %}
                    </a>

                    <div
                        data-item-key="{{ item.key | escape }}"
                        data-section-id="{{ section.id }}"
                        @theme:product:quantity:changed="changeLine($el.dataset.itemKey, $event.detail.value, $el.dataset.sectionId)"
                    >
                        {%- assign cart_quantity_input_id = 'CartQuantity-'
                            | append: section.id
                            | append: '-'
                            | append: forloop.index0
                        -%}
                        {%- render 'quantity-selector',
                            variant: item.variant,
                            surface: 'cart',
                            value: item.quantity,
                            label: item.product.title,
                            input_id: cart_quantity_input_id,
                            name: 'updates[]',
                            product_form_id: cart_form_id
                        -%}
                        <p
                            data-line-key="{{ item.key | escape }}"
                            x-show="errors[$el.dataset.lineKey]"
                            x-cloak
                            role="alert"
                            class="copy-m text-error-text"
                            x-text="errors[$el.dataset.lineKey]"
                        ></p>
                    </div>
                </li>
            {%- endfor -%}
        </ul>

        <div>
            {%- if cart.cart_level_discount_applications.size > 0 -%}
                <div>
                    <p class="copy-m">
                        <strong>{{ 'cart.discounts' | t }}</strong>
                    </p>
                    <ul aria-label="{{ 'cart.discounts' | t }}">
                        {%- for discount_application in cart.cart_level_discount_applications -%}
                            <li class="text-theme-text">
                                <span>{{ discount_application.title }}</span>
                                <span
                                    >-{{ discount_application.total_allocated_amount | money -}}
                                </span>
                            </li>
                        {%- endfor -%}
                    </ul>
                </div>
            {%- endif -%}

            <div class="copy-l">
                <span>{{ 'cart.estimate_total' | t }}</span>
                <span>{{ cart.total_price | money }}</span>
            </div>
            {%- render 'product-tax-note', class: 'text-theme-text' -%}

            <form id="{{ cart_form_id }}" action="{{ routes.cart_url }}" method="post">
                <noscript>
                    <button type="submit" name="update" class="btn copy-l">
                        {{ 'cart.update' | t }}
                    </button>
                </noscript>
                <button type="submit" name="checkout" class="btn copy-l">
                    {{ 'cart.checkout' | t }}
                </button>
            </form>

            {%- if additional_checkout_buttons -%}
                <div class="additional-checkout-buttons">
                    {{ content_for_additional_checkout_buttons }}
                </div>
            {%- endif -%}
        </div>
    {%- endif -%}
</div>

{% schema %}
{
    "name": "t:general.cart",
    "tag": "section",
    "enabled_on": {
        "templates": ["cart"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.cart.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.cart.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.cart.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.cart.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
