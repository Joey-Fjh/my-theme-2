<div
    data-section-id="{{ section.id }}"
    class="main-page-contact-section full-width color-{{ section.settings.color_scheme }} surface-section"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    x-data="motionRevealSection()"
    data-module-id="motion-reveal-section"
    data-module-lazy
    data-motion-section
>
    <div class="layout container-page">
        <div class="mx-auto w-full max-w-2xl py-10">
            <div class="flex flex-col gap-6">
                {%- assign heading_fallback = 'sections.main-page-contact.defaults.heading' | t -%}
                <div>
                    <h1
                        class="text-center heading-xl"
                        data-motion-reveal
                        data-motion-critical
                    >
                        {{ section.settings.heading | default: heading_fallback }}
                    </h1>
                    <div
                        class="rte rte--compact mt-3 text-center"
                        data-motion-reveal
                        data-motion-critical
                    >
                        {%- assign contact_description_fallback = 'contact.description_html' | t -%}
                        {{ section.settings.description | default: contact_description_fallback }}
                    </div>
                </div>

                {%- form 'contact',
                    return_to: 'back',
                    data-shopify-captcha: 'true',
                    class: 'mt-6 flex flex-col gap-5 pc:mt-8 pc:gap-6'
                -%}
                    {%- assign success_message_fallback = 'sections.main-page-contact.defaults.success_message'
                        | t
                    -%}
                    {%- assign success_message = section.settings.success_message
                        | default: success_message_fallback
                    -%}
                    {%- if form.posted_successfully? -%}
                        <div
                            class="rounded p-4 text-center"
                            role="status"
                        >
                            {{ success_message }}
                        </div>
                    {%- endif -%}

                    {%- if form.errors -%}
                        <div
                            id="ContactFormErrors-{{ section.id }}"
                            class="rounded p-4 text-error-text"
                            role="alert"
                        >
                            {{ form.errors | default_errors }}
                        </div>
                    {%- endif -%}

                    {%- comment -%} First name & Last name {%- endcomment -%}
                    <div class="grid grid-cols-1 gap-4 pc:grid-cols-2 pc:gap-5">
                        <div class="flex flex-col gap-1.5">
                            <label
                                for="ContactFirstName-{{ section.id }}"
                            >
                                {{- 'contact.first_name' | t -}}
                            </label>
                            <input
                                type="text"
                                id="ContactFirstName-{{ section.id }}"
                                name="contact[first_name]"
                                placeholder="{{ 'contact.first_name_placeholder' | t }}"
                                autocomplete="given-name"
                                class="field"
                            >
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label
                                for="ContactLastName-{{ section.id }}"
                            >
                                {{- 'contact.last_name' | t -}}
                            </label>
                            <input
                                type="text"
                                id="ContactLastName-{{ section.id }}"
                                name="contact[last_name]"
                                placeholder="{{ 'contact.last_name_placeholder' | t }}"
                                autocomplete="family-name"
                                class="field"
                            >
                        </div>
                    </div>

                    {%- comment -%} Email & Phone {%- endcomment -%}
                    <div class="grid grid-cols-1 gap-4 pc:grid-cols-2 pc:gap-5">
                        <div class="flex flex-col gap-1.5">
                            <label
                                for="ContactEmail-{{ section.id }}"
                            >
                                {{- 'contact.email' | t -}}
                                <span aria-hidden="true">*</span>
                                <span class="sr-only">{{ 'accessibility.required' | t }}</span>
                            </label>
                            <input
                                type="email"
                                id="ContactEmail-{{ section.id }}"
                                name="contact[email]"
                                placeholder="{{ 'contact.email_placeholder' | t }}"
                                autocomplete="email"
                                required
                                aria-required="true"
                                class="field"
                                {% if form.errors contains 'email' %}
                                    aria-invalid="true"
                                    aria-describedby="ContactFormErrors-{{ section.id }}"
                                {% endif %}
                            >
                        </div>
                        <div class="hidden flex-col gap-1.5 pc:flex">
                            <label
                                for="ContactPhone-{{ section.id }}"
                            >
                                {{- 'contact.phone' | t -}}
                            </label>
                            <input
                                type="tel"
                                id="ContactPhone-{{ section.id }}"
                                name="contact[phone]"
                                placeholder="{{ 'contact.phone_placeholder' | t }}"
                                autocomplete="tel"
                                class="field"
                            >
                        </div>
                    </div>

                    {%- comment -%} Message {%- endcomment -%}
                    <div class="flex flex-col gap-1.5">
                        <label for="ContactMessage-{{ section.id }}">
                            {{- 'contact.message' | t -}}
                        </label>
                        <textarea
                            id="ContactMessage-{{ section.id }}"
                            name="contact[body]"
                            placeholder="{{ 'contact.message_placeholder' | t }}"
                            rows="4"
                            class="min-h-24 field resize-none pc:min-h-28"
                            {% if form.errors contains 'body' %}
                                aria-invalid="true"
                                aria-describedby="ContactFormErrors-{{ section.id }}"
                            {% endif %}
                        ></textarea>
                    </div>

                    {%- assign button_text_fallback = 'sections.main-page-contact.defaults.button_text'
                        | t
                    -%}
                    {%- comment -%} Submit {%- endcomment -%}
                    <button
                        type="submit"
                        class="btn-primary w-full body-xl"
                    >
                        {{ section.settings.button_text | default: button_text_fallback }}
                    </button>
                {%- endform -%}
            </div>
        </div>
    </div>
</div>

{% schema %}
{
    "name": "t:sections.main-page-contact.name",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["page"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.main-page-contact.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "inline_richtext",
            "id": "heading",
            "default": "t:sections.main-page-contact.defaults.heading",
            "label": "t:sections.main-page-contact.settings.heading"
        },
        {
            "type": "richtext",
            "id": "description",
            "default": "t:sections.main-page-contact.defaults.description",
            "label": "t:sections.main-page-contact.settings.description"
        },
        {
            "type": "text",
            "id": "button_text",
            "default": "t:sections.main-page-contact.defaults.button_text",
            "label": "t:sections.main-page-contact.settings.button_text"
        },
        {
            "type": "textarea",
            "id": "success_message",
            "default": "t:sections.main-page-contact.defaults.success_message",
            "label": "t:sections.main-page-contact.settings.success_message"
        },
        {
            "type": "header",
            "content": "t:sections.main-page-contact.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.main-page-contact.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.main-page-contact.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
