<div
    data-section-id="{{ section.id }}"
    class="section color-{{ section.settings.color_scheme }}"
    style="
        --section-padding-top: {{ section.settings.padding_top }}px;
        --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
>
    <h1 class="title-xl">{{ page.title }}</h1>
    {%- if page.content != blank -%}
        <div class="rte">{{ page.content }}</div>
    {%- endif -%}

    {%- form 'contact', return_to: 'back', data-shopify-captcha: 'true' -%}
        {%- if form.posted_successfully? -%}
            <div role="status">
                {{ 'sections.main-page-contact.defaults.success_message' | t }}
            </div>
        {%- endif -%}

        {%- if form.errors -%}
            <div id="ContactFormErrors-{{ section.id }}" role="alert">
                {{ form.errors | default_errors }}
            </div>
        {%- endif -%}

        <div>
            <label for="ContactFirstName-{{ section.id }}">{{ 'contact.first_name' | t }}</label>
            <input
                type="text"
                id="ContactFirstName-{{ section.id }}"
                name="contact[first_name]"
                placeholder="{{ 'contact.first_name_placeholder' | t }}"
                autocomplete="given-name"
                class="field"
            >
        </div>
        <div>
            <label for="ContactLastName-{{ section.id }}">{{ 'contact.last_name' | t }}</label>
            <input
                type="text"
                id="ContactLastName-{{ section.id }}"
                name="contact[last_name]"
                placeholder="{{ 'contact.last_name_placeholder' | t }}"
                autocomplete="family-name"
                class="field"
            >
        </div>
        <div>
            <label for="ContactEmail-{{ section.id }}">
                {{ 'contact.email' | t }}
                <span aria-hidden="true">*</span>
                <span class="sr-only">{{ 'accessibility.required' | t }}</span>
            </label>
            <input
                type="email"
                id="ContactEmail-{{ section.id }}"
                name="contact[email]"
                placeholder="{{ 'contact.email_placeholder' | t }}"
                autocomplete="email"
                required
                aria-required="true"
                class="field"
                {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="ContactFormErrors-{{ section.id }}"
                {% endif %}
            >
        </div>
        <div>
            <label for="ContactPhone-{{ section.id }}">{{ 'contact.phone' | t }}</label>
            <input
                type="tel"
                id="ContactPhone-{{ section.id }}"
                name="contact[phone]"
                placeholder="{{ 'contact.phone_placeholder' | t }}"
                autocomplete="tel"
                class="field"
            >
        </div>
        <div>
            <label for="ContactMessage-{{ section.id }}">{{ 'contact.message' | t }}</label>
            <textarea
                id="ContactMessage-{{ section.id }}"
                name="contact[body]"
                placeholder="{{ 'contact.message_placeholder' | t }}"
                rows="4"
                class="field-textarea"
                {% if form.errors contains 'body' %}
                    aria-invalid="true"
                    aria-describedby="ContactFormErrors-{{ section.id }}"
                {% endif %}
            ></textarea>
        </div>
        <button type="submit" class="btn copy-l">
            {{ 'sections.main-page-contact.defaults.button_text' | t }}
        </button>
    {%- endform -%}
</div>

{% schema %}
{
    "name": "t:sections.main-page-contact.name",
    "tag": "section",
    "enabled_on": {
        "templates": ["page"]
    },
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.main-page-contact.settings.color_scheme",
            "default": "scheme-2"
        },
        {
            "type": "header",
            "content": "t:sections.main-page-contact.content.padding"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.main-page-contact.settings.padding_top",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.main-page-contact.settings.padding_bottom",
            "default": 32
        }
    ]
}
{% endschema %}
