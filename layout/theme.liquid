<!doctype html>
{%- liquid
    assign rtl_locales = 'ar,he,fa,ur' | split: ','
    assign lang_code = request.locale.iso_code | split: '-' | first
    if rtl_locales contains lang_code
        assign dir = 'rtl'
    else
        assign dir = 'ltr'
    endif
    assign page_canvas_color_scheme = settings.page_canvas_color_scheme | default: 'scheme-2'
-%}
<html lang="{{ request.locale.iso_code }}" dir="{{ dir }}">
    <head>
        {% # Social, title, etc. %}
        {% render 'meta-tags' %}

        {% # Inlined CSS Variables %}
        {% render 'css-variables' %}

        {% # Load and preload the CSS %}
        {{ 'tailwind.output.css' | asset_url | stylesheet_tag: preload: true }}

        {% comment %} --- 1. Module graph ---
            Every identifier below is a bare specifier. `data-module-id` in Liquid markup
            names the component entry the core imports on demand; the core itself holds no
            component manifest.
        {% endcomment %}
        <script type="importmap">
            {
                "imports": {
                    "base": "{{ 'base.js' | asset_url }}",
                    "events": "{{ 'events.js' | asset_url }}",
                    "utils": "{{ 'utils.js' | asset_url }}",
                    "https": "{{ 'https.js' | asset_url }}",
                    "alpine-adapter": "{{ 'alpine.adapter.js' | asset_url }}",
                    "cart-contract": "{{ 'cart.contract.js' | asset_url }}",
                    "components/filters": "{{ 'alpine.components.filters.js' | asset_url }}",
                    "components/header": "{{ 'alpine.components.header.js' | asset_url }}",
                    "components/overlays": "{{ 'alpine.components.overlays.js' | asset_url }}",
                    "components/pagination": "{{ 'alpine.components.pagination.js' | asset_url }}",
                    "components/product": "{{ 'alpine.components.product.js' | asset_url }}",
                    "components/product-cards": "{{ 'alpine.components.product-cards.js' | asset_url }}",
                    "components/product-media": "{{ 'alpine.components.product-media.js' | asset_url }}",
                    "components/search": "{{ 'alpine.components.search.js' | asset_url }}",
                    "components/ui": "{{ 'alpine.components.ui.js' | asset_url }}",
                    "accordion": "{{ 'accordion.js' | asset_url }}",
                    "buy-buttons": "{{ 'buy-buttons.js' | asset_url }}",
                    "cart-page": "{{ 'cart-page.js' | asset_url }}",
                    "collection-filter-field": "{{ 'collection-filter-field.js' | asset_url }}",
                    "collection-filters": "{{ 'collection-filters.js' | asset_url }}",
                    "collection-navigation-catalog": "{{ 'collection-navigation-catalog.js' | asset_url }}",
                    "drag-scroll": "{{ 'drag-scroll.js' | asset_url }}",
                    "dropdown": "{{ 'dropdown.js' | asset_url }}",
                    "localization-switcher": "{{ 'localization-switcher.js' | asset_url }}",
                    "motion-reveal-section": "{{ 'motion-reveal-section.js' | asset_url }}",
                    "product-gallery": "{{ 'product-gallery.js' | asset_url }}",
                    "product-layout": "{{ 'product-layout.js' | asset_url }}",
                    "progressive-list": "{{ 'progressive-list.js' | asset_url }}",
                    "quantity-selector": "{{ 'quantity-selector.js' | asset_url }}",
                    "section-pagination": "{{ 'section-pagination.js' | asset_url }}",
                    "sort-by-dropdown": "{{ 'sort-by-dropdown.js' | asset_url }}",
                    "sticky-header": "{{ 'sticky-header.js' | asset_url }}",
                    "sticky-viewport-panel": "{{ 'sticky-viewport-panel.js' | asset_url }}",
                    "tab-control": "{{ 'tab-control.js' | asset_url }}",
                    "toast-container": "{{ 'toast-container.js' | asset_url }}",
                    "variant-picker": "{{ 'variant-picker.js' | asset_url }}"
                }
            }
        </script>

        {% comment %}
            --- 2. Core entry ---
            Must execute before Alpine: Alpine v3 queues `start()` in a microtask as soon as
            its own script runs, so the core has to claim component roots and queue store
            registration first.
        {% endcomment %}
        <script type="module" src="{{ 'base.js' | asset_url }}"></script>

        {% comment %} --- 3. Alpine.js framework initialization --- {% endcomment %}
        <script src="{{ 'vendor-alpine-intersect.min.js' | asset_url }}" defer></script>
        <script src="{{ 'vendor-alpine.min.js' | asset_url }}" defer></script>

        {{ content_for_header }}
    </head>

    <body
        class="color-{{ page_canvas_color_scheme }}"
        data-initial-cart="{{ cart | json | escape }}"
        data-cart-type="{{ settings.cart_type }}"
        {% if settings.motion_enabled == false %}
            data-motion-enabled="false"
        {% endif %}
        {% if settings.content_reveal_style != blank and settings.content_reveal_style != 'none' %}
            data-content-reveal-style="{{ settings.content_reveal_style }}"
        {% endif %}
        {% if settings.media_reveal_style != blank and settings.media_reveal_style != 'none' %}
            data-media-reveal-style="{{ settings.media_reveal_style }}"
        {% endif %}
        data-reveal-behavior="{{ settings.reveal_behavior | default: 'once' }}"
    >
        <a class="skip-link" href="#MainContent">
            {{- 'accessibility.skip_to_content' | t -}}
        </a>

        {% sections 'header-group' %}

        <main id="MainContent" class="relative shadow-none outline-none" role="main" tabindex="-1">
            {{ content_for_layout }}
        </main>

        {% sections 'footer-group' %}

        {% render 'ui-toast' %}
    </body>
</html>
